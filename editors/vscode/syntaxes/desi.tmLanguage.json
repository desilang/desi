{
    "name": "Desi",
    "scopeName": "source.desi",
    "fileTypes": [
        "desi"
    ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#types"
        },
        {
            "include": "#decorators"
        }
    ],
    "repository": {
        "comments": {
            "match": "#.*$",
            "name": "comment.line.number-sign.desi"
        },
        "strings": {
            "patterns": [
                {
                    "begin": "\"\"\"",
                    "end": "\"\"\"",
                    "name": "string.quoted.triple.desi"
                },
                {
                    "begin": "f\"",
                    "end": "\"",
                    "name": "string.interpolated.desi",
                    "patterns": [
                        {
                            "match": "\\{[^}]+\\}",
                            "name": "meta.embedded.expression.desi"
                        }
                    ]
                },
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string.quoted.double.desi"
                },
                {
                    "begin": "'",
                    "end": "'",
                    "name": "string.quoted.single.desi"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "match": "\\b(def|class|struct|enum|trait|impl|if|elif|else|for|while|match|case|return|break|continue|pass|let|mut|pub|async|await|spawn|using|defer|unsafe|import|from|as|in|is|not|and|or|type)\\b",
                    "name": "keyword.control.desi"
                },
                {
                    "match": "\\b(true|false|none|self|cls)\\b",
                    "name": "constant.language.desi"
                },
                {
                    "match": "\\b(Some|Nothing|Ok|Err|Option|Result)\\b",
                    "name": "support.type.desi"
                }
            ]
        },
        "operators": {
            "match": "(\\+|-|\\*|/|%|==|!=|<=|>=|<|>|=|:=|->|\\|>|\\?|&|\\|)",
            "name": "keyword.operator.desi"
        },
        "numbers": {
            "match": "\\b(0x[0-9a-fA-F]+|0b[01]+|0o[0-7]+|[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?)\\b",
            "name": "constant.numeric.desi"
        },
        "functions": {
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
            "captures": {
                "1": {
                    "name": "entity.name.function.desi"
                }
            }
        },
        "types": {
            "match": "\\b(int|float|bool|str|none|list|dict|set|tuple|Any|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|usize|isize|char|ptr|cptr|Rc|Arc|future)\\b",
            "name": "support.type.primitive.desi"
        },
        "decorators": {
            "match": "@[a-zA-Z_][a-zA-Z0-9_]*",
            "name": "entity.name.function.decorator.desi"
        }
    }
}