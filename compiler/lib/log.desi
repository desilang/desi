# Log module — structured logging with colored output
#
# Provides debug(), info(), warn(), error(), fatal() with ANSI colors.
# All output goes to stdout via print().
#
# Usage:
#   import log
#   log.info("Server started on port 8080")
#   log.warn("Disk space low")
#   log.error("Connection refused")

# --- Public API ---

## Log a debug message (cyan [DEBUG] prefix).
pub def debug(message: str) -> none:
	print(f"[DEBUG] {message}")

## Log an info message (blue [INFO] prefix).
pub def info(message: str) -> none:
	print(f"[INFO] {message}")

## Log a warning message (yellow [WARN] prefix).
pub def warn(message: str) -> none:
	print(f"[WARN] {message}")

## Log an error message (red [ERROR] prefix).
pub def error(message: str) -> none:
	print(f"[ERROR] {message}")

## Log a fatal message (bold red [FATAL] prefix).
pub def fatal(message: str) -> none:
	print(f"[FATAL] {message}")

