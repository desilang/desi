# Log module - structured logging with colored output
# Provides log.info(), log.debug(), log.warn(), log.error()

# ANSI color codes for log levels
let RESET = "\033[0m"
let BLUE = "\033[34m"
let CYAN = "\033[36m"
let YELLOW = "\033[33m"
let RED = "\033[31m"

# Log info message (blue prefix)
pub def info(message: str) -> none:
    print(f"{BLUE}[INFO]{RESET} {message}")

# Log debug message (cyan prefix)  
pub def debug(message: str) -> none:
    print(f"{CYAN}[DEBUG]{RESET} {message}")

# Log warning message (yellow prefix)
pub def warn(message: str) -> none:
    print(f"{YELLOW}[WARN]{RESET} {message}")

# Log error message (red prefix)
pub def error(message: str) -> none:
    print(f"{RED}[ERROR]{RESET} {message}")

