# Desi ORM Macro Definition
#
# This file defines the @model decorator for database-backed classes.
# The compiler reads this file at startup and registers the macro protocol.
#
# To create a custom macro like @snodel:
#   1. Copy this file
#   2. Change class name, property_name, method names
#   3. Point runtime dict to your C functions (or reuse these)
#   4. Add the path to desi.mod [macros].paths
#
# The compiler Go code is 100% generic — it never mentions "model",
# "objects", "Q", or "F". All domain-specific names come from THIS file.

@macro(target="class")
class model:
    """ORM model — generates database-backed class with QuerySet manager.
    
    Usage:
        @model("tablename")
        class User:
            name: CharField(100)
            email: CharField(200, unique=true)
    
    This injects a .objects property on the class with QuerySet methods:
        User.objects.filter(name="Ali")
        User.objects.create(name="Ali", email="ali@test.com")
        User.objects.get(id=1)
    """
    
    # Property injected on decorated classes
    # The compiler sees User.objects and resolves it because this macro
    # declares "objects" as an injected property.
    property_name = "objects"
    
    # Chainable methods — return the manager for further chaining
    # e.g., User.objects.filter(name="Ali").order_by("name").limit(10)
    chainable = ["filter", "exclude", "order_by", "all", "values", 
                 "distinct", "limit", "offset", "select_related", "annotate"]
    
    # Terminal methods — execute the query and return results
    # e.g., User.objects.filter(name="Ali").count()
    terminal = ["get", "create", "update", "delete", "count", "exists",
                "first", "last", "aggregate", "bulk_create", "bulk_update"]
    
    # Builtin functions this macro introduces (name -> return type)
    # The compiler resolves Q(...) and F(...) because they're registered here.
    builtins = {"Q": "str", "F": "str", "Count": "str", 
                "Sum": "str", "Avg": "str", "Min": "str", "Max": "str"}
    
    # Operator overloads (expression pattern -> C runtime function)
    # Pattern format: "BUILTIN op BUILTIN" for binary, "op BUILTIN" for unary
    operators = {
        "Q|Q": "__q_or",
        "Q&Q": "__q_and",
        "~Q":  "__q_not",
        "F+F": "__f_add",
        "F-F": "__f_sub",
        "F*F": "__f_mul",
        "F/F": "__f_div"
    }
    
    # C runtime function mapping
    # Maps method names to C function names from the db_crud.c runtime.
    # The lowerer reads this map to emit hir.Call — it never hardcodes
    # function names like "__qs_filter".
    runtime = {
        "reset":      "__qs_reset",
        "filter":     "__qs_filter",
        "exclude":    "__qs_exclude",
        "order_by":   "__qs_order_by",
        "fetch":      "__qs_fetch",
        "create":     "__qs_do_insert",
        "update":     "__qs_update",
        "delete":     "__qs_delete",
        "count":      "__qs_count",
        "exists":     "__qs_exists",
        "limit":      "__qs_limit",
        "offset":     "__qs_offset",
        "set_field":  "__qs_set_field",
        "filter_q":   "__qs_filter_q",
        "row_count":  "__qs_row_count",
        "distinct":   "__qs_distinct"
    }
    
    # Validation rules — compiler enforces these on @model classes
    require_fields = true
    auto_pk = true
    forbidden_field_names = ["id"]
