# sys module - standard streams
# These are external globals initialized by __desi_runtime_init()

# FileStream is an opaque pointer to DesiStream in the C runtime
# sys.stdout and sys.stderr are the standard output/error streams

# Compiler magic: these map to @__desi_stdout and @__desi_stderr globals
pub extern stdout: ptr  # DesiStream* for stdout
pub extern stderr: ptr  # DesiStream* for stderr
