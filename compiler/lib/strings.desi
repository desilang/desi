# Strings module — string utility functions
#
# Provides case conversion, searching, trimming, and character checks.
# All functions take str arguments and return str or bool.
#
# Usage:
#   import strings
#   let upper = strings.upper("hello")        # "HELLO"
#   let trimmed = strings.trim("  hi  ")      # "hi"
#   let found = strings.starts_with("abc", "ab")  # true

# --- C runtime bindings (private) ---

@extern("C")
def __strings_upper(s: str) -> str

@extern("C")
def __strings_lower(s: str) -> str

@extern("C")
def __strings_capitalize(s: str) -> str

@extern("C")
def __strings_title(s: str) -> str

@extern("C")
def __strings_starts_with(s: str, prefix: str) -> bool

@extern("C")
def __strings_ends_with(s: str, suffix: str) -> bool

@extern("C")
def __strings_index_of(s: str, sub: str) -> int

@extern("C")
def __strings_contains(s: str, sub: str) -> bool

@extern("C")
def __strings_count(s: str, sub: str) -> int

@extern("C")
def __strings_trim(s: str) -> str

@extern("C")
def __strings_trim_left(s: str) -> str

@extern("C")
def __strings_trim_right(s: str) -> str

@extern("C")
def __strings_replace(s: str, old: str, new: str) -> str

@extern("C")
def __strings_repeat(s: str, n: int) -> str

@extern("C")
def __strings_reverse(s: str) -> str

@extern("C")
def __strings_is_empty(s: str) -> bool

@extern("C")
def __strings_is_digit(s: str) -> bool

@extern("C")
def __strings_is_alpha(s: str) -> bool

@extern("C")
def __strings_is_alnum(s: str) -> bool

@extern("C")
def __strings_is_space(s: str) -> bool

@extern("C")
def __strings_is_upper(s: str) -> bool

@extern("C")
def __strings_is_lower(s: str) -> bool

@extern("C")
def __strings_swapcase(s: str) -> str

@extern("C")
def __strings_last_index_of(s: str, sub: str) -> int

@extern("C")
def __strings_removeprefix(s: str, prefix: str) -> str

@extern("C")
def __strings_removesuffix(s: str, suffix: str) -> str

@extern("C")
def __strings_pad_left(s: str, width: int, fill: str) -> str

@extern("C")
def __strings_pad_right(s: str, width: int, fill: str) -> str

@extern("C")
def __strings_center(s: str, width: int, fill: str) -> str

@extern("C")
def __strings_zfill(s: str, width: int) -> str

@extern("C")
def __strings_char_at(s: str, idx: int) -> str

@extern("C")
def __strings_is_ascii(s: str) -> bool

@extern("C")
def __strings_is_printable(s: str) -> bool

@extern("C")
def __strings_truncate(s: str, max_len: int, suffix: str) -> str

@extern("C")
def __strings_slugify(s: str) -> str

@extern("C")
def __strings_split(s: str, sep: str) -> list[str]

@extern("C")
def __strings_join(sep: str, parts: list[str]) -> str

@extern("C")
def __strings_splitlines(s: str) -> list[str]


## Convert all characters to uppercase.
pub def upper(s: str) -> str:
	unsafe:
		return __strings_upper(s)

## Convert all characters to lowercase.
pub def lower(s: str) -> str:
	unsafe:
		return __strings_lower(s)

## Capitalize the first letter, lowercase the rest.
pub def capitalize(s: str) -> str:
	unsafe:
		return __strings_capitalize(s)

## Title case: capitalize the first letter of each word.
pub def title(s: str) -> str:
	unsafe:
		return __strings_title(s)

# --- Public API: Search ---

## Check if s starts with the given prefix.
pub def starts_with(s: str, prefix: str) -> bool:
	unsafe:
		return __strings_starts_with(s, prefix)

## Check if s ends with the given suffix.
pub def ends_with(s: str, suffix: str) -> bool:
	unsafe:
		return __strings_ends_with(s, suffix)

## Return the index of the first occurrence of sub in s, or -1.
pub def index_of(s: str, sub: str) -> int:
	unsafe:
		return __strings_index_of(s, sub)

## Check if s contains the substring sub.
pub def contains(s: str, sub: str) -> bool:
	unsafe:
		return __strings_contains(s, sub)

## Count non-overlapping occurrences of sub in s.
pub def count(s: str, sub: str) -> int:
	unsafe:
		return __strings_count(s, sub)

# --- Public API: Transform ---

## Remove whitespace from both ends.
pub def trim(s: str) -> str:
	unsafe:
		return __strings_trim(s)

## Remove whitespace from the left.
pub def trim_left(s: str) -> str:
	unsafe:
		return __strings_trim_left(s)

## Remove whitespace from the right.
pub def trim_right(s: str) -> str:
	unsafe:
		return __strings_trim_right(s)

## Replace all occurrences of old with new in s.
pub def replace(s: str, old: str, new: str) -> str:
	unsafe:
		return __strings_replace(s, old, new)

## Repeat s n times.
pub def repeat(s: str, n: int) -> str:
	unsafe:
		return __strings_repeat(s, n)

## Reverse a string.
pub def reverse(s: str) -> str:
	unsafe:
		return __strings_reverse(s)

# --- Public API: Character Checks ---

## Check if s is empty ("").
pub def is_empty(s: str) -> bool:
	unsafe:
		return __strings_is_empty(s)

## Check if all characters are digits (0-9).
pub def is_digit(s: str) -> bool:
	unsafe:
		return __strings_is_digit(s)

## Check if all characters are alphabetic (a-z, A-Z).
pub def is_alpha(s: str) -> bool:
	unsafe:
		return __strings_is_alpha(s)

## Check if all characters are alphanumeric.
pub def is_alnum(s: str) -> bool:
	unsafe:
		return __strings_is_alnum(s)

## Check if all characters are whitespace.
pub def is_space(s: str) -> bool:
	unsafe:
		return __strings_is_space(s)

## Check if all characters are uppercase.
pub def is_upper(s: str) -> bool:
	unsafe:
		return __strings_is_upper(s)

## Check if all characters are lowercase.
pub def is_lower(s: str) -> bool:
	unsafe:
		return __strings_is_lower(s)

## Swap case: uppercase ↔ lowercase.
pub def swapcase(s: str) -> str:
	unsafe:
		return __strings_swapcase(s)

# --- Public API: Search (additional) ---

## Return the index of the last occurrence of sub in s, or -1.
pub def last_index_of(s: str, sub: str) -> int:
	unsafe:
		return __strings_last_index_of(s, sub)

# --- Public API: Transform (additional) ---

## Remove prefix if present.
pub def removeprefix(s: str, prefix: str) -> str:
	unsafe:
		return __strings_removeprefix(s, prefix)

## Remove suffix if present.
pub def removesuffix(s: str, suffix: str) -> str:
	unsafe:
		return __strings_removesuffix(s, suffix)

## Left-pad to width with fill character (default space).
pub def pad_left(s: str, width: int, fill: str) -> str:
	unsafe:
		return __strings_pad_left(s, width, fill)

## Right-pad to width with fill character (default space).
pub def pad_right(s: str, width: int, fill: str) -> str:
	unsafe:
		return __strings_pad_right(s, width, fill)

## Center in field of given width with fill character (default space).
pub def center(s: str, width: int, fill: str) -> str:
	unsafe:
		return __strings_center(s, width, fill)

## Zero-fill: pad with zeros on the left, preserving sign.
pub def zfill(s: str, width: int) -> str:
	unsafe:
		return __strings_zfill(s, width)

## Get character at index as string (supports negative indices).
pub def char_at(s: str, idx: int) -> str:
	unsafe:
		return __strings_char_at(s, idx)

# --- Public API: Character Checks (additional) ---

## Check if all characters are ASCII (0-127).
pub def is_ascii(s: str) -> bool:
	unsafe:
		return __strings_is_ascii(s)

## Check if all characters are printable.
pub def is_printable(s: str) -> bool:
	unsafe:
		return __strings_is_printable(s)

# --- Public API: Desi Extras ---

## Truncate to max_len with suffix (e.g. "Hello...").
pub def truncate(s: str, max_len: int, suffix: str) -> str:
	unsafe:
		return __strings_truncate(s, max_len, suffix)

## URL-friendly slug: "Hello World!" → "hello-world".
pub def slugify(s: str) -> str:
	unsafe:
		return __strings_slugify(s)

# --- Public API: Split / Join ---

## Split string by separator, returns list of parts.
pub def split(s: str, sep: str) -> list[str]:
	unsafe:
		return __strings_split(s, sep)

## Join list of strings with separator.
pub def join(sep: str, parts: list[str]) -> str:
	unsafe:
		return __strings_join(sep, parts)

## Split string by newlines.
pub def splitlines(s: str) -> list[str]:
	unsafe:
		return __strings_splitlines(s)

# --- C runtime bindings: Case Convention Converters ---

@extern("C")
def __strings_camel_case(s: str) -> str

@extern("C")
def __strings_pascal_case(s: str) -> str

@extern("C")
def __strings_snake_case(s: str) -> str

@extern("C")
def __strings_kebab_case(s: str) -> str

@extern("C")
def __strings_screaming_snake(s: str) -> str

@extern("C")
def __strings_word_wrap(s: str, width: int) -> str

@extern("C")
def __strings_is_numeric(s: str) -> bool

@extern("C")
def __strings_dedent(s: str) -> str

@extern("C")
def __strings_abbreviate(s: str, max_len: int) -> str

# --- Public API: Case Convention Converters ---
# Every programmer rewrites these. Now built-in.

## Convert to camelCase: "hello_world" → "helloWorld".
pub def camel_case(s: str) -> str:
	unsafe:
		return __strings_camel_case(s)

## Convert to PascalCase: "hello_world" → "HelloWorld".
pub def pascal_case(s: str) -> str:
	unsafe:
		return __strings_pascal_case(s)

## Convert to snake_case: "helloWorld" → "hello_world".
pub def snake_case(s: str) -> str:
	unsafe:
		return __strings_snake_case(s)

## Convert to kebab-case: "helloWorld" → "hello-world".
pub def kebab_case(s: str) -> str:
	unsafe:
		return __strings_kebab_case(s)

## Convert to SCREAMING_SNAKE_CASE: "helloWorld" → "HELLO_WORLD".
pub def screaming_snake(s: str) -> str:
	unsafe:
		return __strings_screaming_snake(s)

# --- Public API: Text Utilities ---

## Word wrap text at word boundaries to given width.
pub def word_wrap(s: str, width: int) -> str:
	unsafe:
		return __strings_word_wrap(s, width)

## Check if string represents a number (int or float).
pub def is_numeric(s: str) -> bool:
	unsafe:
		return __strings_is_numeric(s)

## Remove common leading whitespace from multiline text.
## Like Python's textwrap.dedent().
pub def dedent(s: str) -> str:
	unsafe:
		return __strings_dedent(s)

## Abbreviate at word boundary: "Hello World" → "Hello..." (max n chars).
pub def abbreviate(s: str, max_len: int) -> str:
	unsafe:
		return __strings_abbreviate(s, max_len)
