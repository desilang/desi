# env module — environment file loading
#
# Load .env files into process environment. Inspired by Node's dotenv.
# No other language ships this built-in — Desi exclusive.
#
# Usage:
#   import env
#   env.load_default()
#   let port = env.get("PORT", "8080")

# --- C runtime bindings ---

@extern("C")
def __env_load(path: str) -> bool

@extern("C")
def __env_load_default() -> bool

@extern("C")
def __env_get(key: str, default_val: str) -> str

@extern("C")
def __env_require(key: str) -> str

@extern("C")
def __env_is_set(key: str) -> bool

# --- Public API ---

## Load a .env file into the process environment.
pub def load(path: str) -> bool:
	unsafe:
		return __env_load(path)

## Load .env from the current working directory.
pub def load_default() -> bool:
	unsafe:
		return __env_load_default()

## Get environment variable with a default fallback.
pub def get(key: str, default_val: str) -> str:
	unsafe:
		return __env_get(key, default_val)

## Get environment variable, exit if not set.
pub def require(key: str) -> str:
	unsafe:
		return __env_require(key)

## Check if environment variable exists.
pub def is_set(key: str) -> bool:
	unsafe:
		return __env_is_set(key)

