@extern("C")
def __ws_broadcast(msg: str) -> none

@extern("C")
def __ws_close(conn: int) -> none

@extern("C")
def __ws_join(conn: int, room: str) -> none

@extern("C")
def __ws_leave(conn: int, room: str) -> none

@extern("C")
def __ws_to_room(room: str, msg: str) -> none

@extern("C")
def __ws_set_path(path: str) -> none

@extern("C")
def __ws_set_on_message(fn: Any) -> none

@extern("C")
def __ws_set_on_open(fn: Any) -> none

@extern("C")
def __ws_set_on_close(fn: Any) -> none

@extern("C")
def __ws_set_max_message_size(size: int) -> none

@extern("C")
def __ws_set_ping_interval(secs: int) -> none

@extern("C")
def __ws_conn_count() -> int

# ============================================================
# WebSocket — Public API
# ============================================================

# Register a WebSocket endpoint with message handler
# Handler: def on_message(conn: int, msg: str) -> none
# Note: lowerer intercepts http.ws() and emits __ws_set_path + __ws_set_on_message
pub def ws(srv: Server, path: str, handler: Any) -> none:
	return

# Set handler called when a WebSocket client connects
# Handler: def on_open(conn: int) -> none
# Note: lowerer intercepts and emits __ws_set_on_open
pub def ws_on_open(srv: Server, handler: Any) -> none:
	return

# Set handler called when a WebSocket client disconnects
# Handler: def on_close(conn: int) -> none
# Note: lowerer intercepts and emits __ws_set_on_close
pub def ws_on_close(srv: Server, handler: Any) -> none:
	return

# Send a text message to a single WebSocket connection
pub def ws_send(conn: int, msg: str) -> none:
	__ws_send(conn, msg)

# Broadcast a text message to all connected WebSocket clients
pub def ws_broadcast(srv: Server, msg: str) -> none:
	__ws_broadcast(msg)

# Broadcast (no-srv form, for use inside callbacks)
pub def ws_broadcast(msg: str) -> none:
	__ws_broadcast(msg)

# Close a WebSocket connection
pub def ws_close(conn: int) -> none:
	__ws_close(conn)

# Join a room (for targeted broadcasting)
pub def ws_join(conn: int, room: str) -> none:
	__ws_join(conn, room)

# Leave a room
pub def ws_leave(conn: int, room: str) -> none:
	__ws_leave(conn, room)

# Broadcast a message to all clients in a specific room
pub def ws_to_room(srv: Server, room: str, msg: str) -> none:
	__ws_to_room(room, msg)

# Broadcast to room (no-srv form, for use inside callbacks)
pub def ws_to_room(room: str, msg: str) -> none:
	__ws_to_room(room, msg)

# Set maximum incoming WebSocket message size in bytes (default: 16MB)
# Messages exceeding this limit will be rejected and the connection closed
# Note: lowerer intercepts and emits __ws_set_max_message_size
pub def ws_max_message_size(srv: Server, max_bytes: int) -> none:
	return

# Set ping keepalive interval in seconds (default: disabled)
# Server sends PING frames at this interval to keep connections alive
# Set to 0 to disable
# Note: lowerer intercepts and emits __ws_set_ping_interval
pub def ws_ping_interval(srv: Server, secs: int) -> none:
	return

# Send a binary message to a single WebSocket connection
# Note: lowerer intercepts and emits __ws_send_binary(conn, data, len)
pub def ws_send_binary(conn: int, data: str) -> none:
	return

# Get the number of currently active WebSocket connections
pub def ws_conn_count() -> int:
	return __ws_conn_count()
