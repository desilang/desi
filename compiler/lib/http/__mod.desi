# HTTP module - HTTP client for Desi
# Self-contained: POSIX sockets + platform TLS (no libcurl)
# Supports HTTP/1.1, HTTPS, IPv4+IPv6, redirects, chunked encoding

# ============================================================
# C Runtime Bindings
# ============================================================

@extern("C")
def __http_get(url: str) -> Any

@extern("C")
def __http_post(url: str, body: str) -> Any

@extern("C")
def __http_put(url: str, body: str) -> Any

@extern("C")
def __http_patch(url: str, body: str) -> Any

@extern("C")
def __http_delete(url: str) -> Any

@extern("C")
def __http_head(url: str) -> Any

@extern("C")
def __http_options(url: str) -> Any

@extern("C")
def __http_request(method: str, url: str, body: str, headers: str) -> Any

@extern("C")
def __http_request_timeout(method: str, url: str, body: str, headers: str, timeout_secs: int) -> Any

# JSON parser (from json.c runtime, for auto-parsing response bodies)
@extern("C")
def __json_parse(text: str) -> Any

@extern("C")
def __http_response_status(resp: Any) -> int

@extern("C")
def __http_response_body(resp: Any) -> str

@extern("C")
def __http_response_headers(resp: Any) -> str

@extern("C")
def __http_url_encode(s: str) -> str

@extern("C")
def __http_url_decode(s: str) -> str

# Dict-to-JSON bridge (from json.c runtime, used by *_json convenience methods)
# Converts a Desi dict_t directly to a JSON string with quoted keys and typed values
@extern("C")
def __dict_to_json_str(data: Any) -> str

# Dict-to-query-string bridge (from http.c runtime)
# Converts a Desi dict_t to URL-encoded key=val&key=val query string
@extern("C")
def __dict_to_query_str(data: Any) -> str

# Base64 encode (for Basic auth headers)
@extern("C")
def __base64_encode(s: str) -> str

# ============================================================
# Response Type
# ============================================================

struct Response:
	pub status: int
	pub body: str
	pub headers: str

# ============================================================
# Public API
# ============================================================

# Perform a GET request
pub def get(url: str) -> Response:
	unsafe:
		let raw = __http_get(url)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a POST request with a string body
pub def post(url: str, body: str) -> Response:
	unsafe:
		let raw = __http_post(url, body)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a POST request with auto-JSON serialization
# Accepts dict, list, int, float, bool, str, or any serializable value
pub def post_json(url: str, data: Any) -> Response:
	unsafe:
		let body = __dict_to_json_str(data)
		let raw = __http_post(url, body)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a PUT request with a string body
pub def put(url: str, body: str) -> Response:
	unsafe:
		let raw = __http_put(url, body)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a PUT request with auto-JSON serialization
pub def put_json(url: str, data: Any) -> Response:
	unsafe:
		let body = __dict_to_json_str(data)
		let raw = __http_put(url, body)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a PATCH request with a string body
pub def patch(url: str, body: str) -> Response:
	unsafe:
		let raw = __http_patch(url, body)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a PATCH request with auto-JSON serialization
pub def patch_json(url: str, data: Any) -> Response:
	unsafe:
		let body = __dict_to_json_str(data)
		let raw = __http_patch(url, body)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a DELETE request
pub def delete(url: str) -> Response:
	unsafe:
		let raw = __http_delete(url)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a HEAD request (body will be empty)
pub def head(url: str) -> Response:
	unsafe:
		let raw = __http_head(url)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform an OPTIONS request
pub def options(url: str) -> Response:
	unsafe:
		let raw = __http_options(url)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a custom HTTP request with method, URL, body, and headers
# Headers should be in "Key: Value\r\n" format
pub def request(method: str, url: str, body: str, headers: str) -> Response:
	unsafe:
		let raw = __http_request(method, url, body, headers)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a custom HTTP request with a timeout (in seconds)
# All other methods use a default 30-second timeout
pub def request_timeout(method: str, url: str, body: str, headers: str, timeout: int) -> Response:
	unsafe:
		let raw = __http_request_timeout(method, url, body, headers, timeout)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a custom HTTP request with auto-JSON body and optional timeout
pub def request_json(method: str, url: str, data: Any, timeout: int) -> Response:
	unsafe:
		let body = __dict_to_json_str(data)
		let raw = __http_request_timeout(method, url, body, "Content-Type: application/json\r\n", timeout)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# URL-encode a string (RFC 3986)
pub def url_encode(s: str) -> str:
	unsafe:
		return __http_url_encode(s)

# URL-decode a string
pub def url_decode(s: str) -> str:
	unsafe:
		return __http_url_decode(s)

# Parse a JSON response body into a JSON node
# Returns a JSON node that can be accessed with json module functions
pub def parse_json(text: str) -> Any:
	unsafe:
		return __json_parse(text)

# ============================================================
# Query String & Form Helpers
# ============================================================

# Build a URL-encoded query string from a dict
# Example: build_query({"q": "hello world", "page": "1"}) -> "q=hello%20world&page=1"
pub def build_query(params: Any) -> str:
	unsafe:
		return __dict_to_query_str(params)

# Perform a POST request with form-encoded body (application/x-www-form-urlencoded)
pub def post_form(url: str, data: Any) -> Response:
	unsafe:
		let body = __dict_to_query_str(data)
		let raw = __http_request("POST", url, body, "Content-Type: application/x-www-form-urlencoded\r\n")
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# ============================================================
# Authentication Helpers
# ============================================================

# Build a Basic auth header value: "Basic base64(user:pass)"
# Use with: http.request("GET", url, "", http.basic_auth(user, pass))
pub def basic_auth(user: str, password: str) -> str:
	unsafe:
		let credentials = user + ":" + password
		let encoded = __base64_encode(credentials)
		return "Authorization: Basic " + encoded + "\r\n"

# Build a Bearer token auth header: "Authorization: Bearer <token>"
# Use with: http.request("GET", url, "", http.bearer_auth(token))
pub def bearer_auth(token: str) -> str:
	return "Authorization: Bearer " + token + "\r\n"

# ============================================================
# Response Helpers
# ============================================================

# Check if a response status is successful (200-299)
pub def is_ok(resp: Response) -> bool:
	return resp.status >= 200 and resp.status < 300

# Check if a response is a redirect (301, 302, 303, 307, 308)
pub def is_redirect(resp: Response) -> bool:
	return resp.status == 301 or resp.status == 302 or resp.status == 303 or resp.status == 307 or resp.status == 308

# Check if a response is a client error (400-499)
pub def is_client_error(resp: Response) -> bool:
	return resp.status >= 400 and resp.status < 500

# Check if a response is a server error (500-599)
pub def is_server_error(resp: Response) -> bool:
	return resp.status >= 500 and resp.status < 600

# ============================================================
# Server — C Runtime Bindings
# ============================================================

@extern("C")
def __http_server_new(port: int) -> Any

@extern("C")
def __http_server_run(server: Any) -> none

# Response builders
@extern("C")
def __http_resp_new(status: int, body: str, content_type: str) -> Any

@extern("C")
def __http_resp_status(resp: Any) -> int

@extern("C")
def __http_resp_body(resp: Any) -> str

@extern("C")
def __http_resp_content_type(resp: Any) -> str

# Request accessors
@extern("C")
def __http_req_method(req: Any) -> str

@extern("C")
def __http_req_path(req: Any) -> str

@extern("C")
def __http_req_body(req: Any) -> str

@extern("C")
def __http_req_header(req: Any, name: str) -> str

@extern("C")
def __http_req_query(req: Any) -> str

# Handler registration (passes Desi function as C function pointer)
@extern("C")
def __http_server_set_handler(handler: Any) -> none

# ============================================================
# Server — Public API
# ============================================================

# Create a new HTTP server bound to the given port
pub def server(port: int) -> Any:
	return __http_server_new(port)

# Start the server's accept loop (blocks forever, no routing — echo mode)
pub def listen(srv: Any) -> none:
	__http_server_run(srv)

# Start the server with a Desi dispatch handler
# The handler receives a request and must return a response
# Example: http.serve(srv, my_handler)
# Note: this body is replaced by the lowerer at the user's callsite
pub def serve(srv: Any, handler: Any) -> none:
	print("http.serve: handler registered")

# ============================================================
# Server — Response Builders
# ============================================================

# Build a plain text response
pub def text(status: int, body: str) -> Any:
	return __http_resp_new(status, body, "text/plain; charset=utf-8")

# Build a JSON response from a string
pub def json_text(status: int, body: str) -> Any:
	return __http_resp_new(status, body, "application/json")

# Build a JSON response from a dict
pub def json(status: int, data: dict[str, Any]) -> Any:
	let body = __dict_to_json_str(data)
	return __http_resp_new(status, body, "application/json")

# Build an HTML response
pub def html(status: int, body: str) -> Any:
	return __http_resp_new(status, body, "text/html; charset=utf-8")

# Build a response with custom content type
pub def response(status: int, body: str, content_type: str) -> Any:
	return __http_resp_new(status, body, content_type)

# ============================================================
# Server — Request Accessors
# ============================================================

# Get the HTTP method of a server request
pub def req_method(req: Any) -> str:
	return __http_req_method(req)

# Get the path of a server request
pub def req_path(req: Any) -> str:
	return __http_req_path(req)

# Get the body of a server request
pub def req_body(req: Any) -> str:
	return __http_req_body(req)

# Get a header value from a server request
pub def req_header(req: Any, name: str) -> str:
	return __http_req_header(req, name)

# Get the query string of a server request
pub def req_query(req: Any) -> str:
	return __http_req_query(req)
