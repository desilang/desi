# HTTP module - HTTP client for Desi
# Self-contained: POSIX sockets + platform TLS (no libcurl)
# Supports HTTP/1.1, HTTPS, IPv4+IPv6, redirects, chunked encoding

# ============================================================
# C Runtime Bindings
# ============================================================

@extern("C")
def __http_get(url: str) -> Any

@extern("C")
def __http_post(url: str, body: str) -> Any

@extern("C")
def __http_put(url: str, body: str) -> Any

@extern("C")
def __http_patch(url: str, body: str) -> Any

@extern("C")
def __http_delete(url: str) -> Any

@extern("C")
def __http_head(url: str) -> Any

@extern("C")
def __http_options(url: str) -> Any

@extern("C")
def __http_request(method: str, url: str, body: str, headers: str) -> Any

@extern("C")
def __http_request_timeout(method: str, url: str, body: str, headers: str, timeout_secs: int) -> Any

@extern("C")
def __http_request_no_redirect(method: str, url: str, body: str, headers: str) -> Any

# TLS certificate configuration
@extern("C")
def __http_set_ca_bundle(path: str) -> none

@extern("C")
def __http_set_client_cert(cert: str, key: str) -> none

# Proxy configuration
@extern("C")
def __http_set_proxy(host: str, port: int) -> none

@extern("C")
def __http_clear_proxy() -> none

# JSON parser (from json.c runtime, for auto-parsing response bodies)
@extern("C")
def __json_parse(text: str) -> Any

@extern("C")
def __http_response_status(resp: Any) -> int

@extern("C")
def __http_response_body(resp: Any) -> str

@extern("C")
def __http_response_headers(resp: Any) -> str

@extern("C")
def __http_url_encode(s: str) -> str

@extern("C")
def __http_url_decode(s: str) -> str

# Dict-to-JSON bridge (from json.c runtime, used by *_json convenience methods)
# Converts a Desi dict_t directly to a JSON string with quoted keys and typed values
@extern("C")
def __dict_to_json_str(data: Any) -> str

# Dict-to-query-string bridge (from http.c runtime)
# Converts a Desi dict_t to URL-encoded key=val&key=val query string
@extern("C")
def __dict_to_query_str(data: Any) -> str

# Base64 encode (for Basic auth headers)
@extern("C")
def __base64_encode(s: str) -> str

# ============================================================
# Response Type
# ============================================================

struct Response:
	pub status: int
	pub body: str
	pub headers: str

# ============================================================
# Opaque Types (nominal type aliases for compile-time safety)
# ============================================================

pub type Server = Any
pub type Request = Any

# ============================================================
# Public API
# ============================================================

# Perform a GET request
pub def get(url: str) -> Response:
	unsafe:
		let raw = __http_get(url)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a POST request with a string body
pub def post(url: str, body: str) -> Response:
	unsafe:
		let raw = __http_post(url, body)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a POST request with auto-JSON serialization
# Accepts dict, list, int, float, bool, str, or any serializable value
pub def post_json(url: str, data: Any) -> Response:
	unsafe:
		let body = __dict_to_json_str(data)
		let raw = __http_post(url, body)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a PUT request with a string body
pub def put(url: str, body: str) -> Response:
	unsafe:
		let raw = __http_put(url, body)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a PUT request with auto-JSON serialization
pub def put_json(url: str, data: Any) -> Response:
	unsafe:
		let body = __dict_to_json_str(data)
		let raw = __http_put(url, body)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a PATCH request with a string body
pub def patch(url: str, body: str) -> Response:
	unsafe:
		let raw = __http_patch(url, body)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a PATCH request with auto-JSON serialization
pub def patch_json(url: str, data: Any) -> Response:
	unsafe:
		let body = __dict_to_json_str(data)
		let raw = __http_patch(url, body)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a DELETE request
pub def delete(url: str) -> Response:
	unsafe:
		let raw = __http_delete(url)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a HEAD request (body will be empty)
pub def head(url: str) -> Response:
	unsafe:
		let raw = __http_head(url)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform an OPTIONS request
pub def options(url: str) -> Response:
	unsafe:
		let raw = __http_options(url)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a custom HTTP request with method, URL, body, and headers
# Headers should be in "Key: Value\r\n" format
pub def request(method: str, url: str, body: str, headers: str) -> Response:
	unsafe:
		let raw = __http_request(method, url, body, headers)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a custom HTTP request with a timeout (in seconds)
# All other methods use a default 30-second timeout
pub def request_timeout(method: str, url: str, body: str, headers: str, timeout: int) -> Response:
	unsafe:
		let raw = __http_request_timeout(method, url, body, headers, timeout)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a custom HTTP request with auto-JSON body and optional timeout
pub def request_json(method: str, url: str, data: Any, timeout: int) -> Response:
	unsafe:
		let body = __dict_to_json_str(data)
		let raw = __http_request_timeout(method, url, body, "Content-Type: application/json\r\n", timeout)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# Perform a custom HTTP request without following redirects
# Returns the raw redirect response (301/302/etc.) instead of following Location header
pub def request_no_redirect(method: str, url: str, body: str, headers: str) -> Response:
	unsafe:
		let raw = __http_request_no_redirect(method, url, body, headers)
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# URL-encode a string (RFC 3986)
pub def url_encode(s: str) -> str:
	unsafe:
		return __http_url_encode(s)

# URL-decode a string
pub def url_decode(s: str) -> str:
	unsafe:
		return __http_url_decode(s)

# Parse a JSON response body into a JSON node
# Returns a JSON node that can be accessed with json module functions
pub def parse_json(text: str) -> Any:
	unsafe:
		return __json_parse(text)

# ============================================================
# Query String & Form Helpers
# ============================================================

# Build a URL-encoded query string from a dict
# Example: build_query({"q": "hello world", "page": "1"}) -> "q=hello%20world&page=1"
pub def build_query(params: Any) -> str:
	unsafe:
		return __dict_to_query_str(params)

# Perform a POST request with form-encoded body (application/x-www-form-urlencoded)
pub def post_form(url: str, data: Any) -> Response:
	unsafe:
		let body = __dict_to_query_str(data)
		let raw = __http_request("POST", url, body, "Content-Type: application/x-www-form-urlencoded\r\n")
		let resp = Response(
			status=__http_response_status(raw),
			body=__http_response_body(raw),
			headers=__http_response_headers(raw)
		)
		return resp

# ============================================================
# Authentication Helpers
# ============================================================

# Build a Basic auth header value: "Basic base64(user:pass)"
# Use with: http.request("GET", url, "", http.basic_auth(user, pass))
pub def basic_auth(user: str, password: str) -> str:
	unsafe:
		let credentials = user + ":" + password
		let encoded = __base64_encode(credentials)
		return "Authorization: Basic " + encoded + "\r\n"

# Build a Bearer token auth header: "Authorization: Bearer <token>"
# Use with: http.request("GET", url, "", http.bearer_auth(token))
pub def bearer_auth(token: str) -> str:
	return "Authorization: Bearer " + token + "\r\n"

# ============================================================
# Response Helpers
# ============================================================

# Check if a response status is successful (200-299)
pub def is_ok(resp: Response) -> bool:
	return resp.status >= 200 and resp.status < 300

# Check if a response is a redirect (301, 302, 303, 307, 308)
pub def is_redirect(resp: Response) -> bool:
	return resp.status == 301 or resp.status == 302 or resp.status == 303 or resp.status == 307 or resp.status == 308

# Check if a response is a client error (400-499)
pub def is_client_error(resp: Response) -> bool:
	return resp.status >= 400 and resp.status < 500

# Check if a response is a server error (500-599)
pub def is_server_error(resp: Response) -> bool:
	return resp.status >= 500 and resp.status < 600

# ============================================================
# Server — C Runtime Bindings
# ============================================================

@extern("C")
def __http_server_new(port: int) -> Any

@extern("C")
def __http_server_new_tls(port: int, cert: str, key: str) -> Any

@extern("C")
def __http_server_run(server: Any) -> none

# Response builders
@extern("C")
def __http_resp_new(status: int, body: str, content_type: str) -> Any

@extern("C")
def __http_resp_from_file(status: int, path: str, content_type: str) -> Any

@extern("C")
def __http_resp_status(resp: Any) -> int

@extern("C")
def __http_resp_body(resp: Any) -> str

@extern("C")
def __http_resp_content_type(resp: Any) -> str

# Request accessors
@extern("C")
def __http_req_method(req: Any) -> str

@extern("C")
def __http_req_path(req: Any) -> str

@extern("C")
def __http_req_body(req: Any) -> str

@extern("C")
def __http_req_header(req: Any, name: str) -> str

@extern("C")
def __http_req_query(req: Any) -> str

# Handler registration (passes Desi function as C function pointer)
@extern("C")
def __http_server_set_handler(handler: Any) -> none

# Server shutdown
@extern("C")
def __http_server_shutdown() -> none

# Multipart form data accessors
@extern("C")
def __http_req_form_field(req: Any, name: str) -> str

@extern("C")
def __http_req_form_file(req: Any, name: str) -> str

@extern("C")
def __http_req_form_filename(req: Any, name: str) -> str

@extern("C")
def __http_req_form_file_size(req: Any, name: str) -> int

# SSE (Server-Sent Events)
@extern("C")
def __http_sse_start(req: Any) -> int

@extern("C")
def __http_sse_send_data(req: Any, data: str) -> none

@extern("C")
def __http_sse_send(req: Any, data: str, event: str) -> none

@extern("C")
def __http_sse_close(req: Any) -> none

@extern("C")
def __http_sse_response() -> Any

# Cookie jar (client)
@extern("C")
def __http_enable_cookies() -> none

@extern("C")
def __http_disable_cookies() -> none

@extern("C")
def __http_clear_cookies() -> none

# ============================================================
# Server — Public API
# ============================================================

# Create a new HTTP server bound to the given port
pub def server(port: int) -> Server:
	return __http_server_new(port)

# Create a new HTTPS server with TLS certificate and key
# Example: http.server(9443, "cert.pem", "key.pem")
pub def server(port: int, cert: str, key: str) -> Server:
	return __http_server_new_tls(port, cert, key)

# Start the server's accept loop (blocks forever, no routing — echo mode)
pub def listen(srv: Server) -> none:
	__http_server_run(srv)

# Start the server with a Desi dispatch handler (2-arg form)
# Or start the server with registered routes only (1-arg form)
# Example: http.serve(srv, my_handler)  OR  http.serve(srv)
# Note: lowerer intercepts http.serve() at callsite and emits
#   2-arg: __http_server_set_handler(@handler) + __http_server_run(srv)
#   1-arg: __http_server_run(srv) (uses registered routes)
# This body is never executed — it exists only for the type checker.
pub def serve(srv: Server) -> none:
	return

pub def serve(srv: Server, handler: Any) -> none:
	return

# ============================================================
# Server — Route Registration
# ============================================================

# Register a route handler for a specific method and path
# Note: lowerer intercepts and emits __http_server_route(srv, method, path, @handler)
pub def route(srv: Server, method: str, path: str, handler: Any) -> none:
	return

# Convenience route helpers
pub def get(srv: Server, path: str, handler: Any) -> none:
	return

pub def post(srv: Server, path: str, handler: Any) -> none:
	return

pub def put(srv: Server, path: str, handler: Any) -> none:
	return

pub def delete(srv: Server, path: str, handler: Any) -> none:
	return

pub def patch(srv: Server, path: str, handler: Any) -> none:
	return

# Serve static files from a directory
# Maps URL prefix to filesystem dir (e.g. http.serve_static(srv, "/static", "./public"))
# Note: lowerer intercepts and emits __http_server_static(srv, prefix, dir)
pub def serve_static(srv: Server, prefix: str, dir: str) -> none:
	return

# ============================================================
# Server — Response Builders
# ============================================================

# Build a plain text response
pub def text(status: int, body: str) -> Any:
	return __http_resp_new(status, body, "text/plain; charset=utf-8")

# Build a JSON response from a string
pub def json_text(status: int, body: str) -> Any:
	return __http_resp_new(status, body, "application/json")

# Build a JSON response from a dict
pub def json(status: int, data: dict[str, Any]) -> Any:
	let body = __dict_to_json_str(data)
	return __http_resp_new(status, body, "application/json")

# Build an HTML response
pub def html(status: int, body: str) -> Any:
	return __http_resp_new(status, body, "text/html; charset=utf-8")

# Build a response with custom content type
pub def response(status: int, body: str, content_type: str) -> Any:
	return __http_resp_new(status, body, content_type)

# Serve an HTML file from disk
# Example: return http.html_file("templates/index.html")
pub def html_file(path: str) -> Any:
	unsafe:
		return __http_resp_from_file(200, path, "text/html; charset=utf-8")

# Serve a file from disk with custom status and content type
# Example: return http.file_response(200, "data.json", "application/json")
pub def file_response(status: int, path: str, content_type: str) -> Any:
	unsafe:
		return __http_resp_from_file(status, path, content_type)

# ============================================================
# Server — Request Accessors
# ============================================================

# Get the HTTP method of a server request
pub def req_method(req: Request) -> str:
	return __http_req_method(req)

# Get the path of a server request
pub def req_path(req: Request) -> str:
	return __http_req_path(req)

# Get the body of a server request
pub def req_body(req: Request) -> str:
	return __http_req_body(req)

# Get a header value from a server request
pub def req_header(req: Request, name: str) -> str:
	return __http_req_header(req, name)

# Get the query string of a server request
pub def req_query(req: Request) -> str:
	return __http_req_query(req)

# Get a query parameter value by key (e.g. ?name=alice → req_param(req, "name") → "alice")
pub def req_param(req: Request, key: str) -> str:
	return __http_req_param(req, key)

# Get a path parameter value (e.g. /users/:id → req_path_param(req, "id"))
pub def req_path_param(req: Request, name: str) -> str:
	return __http_req_path_param(req, name)

# Parse request body as JSON (returns JSON node, or none if invalid)
pub def req_json(req: Request) -> Any:
	return __http_req_json(req)

# Get a multipart form field value by name
# Example: http.req_form_field(req, "username")
pub def req_form_field(req: Request, name: str) -> str:
	return __http_req_form_field(req, name)

# Get uploaded file data by field name (returns raw file data as str)
# Example: http.req_form_file(req, "avatar")
pub def req_form_file(req: Request, name: str) -> str:
	return __http_req_form_file(req, name)

# Get the original filename of an uploaded file
# Example: http.req_form_filename(req, "avatar") → "photo.jpg"
pub def req_form_filename(req: Request, name: str) -> str:
	return __http_req_form_filename(req, name)

# Get the size in bytes of an uploaded file
pub def req_form_file_size(req: Request, name: str) -> int:
	return __http_req_form_file_size(req, name)

# ============================================================
# Server — SSE (Server-Sent Events)
# ============================================================

# Start an SSE stream on the request connection.
# Sends HTTP headers for text/event-stream.
# Call this BEFORE sending events.
# Example:
#   http.sse_start(req)
#   http.sse_send(req, "hello")
#   http.sse_close(req)
#   return http.sse_response()
pub def sse_start(req: Request) -> int:
	unsafe:
		return __http_sse_start(req)

# Send an SSE data event.
# Example: http.sse_send(req, "hello world")
pub def sse_send(req: Request, data: str) -> none:
	unsafe:
		__http_sse_send_data(req, data)

# Send an SSE event with a named event type.
# Example: http.sse_send_event(req, "{\"count\": 5}", "update")
pub def sse_send_event(req: Request, data: str, event: str) -> none:
	unsafe:
		__http_sse_send(req, data, event)

# Close the SSE stream and the underlying connection.
pub def sse_close(req: Request) -> none:
	unsafe:
		__http_sse_close(req)

# Return this from a handler that uses SSE.
# Tells the server not to send a normal response.
# Example:
#   def handler(req: Request) -> Any:
#       http.sse_start(req)
#       http.sse_send(req, "hello")
#       http.sse_close(req)
#       return http.sse_response()
pub def sse_response() -> Any:
	unsafe:
		return __http_sse_response()


# ============================================================
# Server — Configuration
# ============================================================

# Set maximum request body size in bytes (default: 1MB)
# Example: http.max_body(srv, 1024 * 512)  # 512KB
pub def max_body(srv: Server, max_bytes: int) -> none:
	return

# Register a middleware function (runs before route handlers)
# Middleware returns none to pass through, or a response to short-circuit
# Note: lowerer intercepts http.use() and emits __http_server_use(srv, @fn)
pub def use(srv: Server, middleware: Any) -> none:
	return

# Enable rate limiting: max requests per window (seconds)
# Example: http.rate_limit(srv, 60, 60)  # 60 requests per 60 seconds per IP
pub def rate_limit(srv: Server, max_requests: int, window_secs: int) -> none:
	return

# Set a custom header on a response
# Example: http.header(resp, "X-Request-Id", "abc123")
pub def header(resp: Any, key: str, value: str) -> none:
	__http_resp_header(resp, key, value)

# Enable CORS for the given origin ("*" for any, or specific domain)
# Automatically handles OPTIONS preflight requests
# Note: lowerer intercepts http.cors() and emits __http_server_cors(srv, origin)
pub def cors(srv: Server, origin: str) -> none:
	return

# Get a cookie value from a request
# Returns "" if cookie not found
pub def get_cookie(req: Request, name: str) -> str:
	return __http_req_cookie(req, name)

# Set a cookie on a response
# max_age in seconds (0 = session cookie)
# Automatically adds HttpOnly, SameSite=Lax, Path=/
pub def set_cookie(resp: Any, name: str, value: str, max_age: int) -> none:
	__http_resp_cookie(resp, name, value, max_age)

# Programmatically stop the server's accept loop
# Triggers graceful shutdown (drain queue, join workers)
pub def shutdown() -> none:
	__http_server_shutdown()

# ============================================================
# Client — Cookie Persistence
# ============================================================

# Enable automatic cookie storage and replay for HTTP client requests
# Cookies from Set-Cookie response headers are stored and sent on matching requests
pub def enable_cookies() -> none:
	__http_enable_cookies()

# Disable automatic cookie handling (does not clear stored cookies)
pub def disable_cookies() -> none:
	__http_disable_cookies()

# Clear all stored cookies
pub def clear_cookies() -> none:
	__http_clear_cookies()

# ============================================================
# Client — TLS Certificate Configuration
# ============================================================

# Set a custom CA bundle file for HTTPS certificate verification
# Example: http.set_ca_bundle("/path/to/ca-bundle.crt")
pub def set_ca_bundle(path: str) -> none:
	__http_set_ca_bundle(path)

# Set a client certificate and key for mutual TLS (mTLS)
# Example: http.set_client_cert("client.pem", "client-key.pem")
pub def set_client_cert(cert: str, key: str) -> none:
	__http_set_client_cert(cert, key)

# ============================================================
# Client — Proxy Configuration
# ============================================================

# Route all HTTP/HTTPS client requests through a proxy
# HTTPS requests use HTTP CONNECT tunnel through the proxy
# Example: http.set_proxy("proxy.example.com", 8080)
pub def set_proxy(host: str, port: int) -> none:
	__http_set_proxy(host, port)

# Clear proxy configuration (connect directly to target)
pub def clear_proxy() -> none:
	__http_clear_proxy()

