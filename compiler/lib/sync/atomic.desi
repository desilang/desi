        # Implemented via C runtime: atomic_int_new(initial)
        pass
    
    pub def load(self) -> int:
        # Atomically load and return the current value
        # Implemented via C runtime: atomic_int_load
        pass
    
    pub def store(self, value: int) -> none:
        # Atomically store a new value
        # Implemented via C runtime: atomic_int_store
        pass
    
    pub def add(self, delta: int) -> int:
        # Atomically add delta and return the NEW value
        # Implemented via C runtime: atomic_int_add
        pass
    
    pub def sub(self, delta: int) -> int:
        # Atomically subtract delta and return the NEW value
