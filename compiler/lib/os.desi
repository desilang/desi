# os module — operating system functions
#
# Provides environment variables, process info, directory operations,
# platform detection, and command execution.
#
# Usage:
#   import os
#   let home = os.getenv("HOME")
#   let cwd = os.getcwd()
#   os.setenv("MY_VAR", "hello")
#   print(os.platform())

# --- C runtime bindings ---

@extern("C")
pub def __os_getenv(key: str) -> str

@extern("C")
pub def __os_setenv(key: str, val: str) -> none

@extern("C")
pub def __os_getcwd() -> str

@extern("C")
pub def __os_chdir(path: str) -> int

@extern("C")
pub def __os_platform() -> str

@extern("C")
pub def __os_name() -> str

@extern("C")
pub def __os_arch() -> str

@extern("C")
pub def __os_hostname() -> str

@extern("C")
pub def __os_getpid() -> int

@extern("C")
pub def __os_cpu_count() -> int

@extern("C")
pub def __os_system(cmd: str) -> int

@extern("C")
pub def __os_exit(code: int) -> none

# --- File I/O bindings ---

@extern("C")
pub def __os_read_file(path: str) -> str

@extern("C")
pub def __os_write_file(path: str, data: str) -> int

@extern("C")
pub def __os_append_file(path: str, data: str) -> int

@extern("C")
pub def __os_exists(path: str) -> bool

@extern("C")
pub def __os_is_file(path: str) -> bool

@extern("C")
pub def __os_is_dir(path: str) -> bool

@extern("C")
pub def __os_file_size(path: str) -> int

@extern("C")
pub def __os_mkdir(path: str) -> int

@extern("C")
pub def __os_rmdir(path: str) -> int

@extern("C")
pub def __os_remove(path: str) -> int

@extern("C")
pub def __os_rename(old_path: str, new_path: str) -> int

@extern("C")
pub def __os_listdir(path: str) -> list[str]

# --- Public API ---

## Get an environment variable value. Returns empty string if not set.
pub def getenv(key: str) -> str:
	unsafe:
		return __os_getenv(key)

## Set an environment variable.
pub def setenv(key: str, val: str) -> none:
	unsafe:
		__os_setenv(key, val)

## Get the current working directory.
pub def getcwd() -> str:
	unsafe:
		return __os_getcwd()

## Change the current working directory. Returns 0 on success.
pub def chdir(path: str) -> int:
	unsafe:
		return __os_chdir(path)

## Get the platform identifier: "darwin", "linux", or "windows".
pub def platform() -> str:
	unsafe:
		return __os_platform()

## Get the OS name: "macOS", "Linux", "Windows".
pub def name() -> str:
	unsafe:
		return __os_name()

## Get the CPU architecture: "arm64", "x86_64", etc.
pub def arch() -> str:
	unsafe:
		return __os_arch()

## Get the system hostname.
pub def hostname() -> str:
	unsafe:
		return __os_hostname()

## Get the current process ID.
pub def getpid() -> int:
	unsafe:
		return __os_getpid()

## Get the number of CPU cores.
pub def cpu_count() -> int:
	unsafe:
		return __os_cpu_count()

## Run a shell command. Returns the exit code.
pub def system(cmd: str) -> int:
	unsafe:
		return __os_system(cmd)

## Exit the program with a status code.
pub def exit(code: int) -> none:
	unsafe:
		__os_exit(code)

# --- Public API: File I/O ---

## Read entire file as string. Returns empty string on error.
pub def read_file(path: str) -> str:
	unsafe:
		return __os_read_file(path)

## Write string to file (creates or overwrites). Returns 0 on success.
pub def write_file(path: str, data: str) -> int:
	unsafe:
		return __os_write_file(path, data)

## Append string to file (creates if needed). Returns 0 on success.
pub def append_file(path: str, data: str) -> int:
	unsafe:
		return __os_append_file(path, data)

## Check if a path exists (file or directory).
pub def exists(path: str) -> bool:
	unsafe:
		return __os_exists(path)

## Check if path is a regular file.
pub def is_file(path: str) -> bool:
	unsafe:
		return __os_is_file(path)

## Check if path is a directory.
pub def is_dir(path: str) -> bool:
	unsafe:
		return __os_is_dir(path)

## Get file size in bytes. Returns -1 on error.
pub def file_size(path: str) -> int:
	unsafe:
		return __os_file_size(path)

## Create a directory. Returns 0 on success.
pub def mkdir(path: str) -> int:
	unsafe:
		return __os_mkdir(path)

## Remove an empty directory. Returns 0 on success.
pub def rmdir(path: str) -> int:
	unsafe:
		return __os_rmdir(path)

## Remove a file. Returns 0 on success.
pub def remove(path: str) -> int:
	unsafe:
		return __os_remove(path)

## Rename a file or directory. Returns 0 on success.
pub def rename(old_path: str, new_path: str) -> int:
	unsafe:
		return __os_rename(old_path, new_path)

## List directory contents (excludes . and ..).
pub def listdir(path: str) -> list[str]:
	unsafe:
		return __os_listdir(path)

