# db module — Database ORM and Query Builder
#
# Django-inspired ORM with SQL query builder.
# Supports PostgreSQL and MySQL with shared API.
#
# Usage:
#   import db
#
#   # Define model
#   db.model("users")
#   db.auto_field("id")
#   db.char_field("name", 100, 0, 0)
#   db.int_field("age", 0, 0)
#
#   # Query builder
#   db.select("users")
#   db.where("age", ">", "21")
#   let sql = db.build_sql()

# --- Query Builder C bindings ---

