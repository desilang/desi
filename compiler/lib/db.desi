# ============================================================
# Unified Public API
# ============================================================

pub def connect(driver: str, host: str, port: int, dbname: str, user: str, password: str) -> int:
	"""Connect to database. driver: 'postgres'/'pg' or 'mysql'/'my'. Returns 0 on success."""
	return __db_connect(driver, host, port, dbname, user, password)

pub def close() -> int:
	"""Close the active database connection."""
	return __db_close()

pub def is_connected() -> int:
	"""Check if connected. Returns 1 or 0."""
	return __db_is_connected()

pub def last_error() -> str:
	"""Get last error message."""
	return __db_last_error()

pub def query(sql: str) -> int:
	"""Execute a SELECT query. Returns number of rows, or -1 on error."""
	return __db_query_exec(sql)

pub def execute(sql: str) -> int:
	"""Execute INSERT/UPDATE/DELETE/DDL. Returns affected rows, or -1 on error."""
	return __db_execute_stmt(sql)

pub def row_count() -> int:
	"""Number of rows in the last query result."""
	return __db_row_count()

pub def col_count() -> int:
	"""Number of columns in the last query result."""
	return __db_col_count()

pub def col_name(idx: int) -> str:
	"""Get column name by index."""
	return __db_col_name_at(idx)

pub def get_value(row: int, col: int) -> str:
	"""Get field value by row and column index."""
	return __db_get_value_at(row, col)

pub def get_field(row: int, col_name: str) -> str:
	"""Get field value by row and column name."""
	return __db_get_field_by(row, col_name)

pub def driver() -> str:
	"""Get active driver name ('postgres', 'mysql', or 'none')."""
	return __db_driver()

pub def set_timeout(connect_ms: int, read_ms: int) -> int:
	"""Set connection and read timeouts in milliseconds.
	connect_ms: TCP connect timeout (default 5000ms).
	read_ms: socket read timeout (default 30000ms).
	Call before db.connect() to take effect.
	Usage: db.set_timeout(3000, 10000)"""
	return __db_set_timeout(connect_ms, read_ms)

# ============================================================
# Debug Helpers
# ============================================================

pub def set_debug(enabled: int) -> int:
	"""Enable/disable debug logging for all drivers."""
	return __db_debug_mode(enabled)

pub def dump_results() -> int:
	"""Print last query result set to stderr."""
	return __db_dump()

pub def connection_info() -> str:
	"""Get connection info string."""
	return __db_conn_info()

