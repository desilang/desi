pub def __qs_create2(k1: str, v1: str, k2: str, v2: str) -> int

@extern("C")
pub def __qs_create3(k1: str, v1: str, k2: str, v2: str, k3: str, v3: str) -> int

@extern("C")
pub def __qs_create4(k1: str, v1: str, k2: str, v2: str, k3: str, v3: str, k4: str, v4: str) -> int

@extern("C")
pub def __qs_create5(k1: str, v1: str, k2: str, v2: str, k3: str, v3: str, k4: str, v4: str, k5: str, v5: str) -> int

