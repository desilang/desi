# ============================================================
# Public ORM API — Django-style QuerySet
#
# Usage:
#   db.objects("users")             # set active table
#   db.filter("age__gt", "21")     # add WHERE
#   db.order_by("-name")           # add ORDER BY
#   let n = db.all()               # execute SELECT, returns row count
#   let c = db.count()             # SELECT COUNT(*)
# ============================================================

pub def objects(table: str) -> int:
	"""Set active table for ORM queries (like Django's Model.objects)."""
	return __qs_reset(table)

pub def filter_by(lookup: str, val: str) -> int:
	"""Add WHERE condition. Supports Django lookups: age__lt, name__contains, etc."""
	return __qs_filter(lookup, val)

pub def exclude(lookup: str, val: str) -> int:
	"""Add WHERE NOT condition."""
	return __qs_exclude(lookup, val)

pub def sort_by(col: str) -> int:
	"""Order results. Use '-name' for DESC (like Django's .order_by())."""
	return __qs_order_by(col)

pub def set_limit(n: int) -> int:
	"""Limit result count for ORM queryset."""
	return __qs_limit(n)

pub def set_offset(n: int) -> int:
	"""Offset results for ORM queryset (for pagination)."""
	return __qs_offset(n)

pub def select_related(field_name: str) -> int:
	"""Eagerly load a FK-related object via LEFT JOIN (like Django's select_related).
	Call after db.objects(). Related fields accessible as 'fk_field__column'.
	Usage: db.objects("posts"); db.select_related("author_id"); db.fetch_all()"""
	return __qs_select_related(field_name)

pub def select_for_update(mode: str) -> int:
	"""Acquire row-level locks on selected rows (like Django's select_for_update).
	Must be used within a transaction (db.begin/commit/rollback).
	mode: "" or "default" → FOR UPDATE (blocks until lock acquired)
	      "nowait"         → FOR UPDATE NOWAIT (raises error if locked)
	      "skip_locked"    → FOR UPDATE SKIP LOCKED (skips locked rows)
	Both PG and MySQL support all three modes.
	Usage:
	  db.begin()
	  db.objects("accounts")
	  db.filter_by("id", "1")
	  db.select_for_update("nowait")
	  db.fetch_all()
	  db.update("balance", "100")
	  db.commit()"""
	return __qs_select_for_update(mode)

pub def annotate(alias: str, func: str, col: str) -> int:
	"""Add an aggregate annotation to the query.
	func: SUM, COUNT, AVG, MIN, MAX
	Usage: db.objects("orders"); db.annotate("total", "SUM", "amount")
	Django equivalent: .annotate(total=Sum("amount"))"""
	return __qs_annotate(alias, func, col)

pub def group_by(cols: str) -> int:
	"""Set GROUP BY columns (comma-separated).
	Usage: db.objects("orders"); db.group_by("customer_id")
	Often used with annotate() for grouped aggregations."""
	return __qs_group_by(cols)

pub def raw(sql: str) -> int:
	"""Execute raw SQL query directly.
	For SELECT: populates result set, returns row count.
	For DML (INSERT/UPDATE/DELETE): returns affected rows.
	Usage: db.raw("SELECT * FROM users WHERE age > 21")
	Django equivalent: Model.objects.raw("SELECT ...")"""
	return __qs_raw(sql)

pub def fetch_all() -> int:
	"""Execute SELECT and return row count (like Django's .all())."""
	return __qs_fetch()

pub def rows() -> int:
	"""Row count from last query."""
	return __qs_row_count()

pub def count() -> int:
	"""Return COUNT(*) for current queryset (like Django's QuerySet.count())."""
	return __qs_count()

pub def exists() -> int:
	"""Check if any rows match. Returns 1 or 0 (like Django's QuerySet.exists())."""
	return __qs_exists()

pub def update(col: str, val: str) -> int:
	"""UPDATE single column for matching rows."""
	return __qs_update(col, val)

pub def filter(**lookups: str) -> int:
	"""Django-style kwargs WHERE. Call db.objects(table) first.
	Usage: db.filter(name="Alice", age__gt="21")"""
	for lookup, val in lookups.items():
		__qs_filter(lookup, val)
	0

pub def update_fields(**fields: str) -> int:
	"""Django-style kwargs UPDATE. Call db.objects(table) + db.filter() first.
	Usage: db.update_fields(email="new@test.com", age="31")"""
	for col, val in fields.items():
		__qs_update(col, val)
	0

pub def get(**filters: str) -> int:
	"""Get single row matching filters. Returns row count (0 or 1).
	Usage: db.objects("users"); db.get(name="Alice")"""
	for lookup, val in filters.items():
		__qs_filter(lookup, val)
	__qs_limit(1)
	return __qs_fetch()

pub def delete() -> int:
	"""DELETE matching rows (like Django's QuerySet.delete())."""
	return __qs_delete()

# ============================================================
# latest / earliest
# ============================================================

pub def latest(field: str) -> int:
	"""Get the most recent row ordered by the given field.
	Django equivalent: Entry.objects.latest('pub_date')
	If field is empty, defaults to 'id'.
	Usage: db.objects("entries"); db.latest("pub_date")"""
	return __qs_latest(field)

pub def earliest(field: str) -> int:
	"""Get the oldest row ordered by the given field.
	Django equivalent: Entry.objects.earliest('pub_date')
	If field is empty, defaults to 'id'.
	Usage: db.objects("entries"); db.earliest("created_at")"""
	return __qs_earliest(field)

# ============================================================
# only / defer (column selection)
# ============================================================

pub def only(cols: str) -> int:
	"""Restrict SELECT to specific columns only. Comma-separated.
	Django equivalent: Entry.objects.only('id', 'name', 'email')
	Usage: db.objects("users"); db.only("id, name, email"); db.fetch_all()"""
	return __qs_only(cols)

pub def defer_fields(cols: str) -> int:
	"""Select all columns EXCEPT the listed ones. Comma-separated.
	Django equivalent: Entry.objects.defer('body', 'metadata')
	Queries the live schema to build the exclusion list.
	Usage: db.objects("posts"); db.defer_fields("body, metadata"); db.fetch_all()"""
	return __qs_defer(cols)

# ============================================================
# in_bulk — fetch by PK list
# ============================================================

pub def in_bulk(id_list: str, field: str) -> int:
	"""Fetch multiple rows by primary key list in a single query.
	Django equivalent: User.objects.in_bulk([1, 2, 3])
	id_list: comma-separated PKs, e.g. "1,2,3"
	field: PK column name (default "id" if empty)
	Returns row count.
	Usage:
	  db.objects("users")
	  let n = db.in_bulk("1,2,3", "id")"""
	return __qs_in_bulk(id_list, field)

# ============================================================
# values_list — column projection
# ============================================================

pub def values_list(cols: str) -> int:
	"""Restrict SELECT to specific columns (like Django's values_list).
	Django equivalent: User.objects.values_list("id", "name", flat=True)
	cols: comma-separated column names, e.g. "id,name,email"
	Usage:
	  db.objects("users")
	  db.values_list("id, name")
	  db.fetch_all()"""
	return __qs_only(cols)

# ============================================================
# Database Functions — SQL expression builders
#
# These return SQL expression strings (e.g. "LOWER(name)")
# for use in annotate(), filter(), or order_by().
# Django equivalents: Lower(), Upper(), Coalesce(), Cast(), etc.
# ============================================================

pub def func_lower(col: str) -> str:
	"""LOWER(col) — convert to lowercase.
	Usage: db.annotate("lname", "IDENTITY", db.func_lower("name"))"""
	return __db_func_lower(col)

pub def func_upper(col: str) -> str:
	"""UPPER(col) — convert to uppercase."""
	return __db_func_upper(col)

pub def func_length(col: str) -> str:
	"""LENGTH(col) / CHAR_LENGTH(col) — string length. Dialect-aware."""
	return __db_func_length(col)

pub def func_coalesce(args: str) -> str:
	"""COALESCE(a, b, ...) — return first non-NULL. Comma-separated args.
	Usage: db.func_coalesce("nickname, name, 'Anonymous'")"""
	return __db_func_coalesce(args)

pub def func_cast(col: str, cast_type: str) -> str:
	"""CAST(col AS type) — type conversion.
	Usage: db.func_cast("price", "INTEGER")"""
	return __db_func_cast(col, cast_type)

pub def func_concat(args: str) -> str:
	"""CONCAT(a, b, ...) — string concatenation. Comma-separated args.
	Works on both PG (CONCAT supported since 9.1) and MySQL."""
	return __db_func_concat(args)

pub def func_abs(col: str) -> str:
	"""ABS(col) — absolute value."""
	return __db_func_abs(col)

pub def func_greatest(args: str) -> str:
	"""GREATEST(a, b, ...) — return largest. Comma-separated args."""
	return __db_func_greatest(args)

pub def func_least(args: str) -> str:
	"""LEAST(a, b, ...) — return smallest. Comma-separated args."""
	return __db_func_least(args)

pub def func_now() -> str:
	"""NOW() — current timestamp. Works on both PG and MySQL."""
	return __db_func_now()

# ============================================================
# Case/When — conditional SQL expression builder
#
# Django equivalent: Case(When(status='urgent', then=1), default=3)
# Generates: CASE WHEN status='urgent' THEN 1 ... ELSE 3 END
# ============================================================

pub def case_when(condition: str, result: str) -> int:
	"""Add a WHEN clause to the CASE expression.
	condition: SQL boolean expression, e.g. "status = 'urgent'"
	result: value when true, e.g. "1" or "'high_priority'"
	Usage:
	  db.case_when("status = 'urgent'", "1")
	  db.case_when("status = 'high'", "2")"""
	return __db_case_when(condition, result)

pub def case_else(default_val: str) -> int:
	"""Set the ELSE (default) clause for the CASE expression.
	default_val: value when no WHEN matches, e.g. "0" or "'unknown'"
	Usage: db.case_else("3")"""
	return __db_case_else(default_val)

pub def case_end(alias: str) -> str:
	"""Finalize and return the CASE expression as a SQL string.
	alias: column alias (e.g. "priority"), or "" for no alias.
	Resets the builder for reuse.
	Usage:
	  db.case_when("age < 18", "'minor'")
	  db.case_when("age >= 18", "'adult'")
	  db.case_else("'unknown'")
	  let expr = db.case_end("age_group")
	  # expr = "CASE WHEN age < 18 THEN 'minor' WHEN age >= 18 THEN 'adult' ELSE 'unknown' END AS age_group"
	  db.annotate("age_group", "IDENTITY", expr)"""
	return __db_case_end(alias)

# ============================================================
# Model Instance Hydration + Save
#
# Django equivalents:
#   user = User.objects.get(id=1)    → hydrate
#   user.name = "Alice"              → instance_set
#   user.save()                      → instance_save
# ============================================================

pub def hydrate(table: str, row: int) -> int:
	"""Load a query result row into the model instance cache.
	After fetching rows, call this to populate the instance.
	table: the model table name (e.g. "users")
	row: row index from the query result
	Returns: field count loaded, or -1 on error.
	Usage:
	  db.objects("users")
	  db.filter("id", "1")
	  db.fetch_all()
	  db.hydrate("users", 0)
	  let name = db.instance_get("name")"""
	return __orm_hydrate(table, row)

pub def instance_get(field: str) -> str:
	"""Get a field value from the hydrated instance.
	Returns the value as a string.
	Usage: let email = db.instance_get("email")"""
	return __orm_instance_get(field)

pub def instance_set(field: str, value: str) -> int:
	"""Set a field value on the hydrated instance (in-memory only).
	Call instance_save() to persist to database.
	Usage: db.instance_set("name", "Bob")"""
	return __orm_instance_set(field, value)

pub def instance_save() -> int:
	"""Persist the hydrated instance to the database.
	If PK > 0: UPDATE the existing row.
	If PK == 0: INSERT a new row.
	Django equivalent: user.save()
	Usage:
	  db.hydrate("users", 0)
	  db.instance_set("name", "Alice")
	  db.instance_save()"""
	return __orm_save()

pub def instance_pk() -> int:
	"""Return the primary key of the hydrated instance.
	0 = new instance, >0 = existing row."""
	return __orm_instance_pk()

pub def instance_clear() -> int:
	"""Clear the instance cache, resetting all fields."""
	__orm_instance_clear()
	return 0

pub def instance_delete() -> int:
	"""Delete the current hydrated instance from the database.
	Django equivalent: user.delete()
	Fires pre_delete/post_delete signals.
	Clears instance state after successful delete."""
	return __orm_instance_delete()

pub def refresh_from_db() -> int:
	"""Re-fetch the current instance from the database.
	Django equivalent: user.refresh_from_db()
	Useful when another process may have modified the row."""
	return __orm_refresh_from_db()

pub def is_dirty() -> int:
	"""Check if any field has been modified since hydration.
	Returns 1 if dirty, 0 if clean.
	Usage:
	  db.hydrate("users", 0)
	  db.instance_set("name", "Bob")
	  if db.is_dirty() == 1:
	    db.instance_save()"""
	return __orm_is_dirty()

pub def dirty_fields() -> str:
	"""Return comma-separated list of dirty (modified) field names.
	Returns "" if no fields are dirty.
	Usage: let changed = db.dirty_fields()  # e.g. "name,email" """
	return __orm_dirty_fields()

pub def one_to_one_field(name: str, ref_table: str, ref_field: str, on_delete: str, nullable: int) -> int:
	"""Register a OneToOneField (FK with UNIQUE constraint).
	Django equivalent: OneToOneField(User, on_delete=CASCADE)
	Usage: db.one_to_one_field("profile_id", "profiles", "id", "CASCADE", 0)"""
	return __orm_one_to_one_field(name, ref_table, ref_field, on_delete, nullable)

# ============================================================
# M2M set() operation
# ============================================================

pub def m2m_set(junction: str, from_id: str, id_list: str) -> int:
	"""Replace all M2M links atomically.
	Django equivalent: article.tags.set([1, 2, 3])
	id_list: comma-separated IDs
	Usage: db.m2m_set("article_tags", "1", "3,5,7")"""
	return __orm_m2m_set(junction, from_id, id_list)

# ============================================================
# QuerySet .reverse()
# ============================================================

pub def reverse() -> int:
	"""Reverse the current ordering. Flips ASC↔DESC.
	Django equivalent: qs.reverse()
	Usage:
	  db.order_by("name")  # ASC
	  db.reverse()         # now DESC"""
	return __qs_reverse()

# ============================================================
# Additional Database Functions
# ============================================================

pub def func_substr(col: str, start: int, length: int) -> str:
	"""SUBSTR(col, start, length). PG: SUBSTR, MySQL: SUBSTRING."""
	return __db_func_substr(col, start, length)

pub def func_trim(col: str) -> str:
	"""TRIM(col) — remove leading/trailing whitespace."""
	return __db_func_trim(col)

pub def func_round(col: str, decimals: int) -> str:
	"""ROUND(col, decimals)."""
	return __db_func_round(col, decimals)

pub def func_ceil(col: str) -> str:
	"""CEIL(col) — round up to nearest integer."""
	return __db_func_ceil(col)

pub def func_floor(col: str) -> str:
	"""FLOOR(col) — round down to nearest integer."""
	return __db_func_floor(col)

pub def func_left(col: str, n: int) -> str:
	"""LEFT(col, n) — first n characters."""
	return __db_func_left(col, n)

pub def func_right(col: str, n: int) -> str:
	"""RIGHT(col, n) — last n characters."""
	return __db_func_right(col, n)

pub def func_replace(col: str, old_str: str, new_str: str) -> str:
	"""REPLACE(col, old, new) — string replacement in SQL."""
	return __db_func_replace(col, old_str, new_str)

# ============================================================
# Field Validation
#
# Django equivalent: validators=[MinLengthValidator(2)]
# Register validation constraints per (table, field),
# then validate before save.
# ============================================================

pub def add_validator(table: str, field: str, min_len: int, max_len: int, min_val: int, max_val: int) -> int:
	"""Register validation rules for a model field.
	Use 0 for unused constraints.
	Usage:
	  db.add_validator("users", "name", 2, 100, 0, 0)     # name: 2-100 chars
	  db.add_validator("users", "age", 0, 0, 0, 150)      # age: 0-150"""
	return __orm_add_validator(table, field, min_len, max_len, min_val, max_val)

pub def validate_instance() -> str:
	"""Validate all fields of the hydrated instance.
	Returns empty string on success, error message on failure.
	Usage:
	  db.hydrate("users", 0)
	  db.instance_set("name", "")
	  let err = db.validate_instance()
	  if err != "":
	    print("Validation error: " + err)"""
	return __orm_validate_instance_str()

pub def fire_signal(table: str, signal_type: int) -> int:
	"""Fire a signal for a table.
	signal_type: 0=pre_save, 1=post_save, 2=pre_delete, 3=post_delete
	Returns 0 on success, -1 if a handler vetoes.
	Usage: db.fire_signal("users", 0)  # pre_save"""
	return __orm_fire_signal(table, signal_type)

# ============================================================
# Many-to-Many Relationships
#
# Django equivalent:
#   class Article(models.Model):
#       tags = models.ManyToManyField(Tag)
# ============================================================

pub def m2m(from_table: str, to_table: str, junction: str) -> int:
	"""Register a many-to-many relationship.
	from_table: source model (e.g. "articles")
	to_table: target model (e.g. "tags")
	junction: junction table name, or "" for auto (e.g. "articles_tags")
	Usage: db.m2m("articles", "tags", "article_tags")"""
	return __orm_m2m(from_table, to_table, junction)

pub def m2m_create_sql(junction: str) -> str:
	"""Generate CREATE TABLE SQL for a junction table.
	Usage: let sql = db.m2m_create_sql("article_tags")"""
	return __orm_m2m_create_sql(junction)

pub def m2m_add(junction: str, from_id: str, to_id: str) -> int:
	"""Add a many-to-many link. Idempotent (uses ON CONFLICT/INSERT IGNORE).
	Usage: db.m2m_add("article_tags", "1", "5")"""
	return __orm_m2m_add(junction, from_id, to_id)

pub def m2m_remove(junction: str, from_id: str, to_id: str) -> int:
	"""Remove a many-to-many link.
	Usage: db.m2m_remove("article_tags", "1", "5")"""
	return __orm_m2m_remove(junction, from_id, to_id)

pub def m2m_clear(junction: str, from_id: str) -> int:
	"""Remove all links for a source ID.
	Usage: db.m2m_clear("article_tags", "1")"""
	return __orm_m2m_clear(junction, from_id)

pub def m2m_all(junction: str, from_id: str) -> int:
	"""Query all related IDs for a source ID.
	Results available via db.get_field() after this call.
	Usage: db.m2m_all("article_tags", "1")"""
	return __orm_m2m_all(junction, from_id)

pub def m2m_create_all_sql() -> str:
	"""Generate CREATE TABLE SQL for all registered M2M junction tables.
	Returns semicolon-separated SQL statements."""
	return __orm_create_all_m2m_sql()

# ============================================================
# Abstract Model Inheritance
#
# Django equivalent:
#   class TimestampMixin(models.Model):
#       created_at = DateTimeField(auto_now_add=True)
#       class Meta: abstract = True
# ============================================================

pub def set_abstract(table: str) -> int:
	"""Mark a model as abstract (won't generate a table).
	Usage: db.set_abstract("timestamp_mixin")"""
	return __orm_set_abstract(table)

pub def is_abstract(table: str) -> int:
	"""Check if a model is abstract. Returns 1 if abstract, 0 otherwise."""
	return __orm_is_abstract(table)

pub def inherit(child: str, parent: str) -> int:
	"""Copy fields from parent model into child model.
	Django equivalent: class Child(Parent)
	Usage:
	  db.set_abstract("timestamp_mixin")
	  db.inherit("articles", "timestamp_mixin")"""
	return __orm_inherit(child, parent)

# ============================================================
# get_or_create
# ============================================================

pub def get_or_create() -> int:
	"""Get existing row or create it. Returns 1 if created, 0 if found.
	Django equivalent: obj, created = Entry.objects.get_or_create(name="Alice")
	Use set_field() to accumulate fields before calling.
	Usage:
	  db.objects("users")
	  db.set_field("name", "Alice")
	  db.set_field("email", "alice@example.com")
	  let created = db.get_or_create()"""
	return __qs_get_or_create()

# ============================================================
# EXPLAIN (query plan inspection)
# ============================================================

pub def explain() -> int:
	"""Run EXPLAIN ANALYZE on the current queryset.
	PG: EXPLAIN ANALYZE, MySQL: EXPLAIN.
	Returns row count; result set contains the query plan.
	Django equivalent: queryset.explain()
	Usage: db.objects("users"); db.filter_by("age__gt", "18"); db.explain()"""
	return __qs_explain()

# ============================================================
# Schema Inspection
# ============================================================

pub def describe_tables() -> int:
	"""List all tables in the current database.
	Returns row count; result set has table_name column.
	Usage: let n = db.describe_tables()  # then db.get_value(i, 0)"""
	return __db_describe_tables()

pub def describe_columns(table_name: str) -> int:
	"""List columns for a table with type info.
	Returns row count; result set has: column_name, data_type, is_nullable, column_default.
	Usage: let n = db.describe_columns("users")"""
	return __db_describe_columns(table_name)

pub def describe_indexes(table_name: str) -> int:
	"""List indexes for a table.
	PG: returns indexname, indexdef from pg_indexes.
	MySQL: runs SHOW INDEX FROM table.
	Usage: let n = db.describe_indexes("users")"""
	return __db_describe_indexes(table_name)

# ============================================================
# Advisory Locks (distributed locking)
# ============================================================

pub def advisory_lock(key: int) -> int:
	"""Acquire a session-level advisory lock (blocking).
	PG: pg_advisory_lock(key), MySQL: GET_LOCK(key, -1).
	Returns 0 on success, -1 on error.
	Usage: db.advisory_lock(42)"""
	return __db_advisory_lock(key)

pub def advisory_unlock(key: int) -> int:
	"""Release a session-level advisory lock.
	PG: pg_advisory_unlock(key), MySQL: RELEASE_LOCK(key).
	Returns 0 on success, -1 on error.
	Usage: db.advisory_unlock(42)"""
	return __db_advisory_unlock(key)

pub def advisory_try_lock(key: int) -> int:
	"""Try to acquire an advisory lock (non-blocking).
	Returns 1 if acquired, 0 if already held by another session.
	PG: pg_try_advisory_lock(key), MySQL: GET_LOCK(key, 0).
	Usage: if db.advisory_try_lock(42) == 1: ..."""
	return __db_advisory_try_lock(key)

# ============================================================
# UPSERT (ON CONFLICT)
# ============================================================

pub def on_conflict(col: str) -> int:
	"""Set the conflict column for upsert operations.
	Must be called before do_upsert().
	Django equivalent: Model.objects.update_or_create(defaults={...}, pk=1)
	Usage:
	  db.objects("users")
	  db.on_conflict("email")
	  db.set_field("name", "Alice")
	  db.set_field("email", "alice@example.com")
	  db.do_upsert()"""
	return __qs_on_conflict(col)

pub def do_upsert() -> int:
	"""Execute an INSERT ... ON CONFLICT DO UPDATE (PG) / INSERT ... ON DUPLICATE KEY UPDATE (MySQL).
	Must call on_conflict() and set_field() first.
	Returns affected row count, or -1 on error.
	Usage: db.objects("users"); db.on_conflict("email"); db.set_field("name","Ali"); db.do_upsert()"""
	return __qs_do_upsert()

# ============================================================
# update_or_create
# ============================================================

pub def update_or_create() -> int:
	"""Get existing row and update it, or create a new one.
	Django equivalent: obj, created = Model.objects.update_or_create(defaults={"email":"new"}, name="Alice")
	Use filter() for lookup and set_field() for all values before calling.
	Returns: 1 if created, 0 if updated, -1 on error.
	Usage:
	  db.objects("users")
	  db.filter("name", "=", "Alice")
	  db.set_field("name", "Alice")
	  db.set_field("email", "alice@new.com")
	  let result = db.update_or_create()"""
	return __qs_update_or_create()

# ============================================================
# Window Functions
# ============================================================

pub def window(func: str, over_clause: str, alias: str) -> int:
	"""Add a window function to the SELECT clause.
	Django equivalent: Window(expression=RowNumber(), partition_by=[F('dept')], order_by=F('salary').desc())
	Generates: func OVER (over_clause) AS alias
	Usage:
	  db.objects("employees")
	  db.window("ROW_NUMBER()", "PARTITION BY dept ORDER BY salary DESC", "row_num")
	  db.fetch_all()"""
	return __qs_window(func, over_clause, alias)

# ============================================================
# Server-Side Cursor
# ============================================================

pub def cursor_declare(name: str) -> int:
	"""Declare a server-side cursor for the current queryset.
	PG: DECLARE name CURSOR FOR SELECT ...
	MySQL: uses LIMIT/OFFSET pagination internally.
	Must be inside a transaction (PG requirement).
	Usage:
	  db.begin()
	  db.objects("logs")
	  db.cursor_declare("log_cursor")
	  while db.cursor_fetch(100) > 0:
	    # process batch
	    pass
	  db.cursor_close()
	  db.commit()"""
	return __qs_cursor_declare(name)

pub def cursor_fetch(batch_size: int) -> int:
	"""Fetch next batch of rows from a declared cursor.
	PG: FETCH n FROM cursor_name
	MySQL: re-executes with LIMIT n OFFSET (auto-incremented)
	Returns row count (0 when no more rows).
	Usage: let rows = db.cursor_fetch(100)"""
	return __qs_cursor_fetch(batch_size)

pub def cursor_close() -> int:
	"""Close an open cursor and release resources.
	PG: CLOSE cursor_name
	MySQL: resets internal offset.
	Usage: db.cursor_close()"""
	return __qs_cursor_close()

# ============================================================
# JSON field helpers
# ============================================================

pub def json_set(col: str, key: str, val: str) -> int:
	"""Set a JSON field value.
	PG: jsonb_set(col, '{key}', '"val"')
	MySQL: JSON_SET(col, '$.key', 'val')
	Usage: db.objects("users"); db.json_set("settings", "theme", "dark")"""
	return __qs_json_set(col, key, val)

pub def json_get(col: str, key: str) -> str:
	"""Extract a value from a JSON field.
	PG: col->>'key'
	MySQL: JSON_UNQUOTE(JSON_EXTRACT(col, '$.key'))
	Usage: let theme = db.json_get("settings", "theme")"""
	return __qs_json_get(col, key)

# ============================================================
# CTEs (Common Table Expressions)
# ============================================================

pub def cte(name: str, query: str) -> int:
	"""Add a Common Table Expression (WITH clause).
	Up to 4 CTEs can be chained. Then call cte_fetch() to execute.
	Django equivalent: raw SQL with WITH clause.
	Usage:
	  db.objects("active_users")
	  db.cte("active_users", "SELECT * FROM users WHERE is_active = true")
	  db.cte_fetch()"""
	return __qs_cte_add(name, query)

pub def cte_recursive() -> int:
	"""Set the CTE mode to WITH RECURSIVE for hierarchical queries.
	Must call before cte_fetch().
	Usage:
	  db.cte("tree", "SELECT id, parent_id, name FROM categories WHERE parent_id IS NULL UNION ALL SELECT c.id, c.parent_id, c.name FROM categories c JOIN tree t ON c.parent_id = t.id")
	  db.cte_recursive()
	  db.objects("tree")
	  db.cte_fetch()"""
	return __qs_cte_recursive()

pub def cte_fetch() -> int:
	"""Execute a CTE query and return results.
	Builds: WITH name AS (query) [, ...] SELECT * FROM table [WHERE ...] [ORDER BY ...]
	Returns row count.
	Usage: let rows = db.cte_fetch()"""
	return __qs_cte_fetch()

# ============================================================
# Subqueries
# ============================================================

pub def subquery(table: str, cols: str, where_clause: str) -> str:
	"""Build a subquery SQL string for use with filter_exists/filter_in_subquery.
	Returns the SQL string (not executed).
	Usage:
	  let sub = db.subquery("orders", "1", "orders.user_id = users.id")
	  db.filter_exists(sub)"""
	return __qs_subquery_build(table, cols, where_clause)

pub def filter_exists(subquery: str) -> int:
	"""Add WHERE EXISTS (subquery) condition.
	Django equivalent: Entry.objects.filter(Exists(Subquery(...)))
	Usage:
	  db.objects("users")
	  db.filter_exists(db.subquery("orders", "1", "orders.user_id = users.id"))
	  db.fetch_all()"""
	return __qs_filter_exists(subquery)

pub def filter_not_exists(subquery: str) -> int:
	"""Add WHERE NOT EXISTS (subquery) condition.
	Usage:
	  db.objects("users")
	  db.filter_not_exists(db.subquery("orders", "1", "orders.user_id = users.id"))
	  db.fetch_all()"""
	return __qs_filter_not_exists(subquery)

pub def filter_in_subquery(col: str, subquery: str) -> int:
	"""Add WHERE col IN (subquery) condition.
	Django equivalent: Entry.objects.filter(pk__in=Subquery(...))
	Usage:
	  db.objects("users")
	  db.filter_in_subquery("id", db.subquery("orders", "user_id", "total > 100"))
	  db.fetch_all()"""
	return __qs_filter_in_subquery(col, subquery)

pub def filter_not_in_subquery(col: str, subquery: str) -> int:
	"""Add WHERE col NOT IN (subquery) condition.
	Usage:
	  db.objects("users")
	  db.filter_not_in_subquery("id", db.subquery("banned_users", "user_id", ""))
	  db.fetch_all()"""
	return __qs_filter_not_in_subquery(col, subquery)

# ============================================================
# prefetch_related
# ============================================================

pub def prefetch_related(related_table: str, fk_col: str, pk_col: str) -> int:
	"""Register a related table for batch prefetching (N+1 → N optimization).
	Django equivalent: Entry.objects.prefetch_related('authors')
	Automatically batch-queries the related table with WHERE fk_col IN (primary keys).
	Usage:
	  db.objects("posts")
	  db.prefetch_related("comments", "post_id", "id")
	  db.prefetch_execute()"""
	return __qs_prefetch_add(related_table, fk_col, pk_col)

pub def prefetch_execute() -> int:
	"""Execute the main query + all registered prefetch queries.
	Returns: main query row count.
	Usage: let rows = db.prefetch_execute()"""
	return __qs_prefetch_execute()

# ============================================================
# JSON_TABLE — extract relational data from JSON
# ============================================================

pub def json_table(json_col: str, json_path: str, columns_def: str, alias: str) -> int:
	"""Transform a JSON column into relational rows using JSON_TABLE.
	PG 17: json_table(col, '$.path' COLUMNS (...))
	MySQL 8: JSON_TABLE(col, '$.path' COLUMNS (...))
	
	Parameters:
	  json_col: the JSON column name
	  json_path: the JSON path expression (e.g., '$.items[*]')
	  columns_def: column definitions (e.g., "name TEXT PATH '$.name', qty INT PATH '$.qty'")
	  alias: table alias for the result
	
	Usage:
	  db.objects("orders")
	  let rows = db.json_table("data", "$.items[*]",
	    "name TEXT PATH '$.name', qty INT PATH '$.qty'", "jt")"""
	return __qs_json_table(json_col, json_path, columns_def, alias)

# ============================================================
# Full-Text Search
# ============================================================

pub def fts_filter(col: str, query: str, config: str) -> int:
	"""Add a full-text search filter to the WHERE clause.
	PG: to_tsvector(config, col) @@ to_tsquery(config, query)
	MySQL: MATCH(col) AGAINST (query IN BOOLEAN MODE)
	
	Parameters:
	  col: column to search
	  query: search terms (PG tsquery syntax or MySQL boolean syntax)
	  config: language config (PG: 'english', 'simple', etc.; MySQL: ignored)
	
	Usage:
	  db.objects("articles")
	  db.fts_filter("body", "machine & learning", "english")
	  db.fetch_all()"""
	return __qs_fts_filter(col, query, config)

pub def fts_rank(col: str, query: str, config: str, alias: str) -> int:
	"""Add a full-text search relevance ranking column to SELECT.
	PG: ts_rank(to_tsvector(config, col), to_tsquery(config, query)) AS alias
	MySQL: MATCH(col) AGAINST (query) AS alias
	
	Combine with fts_filter() + order_by() for ranked search results.
	
	Usage:
	  db.objects("articles")
	  db.fts_filter("body", "deep learning", "english")
	  db.fts_rank("body", "deep learning", "english", "relevance")
	  db.order_by("-relevance")
	  db.fetch_all()"""
	return __qs_fts_rank(col, query, config, alias)

pub def fts_create_index(table: str, col: str, idx_name: str, config: str) -> int:
	"""Create a full-text search index on a column.
	PG: CREATE INDEX idx ON table USING gin(to_tsvector(config, col))
	MySQL: ALTER TABLE table ADD FULLTEXT INDEX idx(col)
	
	Usage:
	  db.fts_create_index("articles", "body", "idx_articles_body_fts", "english")"""
	return __qs_fts_create_index(table, col, idx_name, config)

# ============================================================
# Vector Similarity Search
# ============================================================

pub def vector_search(col: str, vector_str: str, metric: str, k: int) -> int:
	"""Configure nearest-neighbor vector similarity search.
	PG (pgvector): ORDER BY embedding <=> '[0.1,0.2,...]' LIMIT k
	MySQL 9 (VECTOR): ORDER BY DISTANCE(embedding, TO_VECTOR('[...]'), 'COSINE') LIMIT k
	
	Parameters:
	  col: vector column name
	  vector_str: query vector as string "[0.1, 0.2, 0.3, ...]"
	  metric: distance metric — "cosine" | "l2" | "ip" (inner product)
	  k: number of nearest neighbors to return
	
	Sets ORDER BY distance + LIMIT k. Call fetch_all() after.
	
	Usage:
	  db.objects("documents")
	  db.vector_search("embedding", "[0.1, 0.2, 0.3]", "cosine", 10)
	  db.fetch_all()  # returns 10 most similar documents"""
	return __qs_vector_search(col, vector_str, metric, k)

pub def vector_create_index(table: str, col: str, idx_name: str, metric: str) -> int:
	"""Create a vector similarity index.
	PG (pgvector): CREATE INDEX idx ON table USING hnsw (col vector_cosine_ops)
	MySQL 9: ALTER TABLE table ADD VECTOR INDEX idx(col) DISTANCE = 'COSINE'
	
	Parameters:
	  metric: "cosine" | "l2" | "ip" (determines operator class)
	
	Usage:
	  db.vector_create_index("documents", "embedding", "idx_docs_embedding", "cosine")"""
	return __qs_vector_create_index(table, col, idx_name, metric)

# ============================================================
# HAVING clause
# ============================================================

pub def having(condition: str) -> int:
	"""Add a HAVING condition for aggregate filtering.
	Use after group_by() + annotate() to filter grouped results.
	Appends raw SQL condition (no parameterization — use having_val for user input).
	Django equivalent: .annotate(total=Sum("amount")).filter(total__gt=100)
	Usage:
	  db.objects("orders")
	  db.group_by("customer_id")
	  db.annotate("total", "SUM", "amount")
	  db.having("SUM(amount) > 100")
	  db.fetch_all()"""
	return __qs_having(condition)

pub def having_val(expr: str, val: str) -> int:
	"""Add a parameterized HAVING condition.
	The value is bound as a SQL parameter ($N or ?) to prevent injection.
	Usage:
	  db.objects("orders")
	  db.group_by("customer_id")
	  db.annotate("order_count", "COUNT", "*")
	  db.having_val("COUNT(*) >", "5")
	  db.fetch_all()"""
	return __qs_having_val(expr, val)

# ============================================================
# Multi-column ORDER BY
# ============================================================

pub def order_by_add(col: str) -> int:
	"""Append an ORDER BY column (multi-column ordering).
	Unlike sort_by() which overwrites, this appends to existing ordering.
	Use '-col' for DESC, 'col' for ASC.
	Usage:
	  db.objects("employees")
	  db.order_by_add("-salary")  # primary: salary DESC
	  db.order_by_add("name")     # secondary: name ASC
	  db.fetch_all()  # ORDER BY salary DESC, name ASC"""
	return __qs_order_by_add(col)

# ============================================================
# Multi-column UPDATE
# ============================================================

pub def update_set(col: str, val: str) -> int:
	"""Accumulate a column=value pair for multi-column update.
	Call multiple times to set multiple fields, then execute with update_exec().
	All values are parameterized for security.
	Usage:
	  db.objects("users")
	  db.filter_by("id", "1")
	  db.update_set("name", "Alice")
	  db.update_set("email", "alice@example.com")
	  db.update_exec()  # UPDATE users SET name=$1, email=$2 WHERE id=$3"""
	return __qs_update_set(col, val)

pub def update_exec() -> int:
	"""Execute a multi-column UPDATE with all fields set via update_set().
	Generates a single UPDATE statement with all accumulated columns.
	Returns affected row count.
	Django equivalent: queryset.update(name="Alice", email="alice@example.com")"""
	return __qs_update_multi()

# ============================================================
# Pagination Helpers
# ============================================================

pub def paginate(page: int, page_size: int) -> int:
	"""Set pagination: page (1-based) + page_size → LIMIT/OFFSET.
	paginate(1, 25) → LIMIT 25 OFFSET 0
	paginate(3, 10) → LIMIT 10 OFFSET 20
	Django equivalent: Paginator(queryset, page_size).page(page)
	Usage:
	  db.objects("products")
	  db.paginate(2, 25)  # page 2, 25 per page
	  db.fetch_all()"""
	return __qs_paginate(page, page_size)

pub def total_count() -> int:
	"""Get total row count ignoring LIMIT/OFFSET (for pagination metadata).
	Use after filter() but before/after paginate().
	Returns the total matching rows across all pages.
	Usage:
	  db.objects("products")
	  db.filter_by("category", "electronics")
	  let total = db.total_count()  # total matching rows
	  db.paginate(1, 25)
	  db.fetch_all()  # first page of results"""
	return __qs_total_count()

# ============================================================
# Soft Delete
# ============================================================

pub def soft_delete_mode(col_name: str) -> int:
	"""Enable soft-delete mode for the current queryset.
	When enabled:
	  - SELECT/COUNT auto-filter: WHERE is_deleted = FALSE
	  - soft_delete() marks rows instead of removing them
	col_name: the boolean column name (default: 'is_deleted')
	Usage:
	  db.objects("users")
	  db.soft_delete_mode("is_deleted")
	  db.fetch_all()  # automatically excludes deleted rows"""
	return __qs_soft_delete_mode(col_name)

pub def with_deleted() -> int:
	"""Include soft-deleted rows in queries (bypass auto-filter).
	Must call soft_delete_mode() first.
	Django equivalent: Model.all_objects.all()
	Usage:
	  db.objects("users")
	  db.soft_delete_mode("is_deleted")
	  db.with_deleted()
	  db.fetch_all()  # includes deleted rows"""
	return __qs_with_deleted()

pub def soft_delete() -> int:
	"""Soft-delete matching rows (UPDATE SET is_deleted = TRUE).
	Falls back to real DELETE if soft_delete_mode() was not called.
	Usage:
	  db.objects("users")
	  db.soft_delete_mode("is_deleted")
	  db.filter_by("id", "42")
	  db.soft_delete()  # marks as deleted, doesn't remove"""
	return __qs_do_soft_delete()

pub def hard_delete() -> int:
	"""Permanently delete matching rows (real DELETE FROM).
	Ignores soft-delete mode — always performs actual deletion.
	Usage:
	  db.objects("users")
	  db.filter_by("id", "42")
	  db.hard_delete()  # DELETE FROM users WHERE ..."""
	return __qs_hard_delete()

pub def restore() -> int:
	"""Restore soft-deleted rows (UPDATE SET is_deleted = FALSE).
	Must be in soft_delete_mode(). Use with_deleted() + filter to target deleted rows.
	Returns -1 if not in soft-delete mode.
	Usage:
	  db.objects("users")
	  db.soft_delete_mode("is_deleted")
	  db.with_deleted()
	  db.filter_by("id", "42")
	  db.restore()  # brings back the soft-deleted row"""
	return __qs_restore()

pub def get_avg(col: str) -> str:
	"""SELECT AVG(col) — returns string."""
	return __qs_aggregate("AVG", col)

pub def get_sum(col: str) -> str:
	"""SELECT SUM(col) — returns string."""
	return __qs_aggregate("SUM", col)

pub def get_min(col: str) -> str:
	"""SELECT MIN(col) — returns string."""
	return __qs_aggregate("MIN", col)

pub def get_max(col: str) -> str:
	"""SELECT MAX(col) — returns string."""
	return __qs_aggregate("MAX", col)

pub def get_by_id(id_val: int) -> int:
	"""Get single row by id. Call db.objects(table) first."""
	return __qs_get_by_id(id_val)

pub def set(key: str, val: str) -> int:
	"""Set a field for INSERT. Call db.objects(table) first, then set fields, then do_insert()."""
	return __qs_set_field(key, val)

pub def do_insert() -> int:
	"""Execute INSERT with all fields set via db.set(). Supports up to 32 fields."""
	return __qs_do_insert()

pub def create(**fields: str) -> int:
	"""Django-style INSERT. Call db.objects(table) first.
	Usage: db.objects("users"); db.create(name="Alice", age="30")"""
	for key, value in fields.items():
		__qs_set_field(key, value)
	return __qs_do_insert()

# ============================================================
# Public API — Values (dict/list access to results)
# ============================================================

pub def values(row: int) -> str:
	"""Get a row as a JSON-like dict string: {"col": "val", ...}.
	Call after fetch_all(). Django equivalent: .values()"""
	return __qs_values(row)

pub def values_list(row: int) -> str:
	"""Get a row as comma-separated values.
	Call after fetch_all(). Django equivalent: .values_list()"""
	return __qs_values_list(row)

pub def values_flat(row: int, col_name: str) -> str:
	"""Get a single column value from a row.
	Django equivalent: .values_list('name', flat=True)"""
	return __qs_values_flat(row, col_name)

# ============================================================
# Public API — Bulk Insert
# ============================================================

pub def bulk_begin(ncols: int) -> int:
	"""Start a bulk INSERT. Specify expected number of columns.
	Usage: db.objects("users"); db.bulk_begin(3)"""
	return __qs_bulk_begin(ncols)

pub def bulk_col(col_name: str) -> int:
	"""Add a column name for bulk INSERT."""
	return __qs_bulk_col(col_name)

pub def bulk_row_csv(csv_values: str) -> int:
	"""Add a row as comma-separated values for bulk INSERT."""
	return __qs_bulk_row_csv(csv_values)

pub def bulk_row1(v1: str) -> int:
	"""Add a single-column row for bulk INSERT."""
	return __qs_bulk_row1(v1)

pub def bulk_row2(v1: str, v2: str) -> int:
	"""Add a 2-column row for bulk INSERT."""
	return __qs_bulk_row2(v1, v2)

pub def bulk_row3(v1: str, v2: str, v3: str) -> int:
	"""Add a 3-column row for bulk INSERT."""
	return __qs_bulk_row3(v1, v2, v3)

pub def bulk_row4(v1: str, v2: str, v3: str, v4: str) -> int:
	"""Add a 4-column row for bulk INSERT."""
	return __qs_bulk_row4(v1, v2, v3, v4)

pub def bulk_row5(v1: str, v2: str, v3: str, v4: str, v5: str) -> int:
	"""Add a 5-column row for bulk INSERT."""
	return __qs_bulk_row5(v1, v2, v3, v4, v5)

pub def bulk_execute() -> int:
	"""Execute the bulk INSERT. Returns affected row count.
	Django equivalent: Model.objects.bulk_create([...])"""
	return __qs_bulk_execute()

