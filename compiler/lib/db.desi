# db module — Database ORM and Query Builder
#
# Django-inspired ORM with SQL query builder.
# Supports PostgreSQL and MySQL with shared API.
#
# Usage:
#   import db
#
#   # Define model
#   db.model("users")
#   db.auto_field("id")
#   db.char_field("name", 100, 0, 0)
#   db.int_field("age", 0, 0)
#
#   # Query builder
#   db.select("users")
#   db.where("age", ">", "21")
#   let sql = db.build_sql()

# --- Query Builder C bindings ---

@extern("C")
pub def __db_set_dialect(dialect: int) -> int

@extern("C")
pub def __db_set_debug_queries(enabled: int) -> int

@extern("C")
pub def __crud_set_dialect(dialect: int) -> int

@extern("C")
pub def __db_select(table: str) -> int

@extern("C")
pub def __db_insert_into(table: str) -> int

@extern("C")
pub def __db_update_table(table: str) -> int

@extern("C")
pub def __db_delete_from(table: str) -> int

@extern("C")
pub def __db_columns(col: str) -> int

@extern("C")
pub def __db_where(column: str, op: str, value: str) -> int

@extern("C")
pub def __db_set(column: str, value: str) -> int

@extern("C")
pub def __db_join(join_type: str, table: str, on_clause: str) -> int

@extern("C")
pub def __db_order_by(column: str, desc: int) -> int

@extern("C")
pub def __db_limit(n: int) -> int

@extern("C")
pub def __db_offset(n: int) -> int

@extern("C")
pub def __db_returning() -> int

@extern("C")
pub def __db_build_sql() -> str

