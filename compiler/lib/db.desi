@extern("C")
pub def __qs_set_field(key: str, val: str) -> int

@extern("C")
pub def __qs_do_insert() -> int

# ============================================================
# Public ORM API — Django-style QuerySet
#
# Usage:
#   db.objects("users")             # set active table
#   db.filter("age__gt", "21")     # add WHERE
#   db.order_by("-name")           # add ORDER BY
#   let n = db.all()               # execute SELECT, returns row count
#   let c = db.count()             # SELECT COUNT(*)
# ============================================================

pub def objects(table: str) -> int:
	"""Set active table for ORM queries (like Django's Model.objects)."""
	return __qs_reset(table)

pub def filter_by(lookup: str, val: str) -> int:
	"""Add WHERE condition. Supports Django lookups: age__lt, name__contains, etc."""
	return __qs_filter(lookup, val)

pub def exclude(lookup: str, val: str) -> int:
	"""Add WHERE NOT condition."""
	return __qs_exclude(lookup, val)

pub def sort_by(col: str) -> int:
	"""Order results. Use '-name' for DESC (like Django's .order_by())."""
	return __qs_order_by(col)

pub def set_limit(n: int) -> int:
	"""Limit result count for ORM queryset."""
	return __qs_limit(n)

pub def set_offset(n: int) -> int:
	"""Offset results for ORM queryset (for pagination)."""
	return __qs_offset(n)

pub def select_related(field_name: str) -> int:
	"""Eagerly load a FK-related object via LEFT JOIN (like Django's select_related).
	Call after db.objects(). Related fields accessible as 'fk_field__column'.
	Usage: db.objects("posts"); db.select_related("author_id"); db.fetch_all()"""
	return __qs_select_related(field_name)

pub def annotate(alias: str, func: str, col: str) -> int:
	"""Add an aggregate annotation to the query.
	func: SUM, COUNT, AVG, MIN, MAX
	Usage: db.objects("orders"); db.annotate("total", "SUM", "amount")
	Django equivalent: .annotate(total=Sum("amount"))"""
	return __qs_annotate(alias, func, col)

pub def group_by(cols: str) -> int:
	"""Set GROUP BY columns (comma-separated).
	Usage: db.objects("orders"); db.group_by("customer_id")
	Often used with annotate() for grouped aggregations."""
	return __qs_group_by(cols)

pub def raw(sql: str) -> int:
	"""Execute raw SQL query directly.
	For SELECT: populates result set, returns row count.
	For DML (INSERT/UPDATE/DELETE): returns affected rows.
	Usage: db.raw("SELECT * FROM users WHERE age > 21")
	Django equivalent: Model.objects.raw("SELECT ...")"""
	return __qs_raw(sql)

pub def fetch_all() -> int:
	"""Execute SELECT and return row count (like Django's .all())."""
	return __qs_fetch()

pub def rows() -> int:
	"""Row count from last query."""
	return __qs_row_count()

pub def count() -> int:
	"""Return COUNT(*) for current queryset (like Django's QuerySet.count())."""
	return __qs_count()

pub def exists() -> int:
	"""Check if any rows match. Returns 1 or 0 (like Django's QuerySet.exists())."""
	return __qs_exists()

pub def update(col: str, val: str) -> int:
	"""UPDATE single column for matching rows."""
	return __qs_update(col, val)

pub def filter(**lookups: str) -> int:
	"""Django-style kwargs WHERE. Call db.objects(table) first.
	Usage: db.filter(name="Alice", age__gt="21")"""
	for lookup, val in lookups.items():
		__qs_filter(lookup, val)
	0

pub def update_fields(**fields: str) -> int:
	"""Django-style kwargs UPDATE. Call db.objects(table) + db.filter() first.
	Usage: db.update_fields(email="new@test.com", age="31")"""
	for col, val in fields.items():
		__qs_update(col, val)
	0

pub def get(**filters: str) -> int:
	"""Get single row matching filters. Returns row count (0 or 1).
	Usage: db.objects("users"); db.get(name="Alice")"""
	for lookup, val in filters.items():
		__qs_filter(lookup, val)
	__qs_limit(1)
	return __qs_fetch()

pub def delete() -> int:
	"""DELETE matching rows (like Django's QuerySet.delete())."""
	return __qs_delete()

# ============================================================
# Phase 1: latest / earliest
# ============================================================

pub def latest(field: str) -> int:
	"""Get the most recent row ordered by the given field.
	Django equivalent: Entry.objects.latest('pub_date')
	If field is empty, defaults to 'id'.
	Usage: db.objects("entries"); db.latest("pub_date")"""
	return __qs_latest(field)

pub def earliest(field: str) -> int:
	"""Get the oldest row ordered by the given field.
	Django equivalent: Entry.objects.earliest('pub_date')
	If field is empty, defaults to 'id'.
	Usage: db.objects("entries"); db.earliest("created_at")"""
	return __qs_earliest(field)

# ============================================================
# Phase 1: only / defer (column selection)
# ============================================================

pub def only(cols: str) -> int:
	"""Restrict SELECT to specific columns only. Comma-separated.
	Django equivalent: Entry.objects.only('id', 'name', 'email')
	Usage: db.objects("users"); db.only("id, name, email"); db.fetch_all()"""
	return __qs_only(cols)

pub def defer_fields(cols: str) -> int:
	"""Select all columns EXCEPT the listed ones. Comma-separated.
	Django equivalent: Entry.objects.defer('body', 'metadata')
	Queries the live schema to build the exclusion list.
	Usage: db.objects("posts"); db.defer_fields("body, metadata"); db.fetch_all()"""
	return __qs_defer(cols)

# ============================================================
# Phase 1: get_or_create
# ============================================================

pub def get_or_create() -> int:
	"""Get existing row or create it. Returns 1 if created, 0 if found.
	Django equivalent: obj, created = Entry.objects.get_or_create(name="Alice")
	Use set_field() to accumulate fields before calling.
	Usage:
	  db.objects("users")
	  db.set_field("name", "Alice")
	  db.set_field("email", "alice@example.com")
	  let created = db.get_or_create()"""
	return __qs_get_or_create()

# ============================================================
# Phase 1: EXPLAIN (query plan inspection)
# ============================================================

pub def explain() -> int:
	"""Run EXPLAIN ANALYZE on the current queryset.
	PG: EXPLAIN ANALYZE, MySQL: EXPLAIN.
	Returns row count; result set contains the query plan.
	Django equivalent: queryset.explain()
	Usage: db.objects("users"); db.filter_by("age__gt", "18"); db.explain()"""
	return __qs_explain()

# ============================================================
# Phase 1: Schema Inspection
# ============================================================

pub def describe_tables() -> int:
	"""List all tables in the current database.
	Returns row count; result set has table_name column.
	Usage: let n = db.describe_tables()  # then db.get_value(i, 0)"""
	return __db_describe_tables()

pub def describe_columns(table_name: str) -> int:
	"""List columns for a table with type info.
	Returns row count; result set has: column_name, data_type, is_nullable, column_default.
	Usage: let n = db.describe_columns("users")"""
	return __db_describe_columns(table_name)

pub def describe_indexes(table_name: str) -> int:
	"""List indexes for a table.
	PG: returns indexname, indexdef from pg_indexes.
	MySQL: runs SHOW INDEX FROM table.
	Usage: let n = db.describe_indexes("users")"""
	return __db_describe_indexes(table_name)

# ============================================================
# Phase 1: Advisory Locks (distributed locking)
# ============================================================

pub def advisory_lock(key: int) -> int:
	"""Acquire a session-level advisory lock (blocking).
	PG: pg_advisory_lock(key), MySQL: GET_LOCK(key, -1).
	Returns 0 on success, -1 on error.
	Usage: db.advisory_lock(42)"""
	return __db_advisory_lock(key)

pub def advisory_unlock(key: int) -> int:
	"""Release a session-level advisory lock.
	PG: pg_advisory_unlock(key), MySQL: RELEASE_LOCK(key).
	Returns 0 on success, -1 on error.
	Usage: db.advisory_unlock(42)"""
	return __db_advisory_unlock(key)

pub def advisory_try_lock(key: int) -> int:
	"""Try to acquire an advisory lock (non-blocking).
	Returns 1 if acquired, 0 if already held by another session.
	PG: pg_try_advisory_lock(key), MySQL: GET_LOCK(key, 0).
	Usage: if db.advisory_try_lock(42) == 1: ..."""
	return __db_advisory_try_lock(key)

# ============================================================
# Phase 2: UPSERT (ON CONFLICT)
# ============================================================

pub def on_conflict(col: str) -> int:
	"""Set the conflict column for upsert operations.
	Must be called before do_upsert().
	Django equivalent: Model.objects.update_or_create(defaults={...}, pk=1)
	Usage:
	  db.objects("users")
	  db.on_conflict("email")
	  db.set_field("name", "Alice")
	  db.set_field("email", "alice@example.com")
	  db.do_upsert()"""
	return __qs_on_conflict(col)

pub def do_upsert() -> int:
	"""Execute an INSERT ... ON CONFLICT DO UPDATE (PG) / INSERT ... ON DUPLICATE KEY UPDATE (MySQL).
	Must call on_conflict() and set_field() first.
	Returns affected row count, or -1 on error.
	Usage: db.objects("users"); db.on_conflict("email"); db.set_field("name","Ali"); db.do_upsert()"""
	return __qs_do_upsert()

# ============================================================
# Phase 2: update_or_create
# ============================================================

pub def update_or_create() -> int:
	"""Get existing row and update it, or create a new one.
	Django equivalent: obj, created = Model.objects.update_or_create(defaults={"email":"new"}, name="Alice")
	Use filter() for lookup and set_field() for all values before calling.
	Returns: 1 if created, 0 if updated, -1 on error.
	Usage:
	  db.objects("users")
	  db.filter("name", "=", "Alice")
	  db.set_field("name", "Alice")
	  db.set_field("email", "alice@new.com")
	  let result = db.update_or_create()"""
	return __qs_update_or_create()

# ============================================================
# Phase 2: Window Functions
# ============================================================

pub def window(func: str, over_clause: str, alias: str) -> int:
	"""Add a window function to the SELECT clause.
	Django equivalent: Window(expression=RowNumber(), partition_by=[F('dept')], order_by=F('salary').desc())
	Generates: func OVER (over_clause) AS alias
	Usage:
	  db.objects("employees")
	  db.window("ROW_NUMBER()", "PARTITION BY dept ORDER BY salary DESC", "row_num")
	  db.fetch_all()"""
	return __qs_window(func, over_clause, alias)

# ============================================================
# Phase 2: Server-Side Cursor
# ============================================================

pub def cursor_declare(name: str) -> int:
	"""Declare a server-side cursor for the current queryset.
	PG: DECLARE name CURSOR FOR SELECT ...
	MySQL: uses LIMIT/OFFSET pagination internally.
	Must be inside a transaction (PG requirement).
	Usage:
	  db.begin()
	  db.objects("logs")
	  db.cursor_declare("log_cursor")
	  while db.cursor_fetch(100) > 0:
	    # process batch
	    pass
	  db.cursor_close()
	  db.commit()"""
	return __qs_cursor_declare(name)

pub def cursor_fetch(batch_size: int) -> int:
	"""Fetch next batch of rows from a declared cursor.
	PG: FETCH n FROM cursor_name
	MySQL: re-executes with LIMIT n OFFSET (auto-incremented)
	Returns row count (0 when no more rows).
	Usage: let rows = db.cursor_fetch(100)"""
	return __qs_cursor_fetch(batch_size)

pub def cursor_close() -> int:
	"""Close an open cursor and release resources.
	PG: CLOSE cursor_name
	MySQL: resets internal offset.
	Usage: db.cursor_close()"""
	return __qs_cursor_close()

# ============================================================
# Phase 2: JSON field helpers
# ============================================================

pub def json_set(col: str, key: str, val: str) -> int:
	"""Set a JSON field value.
	PG: jsonb_set(col, '{key}', '"val"')
	MySQL: JSON_SET(col, '$.key', 'val')
	Usage: db.objects("users"); db.json_set("settings", "theme", "dark")"""
	return __qs_json_set(col, key, val)

pub def json_get(col: str, key: str) -> str:
	"""Extract a value from a JSON field.
	PG: col->>'key'
	MySQL: JSON_UNQUOTE(JSON_EXTRACT(col, '$.key'))
	Usage: let theme = db.json_get("settings", "theme")"""
	return __qs_json_get(col, key)

pub def get_avg(col: str) -> str:
	"""SELECT AVG(col) — returns string."""
	return __qs_aggregate("AVG", col)

pub def get_sum(col: str) -> str:
	"""SELECT SUM(col) — returns string."""
	return __qs_aggregate("SUM", col)

pub def get_min(col: str) -> str:
	"""SELECT MIN(col) — returns string."""
	return __qs_aggregate("MIN", col)

pub def get_max(col: str) -> str:
	"""SELECT MAX(col) — returns string."""
	return __qs_aggregate("MAX", col)

pub def insert1(k1: str, v1: str) -> int:
	"""INSERT 1 field. Call db.objects(table) first."""
	return __qs_create1(k1, v1)

pub def insert2(k1: str, v1: str, k2: str, v2: str) -> int:
	"""INSERT 2 fields. Call db.objects(table) first."""
	return __qs_create2(k1, v1, k2, v2)

pub def insert3(k1: str, v1: str, k2: str, v2: str, k3: str, v3: str) -> int:
	"""INSERT 3 fields. Call db.objects(table) first."""
	return __qs_create3(k1, v1, k2, v2, k3, v3)

pub def insert4(k1: str, v1: str, k2: str, v2: str, k3: str, v3: str, k4: str, v4: str) -> int:
	"""INSERT 4 fields. Call db.objects(table) first."""
	return __qs_create4(k1, v1, k2, v2, k3, v3, k4, v4)

pub def insert5(k1: str, v1: str, k2: str, v2: str, k3: str, v3: str, k4: str, v4: str, k5: str, v5: str) -> int:
	"""INSERT 5 fields. Call db.objects(table) first."""
	return __qs_create5(k1, v1, k2, v2, k3, v3, k4, v4, k5, v5)

pub def get_by_id(id_val: int) -> int:
	"""Get single row by id. Call db.objects(table) first."""
	return __qs_get_by_id(id_val)

pub def set(key: str, val: str) -> int:
	"""Set a field for INSERT. Call db.objects(table) first, then set fields, then do_insert()."""
	return __qs_set_field(key, val)

pub def do_insert() -> int:
	"""Execute INSERT with all fields set via db.set(). Supports up to 32 fields."""
	return __qs_do_insert()

pub def create(**fields: str) -> int:
	"""Django-style INSERT. Call db.objects(table) first.
	Usage: db.objects("users"); db.create(name="Alice", age="30")"""
	for key, value in fields.items():
		__qs_set_field(key, value)
	return __qs_do_insert()

# ============================================================
# Public API — Values (dict/list access to results)
# ============================================================

pub def values(row: int) -> str:
	"""Get a row as a JSON-like dict string: {"col": "val", ...}.
	Call after fetch_all(). Django equivalent: .values()"""
	return __qs_values(row)

pub def values_list(row: int) -> str:
	"""Get a row as comma-separated values.
	Call after fetch_all(). Django equivalent: .values_list()"""
	return __qs_values_list(row)

pub def values_flat(row: int, col_name: str) -> str:
	"""Get a single column value from a row.
	Django equivalent: .values_list('name', flat=True)"""
	return __qs_values_flat(row, col_name)

# ============================================================
# Public API — Bulk Insert
# ============================================================

pub def bulk_begin(ncols: int) -> int:
	"""Start a bulk INSERT. Specify expected number of columns.
	Usage: db.objects("users"); db.bulk_begin(3)"""
	return __qs_bulk_begin(ncols)

pub def bulk_col(col_name: str) -> int:
	"""Add a column name for bulk INSERT."""
	return __qs_bulk_col(col_name)

pub def bulk_row_csv(csv_values: str) -> int:
	"""Add a row as comma-separated values for bulk INSERT."""
	return __qs_bulk_row_csv(csv_values)

pub def bulk_row1(v1: str) -> int:
	"""Add a single-column row for bulk INSERT."""
	return __qs_bulk_row1(v1)

pub def bulk_row2(v1: str, v2: str) -> int:
	"""Add a 2-column row for bulk INSERT."""
	return __qs_bulk_row2(v1, v2)

pub def bulk_row3(v1: str, v2: str, v3: str) -> int:
	"""Add a 3-column row for bulk INSERT."""
	return __qs_bulk_row3(v1, v2, v3)

pub def bulk_row4(v1: str, v2: str, v3: str, v4: str) -> int:
	"""Add a 4-column row for bulk INSERT."""
	return __qs_bulk_row4(v1, v2, v3, v4)

pub def bulk_row5(v1: str, v2: str, v3: str, v4: str, v5: str) -> int:
	"""Add a 5-column row for bulk INSERT."""
	return __qs_bulk_row5(v1, v2, v3, v4, v5)

pub def bulk_execute() -> int:
	"""Execute the bulk INSERT. Returns affected row count.
	Django equivalent: Model.objects.bulk_create([...])"""
	return __qs_bulk_execute()

