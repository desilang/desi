# orm.desi — Django-like ORM for Desi
#
# Usage:
#   import db
#   from orm import Manager
#
#   let User = Manager("users")
#   User.create3("name", "Alice", "email", "alice@test.com", "age", "30")
#   let qs = User.filter("age__gt", "21").order_by("name").fetch()

import db

# ============================================================
# C bindings (db_crud.c)
# ============================================================

@extern("C")
pub def __qs_reset(table: str) -> none

@extern("C")
pub def __qs_filter(lookup: str, val: str) -> int

@extern("C")
pub def __qs_exclude(lookup: str, val: str) -> int

@extern("C")
pub def __qs_order_by(col: str) -> int

@extern("C")
pub def __qs_limit(n: int) -> int

@extern("C")
pub def __qs_offset(n: int) -> int

@extern("C")
pub def __qs_fetch() -> int

@extern("C")
pub def __qs_row_count() -> int

@extern("C")
pub def __qs_count() -> int

@extern("C")
pub def __qs_exists() -> int

@extern("C")
pub def __qs_update(col: str, val: str) -> int

@extern("C")
pub def __qs_delete() -> int

@extern("C")
pub def __qs_aggregate(func: str, col: str) -> str

@extern("C")
pub def __qs_create1(k1: str, v1: str) -> int

@extern("C")
pub def __qs_create2(k1: str, v1: str, k2: str, v2: str) -> int

@extern("C")
pub def __qs_create3(k1: str, v1: str, k2: str, v2: str, k3: str, v3: str) -> int

@extern("C")
pub def __qs_create4(k1: str, v1: str, k2: str, v2: str, k3: str, v3: str, k4: str, v4: str) -> int

@extern("C")
pub def __qs_create5(k1: str, v1: str, k2: str, v2: str, k3: str, v3: str, k4: str, v4: str, k5: str, v5: str) -> int

@extern("C")
pub def __qs_get_by_id(id_val: int) -> int

# ============================================================
# QuerySet — Chainable query builder (Django-style)
# ============================================================

pub class QuerySet:
	"""Chainable queryset. Returned by Manager.filter(), Manager.all(), etc."""
	pub mut _table: str

	pub def filter(self, lookup: str, val: str) -> QuerySet:
		"""Add WHERE condition. Django lookups: age__lt, name__contains, etc."""
		__qs_filter(lookup, val)
		return self

	pub def exclude(self, lookup: str, val: str) -> QuerySet:
		"""Add WHERE NOT condition."""
		__qs_exclude(lookup, val)
		return self

	pub def order_by(self, col: str) -> QuerySet:
		"""Order results. Prefix with - for DESC: order_by('-name')"""
		__qs_order_by(col)
		return self

	pub def limit(self, n: int) -> QuerySet:
		"""Limit results."""
		__qs_limit(n)
		return self

	pub def offset(self, n: int) -> QuerySet:
		"""Offset results."""
		__qs_offset(n)
		return self

	pub def fetch(self) -> QuerySet:
		"""Execute SELECT. Returns self with results loaded."""
		__qs_fetch()
		return self

	pub def count(self) -> int:
		"""SELECT COUNT(*)."""
		return __qs_count()

	pub def exists(self) -> int:
		"""Check if any rows match. Returns 1 or 0."""
		return __qs_exists()

	pub def update(self, col: str, val: str) -> int:
		"""UPDATE matching rows. Returns affected count."""
		return __qs_update(col, val)

	pub def delete(self) -> int:
		"""DELETE matching rows. Returns deleted count."""
		return __qs_delete()

	pub def row_count(self) -> int:
		"""Row count from last fetch."""
		return __qs_row_count()

	pub def avg(self, col: str) -> str:
		"""SELECT AVG(col)."""
		return __qs_aggregate("AVG", col)

	pub def sum(self, col: str) -> str:
		"""SELECT SUM(col)."""
		return __qs_aggregate("SUM", col)

	pub def min_val(self, col: str) -> str:
		"""SELECT MIN(col)."""
		return __qs_aggregate("MIN", col)

	pub def max_val(self, col: str) -> str:
		"""SELECT MAX(col)."""
		return __qs_aggregate("MAX", col)

# ============================================================
# Manager — Django's objects manager
# ============================================================

pub class Manager:
	"""Django-like model manager. Entry point for all queries."""
	pub mut _table: str

	pub def all(self) -> QuerySet:
		"""Return QuerySet for all rows."""
		__qs_reset(self._table)
		let qs = QuerySet()
		qs._table := self._table
		return qs

	pub def filter(self, lookup: str, val: str) -> QuerySet:
		"""Return filtered QuerySet."""
		__qs_reset(self._table)
		let qs = QuerySet()
		qs._table := self._table
		return qs.filter(lookup, val)

	pub def exclude(self, lookup: str, val: str) -> QuerySet:
		"""Return excluded QuerySet."""
		__qs_reset(self._table)
		let qs = QuerySet()
		qs._table := self._table
		return qs.exclude(lookup, val)

	pub def get(self, id_val: int) -> int:
		"""Get single row by id. Returns row count (1 or 0)."""
		__qs_reset(self._table)
		return __qs_get_by_id(id_val)

	pub def count(self) -> int:
		"""Count all rows."""
		__qs_reset(self._table)
		return __qs_count()

	pub def create1(self, k1: str, v1: str) -> int:
		"""Insert with 1 field."""
		__qs_reset(self._table)
		return __qs_create1(k1, v1)

	pub def create2(self, k1: str, v1: str, k2: str, v2: str) -> int:
		"""Insert with 2 fields."""
		__qs_reset(self._table)
		return __qs_create2(k1, v1, k2, v2)

	pub def create3(self, k1: str, v1: str, k2: str, v2: str, k3: str, v3: str) -> int:
		"""Insert with 3 fields."""
		__qs_reset(self._table)
		return __qs_create3(k1, v1, k2, v2, k3, v3)

	pub def create4(self, k1: str, v1: str, k2: str, v2: str, k3: str, v3: str, k4: str, v4: str) -> int:
		"""Insert with 4 fields."""
		__qs_reset(self._table)
		return __qs_create4(k1, v1, k2, v2, k3, v3, k4, v4)

	pub def create5(self, k1: str, v1: str, k2: str, v2: str, k3: str, v3: str, k4: str, v4: str, k5: str, v5: str) -> int:
		"""Insert with 5 fields."""
		__qs_reset(self._table)
		return __qs_create5(k1, v1, k2, v2, k3, v3, k4, v4, k5, v5)

	pub def avg(self, col: str) -> str:
		"""Average of column."""
		__qs_reset(self._table)
		return __qs_aggregate("AVG", col)

	pub def sum(self, col: str) -> str:
		"""Sum of column."""
		__qs_reset(self._table)
		return __qs_aggregate("SUM", col)
