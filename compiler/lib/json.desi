# JSON module - Parse and stringify JSON data
# Uses hybrid C+Desi architecture per docs/dev/stdlib_architecture.md

# ============================================================
# C Runtime Bindings
# ============================================================

@extern("C")
pub def __json_parse(text: str) -> Any

@extern("C")
pub def __json_free(node: Any)

@extern("C")
pub def __json_type(node: Any) -> int

@extern("C")
pub def __json_get_bool(node: Any) -> bool

@extern("C")
pub def __json_get_number(node: Any) -> float

@extern("C")
pub def __json_get_string(node: Any) -> str

@extern("C")
pub def __json_array_len(node: Any) -> int

@extern("C")
pub def __json_array_get(node: Any, index: int) -> Any

@extern("C")
pub def __json_object_len(node: Any) -> int

@extern("C")
pub def __json_object_get(node: Any, key: str) -> Any

@extern("C")
pub def __json_stringify(node: Any) -> str

@extern("C")
pub def __json_is_int(node: Any) -> bool

@extern("C")
pub def __json_get_int(node: Any) -> int

@extern("C")
pub def __json_get_float(node: Any) -> float

@extern("C")
pub def __json_stringify_pretty(node: Any, indent: int) -> str

@extern("C")
pub def __json_clone(node: Any) -> Any

@extern("C")
pub def __json_merge(base: Any, overlay: Any) -> Any

@extern("C")
pub def __json_equals(a: Any, b: Any) -> bool

@extern("C")
pub def __json_has_key(obj: Any, key: str) -> bool

@extern("C")
pub def __json_object_values(obj: Any) -> Any

# Builder C functions
@extern("C")
def __json_new_object() -> Any

@extern("C")
def __json_new_array() -> Any

@extern("C")
def __json_new_string(s: str) -> Any

@extern("C")
def __json_new_number(n: float) -> Any

@extern("C")
def __json_new_bool(b: bool) -> Any

@extern("C")
def __json_new_null() -> Any

# Mutation C functions
@extern("C")
def __json_object_set(obj: Any, key: str, val: Any)

@extern("C")
def __json_array_push(arr: Any, val: Any)

@extern("C")
def __json_object_remove(obj: Any, key: str)

# Key access C functions
@extern("C")
def __json_object_keys(obj: Any) -> Any

@extern("C")
def __json_object_key(obj: Any, index: int) -> str

# JSON type constants (match JsonType enum in json.c)
pub let JSON_NULL = 0
pub let JSON_BOOL = 1
pub let JSON_NUMBER = 2
pub let JSON_STRING = 3
pub let JSON_ARRAY = 4
pub let JSON_OBJECT = 5

# ============================================================
# Public API
# ============================================================

# Parse a JSON string, returns the raw JSON node (Any type)
pub def parse(text: str) -> Any:
    unsafe:
        return __json_parse(text)

# Get the type of a JSON node (returns JSON_NULL, JSON_BOOL, etc.)
pub def get_type(node: Any) -> int:
    unsafe:
        return __json_type(node)

# Extract boolean value from JSON node (returns false if not a bool)
pub def get_bool(node: Any) -> bool:
    unsafe:
        return __json_get_bool(node)

# Extract number value from JSON node (returns 0.0 if not a number)
pub def get_number(node: Any) -> float:
    unsafe:
        return __json_get_number(node)

# Extract string value from JSON node (returns "" if not a string)
pub def get_string(node: Any) -> str:
    unsafe:
        return __json_get_string(node)

# Get array length (returns 0 if not an array)
pub def array_len(node: Any) -> int:
    unsafe:
        return __json_array_len(node)

# Get array element by index (returns null if out of bounds)
pub def array_get(node: Any, index: int) -> Any:
    unsafe:
        return __json_array_get(node, index)

# Get object length (number of keys)
pub def object_len(node: Any) -> int:
    unsafe:
        return __json_object_len(node)

# Get object value by key (returns null if key not found)
pub def object_get(node: Any, key: str) -> Any:
    unsafe:
        return __json_object_get(node, key)

# Convert JSON node to compact string
pub def stringify(node: Any) -> str:
    unsafe:
        return __json_stringify(node)

# Serialize JSON node to compact string (alias for stringify)
# Like Python's json.dumps()
pub def dumps(node: Any) -> str:
    unsafe:
        return __json_stringify(node)

# Serialize JSON node to pretty-printed string with indentation.
# Like Python's json.dumps(data, indent=2)
pub def pretty(node: Any, indent: int) -> str:
    unsafe:
        return __json_stringify_pretty(node, indent)

# Check if JSON node is null
pub def is_null(node: Any) -> bool:
    unsafe:
        return __json_type(node) == JSON_NULL

# Check if JSON node is a boolean
pub def is_bool(node: Any) -> bool:
    unsafe:
        return __json_type(node) == JSON_BOOL

# Check if JSON node is a number
pub def is_number(node: Any) -> bool:
    unsafe:
        return __json_type(node) == JSON_NUMBER

# Check if JSON node is a string
pub def is_string(node: Any) -> bool:
    unsafe:
        return __json_type(node) == JSON_STRING

# Check if JSON node is an array
pub def is_array(node: Any) -> bool:
    unsafe:
        return __json_type(node) == JSON_ARRAY

# Check if JSON node is an object
pub def is_object(node: Any) -> bool:
    unsafe:
        return __json_type(node) == JSON_OBJECT

# Check if JSON node is an integer (number with no fractional part)
pub def is_int(node: Any) -> bool:
    unsafe:
        return __json_is_int(node)

# Extract integer value from JSON node (returns 0 if not a number)
pub def get_int(node: Any) -> int:
    unsafe:
        return __json_get_int(node)

# Extract float value from JSON node (alias for get_number)
pub def get_float(node: Any) -> float:
    unsafe:
        return __json_get_float(node)

# ============================================================
# JSON Builders (create nodes programmatically)
# ============================================================

# Create an empty JSON object: {}
pub def new_object() -> Any:
    unsafe:
        return __json_new_object()

# Create an empty JSON array: []
pub def new_array() -> Any:
    unsafe:
        return __json_new_array()

# Create a JSON string node
pub def new_string(s: str) -> Any:
    unsafe:
        return __json_new_string(s)

# Create a JSON number node
pub def new_number(n: float) -> Any:
    unsafe:
        return __json_new_number(n)

# Create a JSON boolean node
pub def new_bool(b: bool) -> Any:
    unsafe:
        return __json_new_bool(b)

# Create a JSON null node
pub def new_null() -> Any:
    unsafe:
        return __json_new_null()

# Set a key-value pair on a JSON object (adds or updates)
pub def set(obj: Any, key: str, val: Any) -> none:
    unsafe:
        __json_object_set(obj, key, val)

# Push a value to a JSON array
pub def push(arr: Any, val: Any) -> none:
    unsafe:
        __json_array_push(arr, val)

# Remove a key from a JSON object
pub def remove(obj: Any, key: str) -> none:
    unsafe:
        __json_object_remove(obj, key)

# Get all keys of a JSON object as a JSON array of strings
pub def keys(obj: Any) -> Any:
    unsafe:
        return __json_object_keys(obj)

# Get object key at index (for iteration)
pub def object_key(obj: Any, index: int) -> str:
    unsafe:
        return __json_object_key(obj, index)

# ============================================================
# Advanced Operations
# ============================================================

# Deep clone a JSON node (returns independent copy)
# Like Python's copy.deepcopy() for JSON data
pub def clone(node: Any) -> Any:
    unsafe:
        return __json_clone(node)

# Merge two JSON objects. The overlay's keys take precedence.
# Like JavaScript's Object.assign() or Python's {**a, **b}
pub def merge(base: Any, overlay: Any) -> Any:
    unsafe:
        return __json_merge(base, overlay)

# Deep equality check between two JSON nodes
# Like Python's == for dicts/lists
pub def equals(a: Any, b: Any) -> bool:
    unsafe:
        return __json_equals(a, b)

# Check if a JSON object contains a key
# Like Python's "key" in dict
pub def has_key(obj: Any, key: str) -> bool:
    unsafe:
        return __json_has_key(obj, key)

# Get all values of a JSON object as a JSON array
# Like Python's dict.values()
pub def values(obj: Any) -> Any:
    unsafe:
        return __json_object_values(obj)

