# Quicksort benchmark: 10k deterministic ints sorted in-place.
def main() -> int:
	let mut nums: list[int] = []
	let mut seed = 123456789
	let mut k = 0
	while k < 10000:
		seed := ((seed * 1664525 + 1013904223) & 2147483647) % 2147483647
		let mut val = seed % 1000000
		if val < 0:
			val := -val
		nums.append(val)
		k := k + 1

	let mut stack: list[int] = []
	stack.append(0)
	stack.append(9999)

	while len(stack) > 0:
		let high = stack[len(stack) - 1]
		let low = stack[len(stack) - 2]
		let dummy1 = stack.pop()
		let dummy2 = stack.pop()

		let pivot = nums[high]
		let mut i = low - 1
		let mut j = low
		while j < high:
			if nums[j] <= pivot:
				i := i + 1
				let temp = nums[i]
				nums[i] := nums[j]
				nums[j] := temp
			j := j + 1

		let temp = nums[i + 1]
		nums[i + 1] := nums[high]
		nums[high] := temp
		let p = i + 1

		if p - 1 > low:
			stack.append(low)
			stack.append(p - 1)

		if p + 1 < high:
			stack.append(p + 1)
			stack.append(high)

	let mut checksum = 0
	let mut idx = 0
	while idx < 10000:
		checksum := (checksum + nums[idx]) % 1000000007
		idx := idx + 1

	print(checksum)
	return 0
