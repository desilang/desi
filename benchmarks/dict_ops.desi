# Hash-map benchmark: 100k int-keyed inserts, then 100k lookups.
# Mirrors dict_ops.c (open-addressing table with linear probing).
def main() -> int:
	let mut d: dict[int, int] = {0: 0}
	let mut i = 1
	while i < 100000:
		d[i] := i % 100
		i := i + 1

	let mut total = 0
	let mut j = 0
	while j < 100000:
		total := total + d[j]
		j := j + 1
	print(total)
	return 0
