# Test Mutex - basic usage with implemented syntax

def main() -> int:
    print("Testing mutex...")
    
    # Create a mutex protecting an integer
    let counter = mutex_new(42)
    
    # Lock the mutex to access the value
    let guard = counter.lock()
    let value = guard.value
    print(value)  # 42
    
    # With different types
    let str_mutex = mutex_new("hello")
    let str_guard = str_mutex.lock()
    print(str_guard.value)  # hello
    
    print("Mutex test complete!")
    return 0
