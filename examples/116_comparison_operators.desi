# The comparison dunders, each one exercised.
#
# Every result used to be assigned to a local annotated with the answer in a
# comment — `let less = p1 < p2  # true` — and then discarded. An operator that
# returned the wrong answer, or that dispatched to the wrong dunder, could not
# have been noticed.

class Point:
	pub mut x: int
	pub mut y: int

	pub def __lt__(self, other: Point) -> bool:
		if self.x < other.x:
			return true
		if self.x > other.x:
			return false
		return self.y < other.y

	pub def __le__(self, other: Point) -> bool:
		if self.x < other.x:
			return true
		if self.x > other.x:
			return false
		if self.y < other.y:
			return true
		if self.y > other.y:
			return false
		return true

	pub def __gt__(self, other: Point) -> bool:
		if self.x > other.x:
			return true
		if self.x < other.x:
			return false
		return self.y > other.y

	pub def __ge__(self, other: Point) -> bool:
		if self.x > other.x:
			return true
		if self.x < other.x:
			return false
		if self.y > other.y:
			return true
		if self.y < other.y:
			return false
		return true

	pub def __eq__(self, other: Point) -> bool:
		return self.x == other.x and self.y == other.y

def main() -> int:
	let p1 = Point()
	p1.x := 1
	p1.y := 2

	let p2 = Point()
	p2.x := 3
	p2.y := 4

	let p3 = Point()
	p3.x := 1
	p3.y := 2

	print(str(p1 < p2))
	print(str(p1 <= p3))
	print(str(p2 > p1))
	print(str(p3 >= p1))
	print(str(p1 == p3))
	print(str(p1 != p2))
	# The other direction, which should all be false.
	print(str(p2 < p1))
	print(str(p1 == p2))
	return 0

# EXPECTED_OUTPUT:
# true
# true
# true
# true
# true
# true
# false
# false
