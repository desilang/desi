# The default zero-argument constructor, and assigning fields afterwards.
#
# Used to build the object and return without reading a single field back.

class Point:
	pub mut x: int
	pub mut y: int

def main() -> int:
	let p = Point()
	p.x := 10
	p.y := 20
	print(str(p.x))
	print(str(p.y))
	return 0

# EXPECTED_OUTPUT:
# 10
# 20
