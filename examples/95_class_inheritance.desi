# A subclass carries its own field and the one it inherits.
#
# Used to construct a Dog and return, so nothing checked that the inherited
# field was even reachable.

class Animal:
	pub mut name: str

class Dog(Animal):
	pub mut breed: str

def main() -> int:
	let d = Dog()
	d.name := "Rex"
	d.breed := "collie"
	print(d.name)
	print(d.breed)
	return 0

# EXPECTED_OUTPUT:
# Rex
# collie
