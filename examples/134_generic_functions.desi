# Test generic functions

def identity<T>(x: T) -> T:
    return x

def main() -> int:
    let a = identity(42)
    print(f"identity(42) = {a}")
    
    let b = identity("hello")
    print(f"identity('hello') = {b}")
    
    print("Generic functions test passed!")
    return 0

# EXPECTED_OUTPUT:
# identity(42) = 42
# identity('hello') = hello
# Generic functions test passed!
