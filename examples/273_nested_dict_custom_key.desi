# Test nested dict with custom class key

class Point:
    pub x: int
    pub y: int
    
    pub def __new__(self, x: int, y: int):
        self.x = x
        self.y = y
    
    pub def __hash__(self) -> u64:
        return self.x * 31 + self.y
    
    pub def __eq__(self, other: Point) -> bool:
        return self.x == other.x and self.y == other.y

def main() -> int:
    print("Testing nested dict with custom key:")
    
    # Create nested dict: dict[Point, dict[str, int]]
    let grid: dict[Point, dict[str, int]] = {}
    
    # Create inner dict
    let p1 = Point(1, 2)
    let inner: dict[str, int] = {"x": 10, "y": 20}
    
    # Insert nested dict
    grid.insert(p1, inner)
    print("Inserted nested dict at Point(1,2)")
    
    # Test lookup
    let p1_lookup = Point(1, 2)
    if p1_lookup in grid:
        print("Point(1,2) found in grid: OK")
    else:
        print("ERROR: Point(1,2) not found")
    
    print("Nested dict test passed!")
    return 0

# EXPECTED_OUTPUT:
# Testing nested dict with custom key:
# Inserted nested dict at Point(1,2)
# Point(1,2) found in grid: OK
# Nested dict test passed!
