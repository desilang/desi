# M14: the auto-generated default to_str.
#
# The result used to be assigned to a local and dropped. The default is
# "<Point at 0xADDR>", so the address cannot be asserted — but its shape can,
# and that is what tells you the generated method ran at all.

struct Point:
	x: int
	y: int

def main():
	let p: Point = Point(x=10, y=20)
	let s: str = p.to_str()
	# "<Point at " — everything up to the address, which varies per run.
	print(s[0:10])
	print(str(len(s) > 10))

# EXPECTED_OUTPUT:
# <Point at 
# true
