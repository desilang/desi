# Test: Nested lists (list of lists)
def main() -> int:
    # Create a list of lists
    let matrix: list<list<int>> = [
        [1, 2, 3],
        [4, 5, 6],
        [7, 8, 9]
    ]
    
    # Access nested element
    let row: list<int> = matrix[1]
    let val: int = row[1]
    
    print(f"Middle element: {val}")
    
    # Should return 5 (middle element)
    return val
