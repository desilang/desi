# Test: Nested lists (list of lists)
def main() -> int:
    # Create a list of lists
    let matrix: list<list<int>> = [
        [1, 2, 3],
        [4, 5, 6],
        [7, 8, 9]
    ]
    
    # Access nested element
    let row: list<int> = matrix[1]
    let val: int = row[1]
    
    print(f"Middle element: {val}")
    
    # Verify correctness (should be 5)
    if val != 5:
        print("ERROR: val should be 5")
        return 1
        
    print("Nested list test passed!")
    return 0

# EXPECTED_OUTPUT:
# Middle element: 5
# Nested list test passed!
