# __copy__ produces a separate object, not another handle on the same one.
#
# The old version made the copy and returned. "p1 and p2 are now separate
# objects" was a comment, not a test: mutating one and reading the other is
# what actually shows it.

class Point:
	pub mut x: int
	pub mut y: int

	pub def __copy__(self) -> Point:
		return Point()

def main() -> int:
	let p1: Point = Point()
	p1.x := 1
	let p2: Point = p1.__copy__()
	p2.x := 99
	print(str(p1.x))
	print(str(p2.x))
	return 0

# EXPECTED_OUTPUT:
# 1
# 99
