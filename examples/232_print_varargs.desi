# Test multi-arg print functionality - Edge Cases

def main() -> int:
    # Basic multi-arg strings
    print("hello", "world")
    
    # Multi-arg integers
    print(1, 2, 3)
    
    # Mixed types: int, bool, string
    print(1, true, "hello")
    
    # Float and int
    print(3.14, 42)
    
    # Single arg (regression test)
    print("single")
    
    # No args - just newline
    print()
    
    # Many args
    print("a", "b", "c", "d", "e")
    
    0

# EXPECTED_OUTPUT:
# hello world
# 1 2 3
# 1 true hello
# 3.140000 42
# single
# 
# a b c d e
