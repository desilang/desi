
# Test 1: Basic union types (int|float)
struct MixedNumber:
    value: int|float

def test_basic_union():
    # Should accept int
    let a: MixedNumber = MixedNumber(value=42)
    print("int accepted")
    
    # Should accept float
    let b: MixedNumber = MixedNumber(value=3.14)
    print("float accepted")
    
    print("Basic union test passed!")

# Test 2: Nullable union (int|none)
struct OptionalInt:
    count: int|none

def test_nullable():
    # Should accept int
    let x: OptionalInt = OptionalInt(count=10)
    print("int accepted")
    
    # Should accept none
    let y: OptionalInt = OptionalInt(count=none)
    print("none accepted")
    
    print("Nullable test passed!")

# Test 3: Multi-variant union (int|float|str)
struct FlexibleValue:
    data: int|float|str

def test_multi_variant():
    let a: FlexibleValue = FlexibleValue(data=100)
    print("int accepted")
    
    let b: FlexibleValue = FlexibleValue(data=2.5)
    print("float accepted")
    
    let c: FlexibleValue = FlexibleValue(data="hello")
    print("str accepted")
    
    print("Multi-variant test passed!")

def main():
    test_basic_union()
    print("---")
    test_nullable()
    print("---")
    test_multi_variant()
    print("\nAll union type tests passed! ✅")

# EXPECTED_OUTPUT:
# int accepted
# float accepted
# Basic union test passed!
# ---
# int accepted
# none accepted
# Nullable test passed!
# ---
# int accepted
# float accepted
# str accepted
# Multi-variant test passed!
# 
# All union type tests passed! ✅
