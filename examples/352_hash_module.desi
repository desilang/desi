# Test hash module
import hash

def main() -> int:
    # MD5
    print(hash.md5("hello"))

    # SHA-256
    print(hash.sha256("hello"))

    # SHA-512 length
    print(len(hash.sha512("hello")) == 128)

    # HMAC length
    print(len(hash.hmac_sha256("key", "msg")) == 64)

    0

