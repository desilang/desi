# Storing custom classes in collections

class Person:
    pub name: str
    
    fn __init__(self, name: str):
        self.name = name
    
    fn to_str(self) -> str:
        return self.name

def main():
    let p1 = Person("Alice")
    let p2 = Person("Bob")
    
    let mut people: list[Person] = [p1]
    people.append(p2)
    
    print("People list:")
    print(people)
    
    print("\nManual iteration:")
    for i in range(0, len(people)):
        let person = people.get(i)
        print(person.to_str())
    
    print("\nTest passed!")
