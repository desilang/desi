# Storing custom classes in collections

class Person:
    pub name: str
    
    pub def __new__(self, name: str):
        self.name := name
    
    pub def __repr__(self) -> str:
        return self.name

def main():
    let p1 = Person("Alice")
    let p2 = Person("Bob")
    
    let mut people = [p1]
    people.append(p2)
    
    print("People list:")
    print(people)
    
    print("\nManual iteration with while loop:")
    let mut i = 0
    while i < len(people):
        let person = people.get(i)
        print(person)
        i += 1
    
    print("\nTest passed!")
