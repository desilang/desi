def main() -> int:
    let mut nums: list<int> = [1, 2, 3]
    nums.append(4)
    nums.append(5)
    
    let length: int = len(nums)
    let first: int = nums[0]
    
    print(f"Length: {length}, First: {first}")
    
    # Verify correctness
    if first != 1:
        print("ERROR: first should be 1")
        return 1
    if length != 5:
        print("ERROR: length should be 5")
        return 1
        
    print("List indexing test passed!")
    return 0

# EXPECTED_OUTPUT:
# Length: 5, First: 1
# List indexing test passed!
