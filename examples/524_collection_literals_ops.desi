# Test matrix: collection operations (list and dict)
#
# EXPECTED_OUTPUT:
# list_len: 2
# list_idx: 10
# list_pop: 20
# list_in: true
# dict_len: 2
# dict_idx: 100
# dict_get: 200
# dict_in: true

def main() -> int:
	let mut lst: list[int] = [10, 20]
	print("list_len:", len(lst))
	print("list_idx:", lst[0])
	lst[0] := 10
	let popped = lst.pop()
	print("list_pop:", popped)
	print("list_in:", 10 in lst)

	let mut d: dict[int, int] = {1: 100, 2: 200}
	print("dict_len:", len(d))
	print("dict_idx:", d[1])
	d[1] := 100
	print("dict_get:", d.get(2, -1))
	print("dict_in:", 1 in d)

	return 0
