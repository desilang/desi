# A generic enum whose type argument is inferred from the payload.
#
# Companion to 71, which pins the same defect down with an explicit annotation.
# This one leaves T to inference. It carried the same ineffective
# "# SKIPPED:" comment and the same unchecked garbage.
#
# EXPECTED_OUTPUT:
# Got: 42

enum MyResult<T>:
    Ok: T
    Empty: none

def main() -> int:
    let x = MyResult.Ok(42)

    match x:
        MyResult.Ok(v): print(f"Got: {v}")
        MyResult.Empty: print("empty")

    return 0
