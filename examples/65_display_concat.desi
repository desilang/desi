# Test 3: Display with string concat in to_str

struct Person:
    name: str
    age: int

impl Display for Person:
    def to_str(self) -> str:
        return self.name + " is " + self.age

def main() -> int:
    let p = Person(name="Alice", age=30)
    let greeting = "Hello, " + p
    print(greeting)
    return 0
