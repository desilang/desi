# Test generic struct definition and instantiation

struct Box<T>:
    val: T

struct Pair<A, B>:
    first: A
    second: B

def main() -> int:
    # Test Box<int>
    let b1: Box<int> = Box(val=42)
    print("Box<int> val:")
    print(b1.val)
    
    # Test Box<str>
    let b2: Box<str> = Box(val="hello")
    print("Box<str> val:")
    print(b2.val)
    
    # Test Pair<int, str>
    let p: Pair<int, str> = Pair(first=10, second="world")
    print("Pair first:")
    print(p.first)
    print("Pair second:")
    print(p.second)
    
    # Test nested generics: Box<Box<int>>
    let nested: Box<Box<int>> = Box(val=Box(val=99))
    print("Nested val:")
    print(nested.val.val)
    
    return 0

# EXPECTED_OUTPUT:
# Box<int> val:
# 42
# Box<str> val:
# hello
# Pair first:
# 10
# Pair second:
# world
# Nested val:
# 99
