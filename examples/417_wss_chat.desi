# EXPECTED: SKIP
# Real-time Chat — tests WebSocket + http.html file API
# Run: desic run examples/417_wss_chat.desi
# Open http://localhost:9090 in TWO browser tabs to chat!

import http
from http import Request

def on_open(conn: int):
	print("Chat: user joined (conn=" + str(conn) + ")")
	http.ws_broadcast("A new user joined the chat!")

def on_close(conn: int):
	print("Chat: user left (conn=" + str(conn) + ")")
	http.ws_broadcast("A user left the chat.")

def on_message(conn: int, msg: str):
	if msg == "/time":
		http.ws_send(conn, "Server is alive! Your connection: #" + str(conn))
		return
	if msg == "/ping":
		http.ws_send(conn, "pong!")
		return
	if msg == "/hello":
		http.ws_send(conn, "Hello from Desi server! You are connection #" + str(conn))
		return
	print("Chat msg from " + str(conn) + ": " + msg)
	http.ws_broadcast("User " + str(conn) + ": " + msg)

def handle_request(req: Request) -> Any:
	let path = http.req_path(req)
	if path == "/":
		return http.html(200, "examples/chat.html")
	return http.html(404, raw="<h1>Not Found</h1>")

def main() -> int:
	print("Starting Chat Server on :9090")
	print("Open http://localhost:9090 in TWO browser tabs!")
	let srv = http.server(9090)
	http.ws(srv, "/ws", on_message)
	http.ws_on_open(srv, on_open)
	http.ws_on_close(srv, on_close)
	http.ws_ping_interval(srv, 30)
	http.serve(srv, handle_request)
	return 0
