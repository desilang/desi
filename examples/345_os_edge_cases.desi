# Test os module - comprehensive edge cases
#
# The file used to print the platform name, HOME, USER and the working
# directory, and ended with a note saying the output was environment-dependent
# and had to be checked by hand. So it ran on every platform and asserted
# nothing about any of them.
#
# What is portable is the shape: which platform names are possible, that a
# missing variable comes back empty, that two calls agree. That is what it
# checks now, so the same expected output holds on Windows, Linux and macOS.
import os

def main() -> int:
    # --- Platform: the value differs per OS, the set of values does not ---
    # The names are the ones os.md documents, which is "darwin" for macOS and
    # not "macos" — writing the friendly name here is what turned this into a
    # macOS-only CI failure while Windows and Linux stayed green.
    let p = os.platform()
    print(f"platform known: {p == "windows" or p == "linux" or p == "darwin"}")

    # --- getenv: PATH is set everywhere ---
    let path = os.getenv("PATH")
    print(f"PATH set: {len(path) > 0}")

    # HOME and USER are Unix names — unset on Windows — so only their
    # behaviour is portable, not their contents.
    let home = os.getenv("HOME")
    let home2 = os.getenv("HOME")
    print(f"HOME stable: {home == home2}")

    # --- getenv: unknown variable returns empty ---
    let missing1 = os.getenv("DESI_TEST_MISSING_A")
    let missing2 = os.getenv("DESI_TEST_MISSING_B")
    let missing3 = os.getenv("ZZZZZZZ_NOT_REAL")
    print(f"missing1 empty: {len(missing1) == 0}")
    print(f"missing2 empty: {len(missing2) == 0}")
    print(f"missing3 empty: {len(missing3) == 0}")

    # --- getenv: empty string key ---
    let empty_key = os.getenv("")
    print(f"empty key: {len(empty_key) == 0}")

    # --- getcwd ---
    let cwd = os.getcwd()
    print(f"cwd non-empty: {len(cwd) > 0}")

    # --- Multiple calls return same values ---
    let p2 = os.platform()
    let cwd2 = os.getcwd()
    print(f"platform stable: {p == p2}")
    print(f"cwd stable: {cwd == cwd2}")

    0

# EXPECTED_OUTPUT:
# platform known: true
# PATH set: true
# HOME stable: true
# missing1 empty: true
# missing2 empty: true
# missing3 empty: true
# empty key: true
# cwd non-empty: true
# platform stable: true
# cwd stable: true
