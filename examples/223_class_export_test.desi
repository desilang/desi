# Test class usage from sync module
# NOTE: `from sync import Mutex` is not yet supported for classes
#       Use `import sync` and `sync.Mutex(value)` pattern instead

import sync

def main():
    print("Testing class export")
    let m = sync.Mutex(42)  # Uses class constructor
    print("Created mutex!")
    let guard = m.lock()
    print(guard.value)  # 42

# EXPECTED_OUTPUT:
# Testing class export
# Created mutex!
# 42
