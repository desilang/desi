# Test custom type as dict key using __hash__ and __eq__ dunders
# Phase 2: Custom type keys with dict operations and nested dicts

class Point:
    pub x: int
    pub y: int
    
    pub def __new__(self, x: int, y: int):
        self.x = x
        self.y = y
    
    pub def __hash__(self) -> u64:
        # Hash: x * 31 + y (coerced to u64)
        return self.x * 31 + self.y
    
    pub def __eq__(self, other: Point) -> bool:
        return self.x == other.x and self.y == other.y
    
    pub def __repr__(self) -> str:
        f"Point({self.x}, {self.y})"

def main() -> int:
    print("Testing custom type dict keys:")
    
    # Create Points
    let p1 = Point(1, 2)
    let p2 = Point(3, 4)
    let p1_copy = Point(1, 2)  # Same values as p1, different object
    
    # Verify __hash__ and __eq__ work
    print("=== __hash__ test ===")
    let h1 = p1.__hash__()
    let h2 = p2.__hash__()
    print("Hash p1 (1*31+2=33):")
    print(h1)
    print("Hash p2 (3*31+4=97):")
    print(h2)
    
    # Test equality
    print("=== __eq__ test ===")
    let eq_copy = p1.__eq__(p1_copy)
    print("p1 == p1_copy (same values):")
    print(eq_copy)
    
    # Test dict with custom key type
    print("=== dict[Point, str] test ===")
    let cache: dict[Point, str] = {}
    print("Created empty dict[Point, str]")
    
    cache.insert(p1, "origin")
    print("Inserted p1 -> origin")
    
    cache.insert(p2, "other")
    print("Inserted p2 -> other")
    
    # Test 'in' operator with original key
    if p1 in cache:
        print("p1 found in cache: OK")
    else:
        print("ERROR: p1 NOT found")
    
    if p2 in cache:
        print("p2 found in cache: OK")
    else:
        print("ERROR: p2 NOT found")
    
    # Test 'in' with different object, same values (value equality via __eq__)
    if p1_copy in cache:
        print("p1_copy found in cache (value eq): OK")
    else:
        print("p1_copy NOT found (pointer eq only)")
    
    print("Custom type dict key test passed!")
    return 0

# EXPECTED_OUTPUT:
# Testing custom type dict keys:
# === __hash__ test ===
# Hash p1 (1*31+2=33):
# 33
# Hash p2 (3*31+4=97):
# 97
# === __eq__ test ===
# p1 == p1_copy (same values):
# true
# === dict[Point, str] test ===
# Created empty dict[Point, str]
# Inserted p1 -> origin
# Inserted p2 -> other
# p1 found in cache: OK
# p2 found in cache: OK
# p1_copy found in cache (value eq): OK
# Custom type dict key test passed!
