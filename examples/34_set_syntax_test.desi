# Set literal syntax test

def main():
    # Empty set
    let empty: set[int] = #{}
    
    # Integer set
    let nums: set[int] = #{1, 2, 3}
    
    # String set
    let words: set[str] = #{"hello", "world"}
    
    # Test contains
    if nums.contains(2):
        print("Has 2")
    
    # Test add
    nums.add(4)
    
    # Free sets

    
    print("All tests passed")

# EXPECTED_OUTPUT:
# Has 2
# All tests passed
