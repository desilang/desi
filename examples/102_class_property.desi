# Test @property decorator
class Circle:
    pub radius: float
    @property
    pub def area(self) -> float:
        return 3.14159 * self.radius * self.radius
    @property
    pub def diameter(self) -> float:
        return self.radius * 2.0

def main() -> int:
    let c = Circle()
    let a = c.area  # No parentheses!
    let d = c.diameter
    return 0
