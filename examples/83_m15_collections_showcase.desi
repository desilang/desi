# Showcase of Desi collections: List, Dict, Set
# Demonstrates multiline literals and various methods

def main() -> int:
    print("--- List Showcase ---")
    # Multiline list literal
    let mut numbers: list<int> = [
        10,
        20,
        30,
        40,
        50
    ]
    print(f"Initial list len: {len(numbers)}")
    
    numbers.append(60)
    let last: int = numbers[5]
    print(f"After append(60), last element: {last}")
    
    print("--- Dict Showcase ---")
    # Multiline dict literal
    let mut scores: dict<str, int> = {
        "Alice": 95,
        "Bob": 82,
        "Charlie": 88
    }
    
    let alice_score = scores.get("Alice", 0)
    print(f"Alice score: {alice_score}")
    
    scores.insert("Dave", 90)
    let has_dave = scores.has_key("Dave")
    print(f"Added Dave. Has Dave: {has_dave}")
    
    print("--- Set Showcase ---")
    # Multiline set literal
    let mut tags: set<str> = #{
        "red",
        "green",
        "blue"
    }
    
    let has_green = tags.contains("green")
    print(f"Set has green: {has_green}")
    
    tags.add("yellow")
    let has_yellow = tags.contains("yellow")
    print(f"Added yellow. Has yellow: {has_yellow}")

    print("--- Nested Collections ---")
    let matrix: list<list<int>> = [
        [1, 2],
        [3, 4]
    ]
    let row1: list<int> = matrix[1]
    let val: int = row1[0]
    print(f"Matrix[1][0] (should be 3): {val}")
    
    return 0
