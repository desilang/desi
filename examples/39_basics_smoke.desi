def main():
    print("--- Primitives ---")
    # Integers
    let i: int = 42
    let neg: int = -10
    print(i)
    print(neg)
    
    # Floats
    let f: float = 3.14
    let f_neg: float = -0.001
    # print(f) # Float printing not fully supported in runtime yet? Let's check.
    
    # Booleans
    let t: bool = true
    let f_bool: bool = false
    if t:
        print("True works")
    if f_bool:
        print("False failed")
    else:
        print("False works")

    # Strings
    let s: str = "Hello Desi"
    print(s)

    print("--- Arithmetic ---")
    let sum: int = 10 + 5
    let diff: int = 10 - 5
    let prod: int = 10 * 5
    let quot: int = 10 / 2
    let rem: int = 10 % 3
    print(sum)
    print(diff)
    print(prod)
    print(quot)
    print(rem)

    print("--- Comparisons ---")
    if 10 > 5: print("10 > 5")
    if 5 < 10: print("5 < 10")
    if 10 == 10: print("10 == 10")
    if 10 != 5: print("10 != 5")
    if 10 >= 10: print("10 >= 10")
    if 5 <= 5: print("5 <= 5")

    print("--- Tuples ---")
    let tup: tuple[int, int, int] = (1, 2, 3)
    # Destructuring not fully supported yet, use indexing
    let a: int = tup[0]
    let b: int = tup[1]
    let c: int = tup[2]
    print(a)
    print(b)
    print(c)

    print("--- Sets ---")
    let s1: set[int] = #{1, 2, 3}
    if s1.contains(1):
        print("1 in set")
    if s1.contains(4):
        print("4 in set (fail)")
    else:
        print("4 not in set")

    print("--- Dicts ---")
    let d: dict[str, int] = {"a": 1, "b": 2}
    if d.has_key("a"):
        print("Has key a")
    # let val = d.get("a", 0) # Method call lowering might be tricky, let's stick to basics
    
    print("--- Control Flow ---")
    let mut count: int = 0
    while count < 3:
        print(count)
        count := count + 1
    
    print("All basics verified")
