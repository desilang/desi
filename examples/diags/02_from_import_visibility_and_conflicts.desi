# Cross-module visibility via module alias (no from-import here to avoid duplicate-import warn)
import mod_a as mod

def main() -> int:
  let _a = mod.add(1, 2)   # OK (pub)
  let _b = add(1, 2)       # DTE0010: unqualified cross-module use (even if pub)
  let _c = mod.secret()    # DTE0010: not public
  let _d = secret()        # DTE0010: unqualified cross-module use
  let _e = mod.PUB         # OK (pub const)
  let _f = mod.PRIV        # DTE0010: not public const
  return 0
