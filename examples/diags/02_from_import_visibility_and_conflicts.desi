# Cross-module visibility via module alias (no from-import here to avoid duplicate-import warn)
import "mod_a" as mod

def main() -> int:
  _ = mod.add(1, 2)   # OK (pub)
  _ = add(1, 2)       # DTE0010: unqualified cross-module use (even if pub)
  _ = mod.secret()    # DTE0010: not public
  _ = secret()        # DTE0010: unqualified cross-module use
  _ = mod.PUB         # OK (pub const)
  _ = mod.PRIV        # DTE0010: not public const
  return 0
