struct S:
  a: int
  b: int

def main() -> int:
  let n: int = 1
  n := 2                 # DTE0006: cannot assign to immutable variable

  let mut m: int = 1
  m := true              # DTE0004: type mismatch (int <- bool)

  let s: S = S{ a: 1, b: 2 }
  s.c := 3               # plain-text: unknown field "c" on struct "S"

  i := 0                 # DTE0001: undefined name "i"
  return 0
