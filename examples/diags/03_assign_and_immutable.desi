# EXPECT:
# - DTE0006 cannot assign to immutable variable (n = 2)
# - DTE0004 type mismatch (m = true vs int)
# - plus a few plain-text errors for invalid struct field updates

struct S:
  a: int
  b: int

def main() -> int:
  let s = S{ a: 1, b: 2 }
  s.c = 1                    # plain text: unknown field "c" on struct "S"

  let i = 0
  i.x = 3                    # plain text: cannot assign to field on non-struct "i"

  let mut m = 1
  m = true                   # DTE0004

  let n = 1
  n = 2                      # DTE0006

  return 0
