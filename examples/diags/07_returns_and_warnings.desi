def fallthrough() -> int:
  let x: int = 1
  # no return -> DW0006

def reachability() -> int:
  return 1
  print(2)  # DW0004
  print(3)  # DW0004

def unused_var_demo() -> int:
  let x: int = 1  # DW0001
  return 0

def main() -> int:
  let _t1 = fallthrough()
  reachability()
  let _t2 = unused_var_demo()
  return 0
