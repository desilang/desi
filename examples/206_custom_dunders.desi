# Test custom dunder methods with correct mutability syntax

class MyList:
    pub mut data: list[int]
    
    pub def __new__(self, values: list[int]):
        self.data = values
    
    pub def __getitem__(self, index: int) -> int:
        return self.data[index]
    
    pub def __setitem__(self, index: int, value: int):
        self.data[index] = value
    
    pub def __len__(self) -> int:
        return len(self.data)

def main() -> int:
    print("=== Testing list[index] = value ===")
    let mut data: list[int] = [10, 20, 30]
    print(data[0])  # 10
    data[0] = 100
    print(data[0])  # 100
    
    print("=== Testing custom __getitem__ ===")
    let arr = MyList([10, 20, 30])
    print(arr[0])  # 10
    print(arr[1])  # 20
    print(arr[-1]) # 30 (negative index)
    
    print("=== Testing custom __setitem__ ===")
    arr[0] = 999
    print(arr[0])  # 999
    
    print("=== Testing custom __len__ ===")
    let size = len(arr)
    print(size)  # 3
    
    print("All dunder tests passed!")
    return 0
