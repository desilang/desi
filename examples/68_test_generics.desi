# EXPECTED: COMPILE_ERROR
# Test: Generic Option<T> syntax
# This test checks if Desi supports generic enums

enum Option<T>:
  Some: T
  None: none

def divide(a: int, b: int) -> Option[int]:
    if b == 0:
        return Option.None()
    return Option.Some(a / b)

def main():
    print("Testing generic Option<int>")
    
    let result1: Option[int] = divide(10, 2)
    match result1:
        Option.Some(n): print(n)
        Option.None(): print("Error: division by zero")
    
    let result2: Option[int] = divide(10, 0)
    match result2:
        Option.Some(n): print(n)
        Option.None(): print("Error: division by zero")
    
    # Test with string
    let opt_str: Option[str] = Option.Some("hello")
    match opt_str:
        Option.Some(s): print(s)
        Option.None(): print("no string")
    
    print("Generic test complete")

