# Test deeply nested collections: list[list[dict[str, int]]]
# Access and print values at all levels

def main() -> int:
    print("Testing deeply nested collections:")
    
    # Create list of list of dicts (matrix of records)
    let matrix: list[list[dict[str, int]]] = []
    
    # Row 1: cells at (0,0) and (0,1)
    let row1: list[dict[str, int]] = []
    let r1_c1: dict[str, int] = {"x": 1, "y": 2}
    let r1_c2: dict[str, int] = {"x": 3, "y": 4}
    row1.append(r1_c1)
    row1.append(r1_c2)
    
    # Row 2: cells at (1,0) and (1,1)
    let row2: list[dict[str, int]] = []
    let r2_c1: dict[str, int] = {"x": 5, "y": 6}
    let r2_c2: dict[str, int] = {"x": 7, "y": 8}
    row2.append(r2_c1)
    row2.append(r2_c2)
    
    matrix.append(row1)
    matrix.append(row2)
    print("Created 2x2 matrix of dicts")
    
    # Access DEEP value: matrix[0][0]["x"]
    let row0 = matrix[0]
    let cell00 = row0[0]
    let val_x = cell00.get("x", -1)
    print("matrix[0][0]['x'] =")
    print(val_x)
    
    # Access another deep value: matrix[1][1]["y"]
    let row1_ref = matrix[1]
    let cell11 = row1_ref[1]
    let val_y = cell11.get("y", -1)
    print("matrix[1][1]['y'] =")
    print(val_y)
    
    # Direct chained access: matrix[0][1]["x"]
    let cell01 = matrix[0][1]
    print("matrix[0][1]['x'] =")
    print(cell01.get("x", -1))
    
    # Iterate through entire matrix
    print("All values:")
    for row: list[dict[str, int]] in matrix:
        for cell: dict[str, int] in row:
            print(cell.get("x", 0))
    
    print("Nested list[list[dict]] test passed!")
    return 0

# EXPECTED_OUTPUT:
# Testing deeply nested collections:
# Created 2x2 matrix of dicts
# matrix[0][0]['x'] =
# 1
# matrix[1][1]['y'] =
# 8
# matrix[0][1]['x'] =
# 3
# All values:
# 1
# 3
# 5
# 7
# Nested list[list[dict]] test passed!
