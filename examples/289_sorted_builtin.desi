# Test sorted() builtin function

def main() -> int:
    # Test sorted() with int
    let nums = [5, 2, 8, 1, 9, 3]
    print("Original:")
    print(nums)
    
    let asc = sorted(nums)
    print("sorted(nums):")
    print(asc)
    
    let desc = sorted(nums, true)
    print("sorted(nums, true):")
    print(desc)
    
    # Test sorted() with strings
    let words = ["banana", "apple", "cherry"]
    print("sorted(words):")
    print(sorted(words))
    
    print("All sorted() tests passed!")
    return 0

# EXPECTED_OUTPUT:
# Original:
# [5, 2, 8, 1, 9, 3]
# sorted(nums):
# [1, 2, 3, 5, 8, 9]
# sorted(nums, true):
# [9, 8, 5, 3, 2, 1]
# sorted(words):
# ["apple", "banana", "cherry"]
# All sorted() tests passed!
