# Test enumerate() builtin
# enumerate(items) returns (index, element) pairs

def main() -> int:
    let items: list[str] = ["apple", "banana", "cherry"]
    
    print("Testing enumerate():")
    for i: int, item: str in enumerate(items):
        print(i)
        print(item)
    
    print("Enumerate test passed!")
    return 0

# EXPECTED_OUTPUT:
# Testing enumerate():
# 0
# apple
# 1
# banana
# 2
# cherry
# Enumerate test passed!
