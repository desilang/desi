# EXPECTED: RUNTIME_ERROR
# Test recursion limit detection
# This test should panic when recursion depth exceeds 1000
#
# The recursive call must NOT be in tail position. A tail call is optimized
# into a jump, so it consumes no stack — and the guard measures stack headroom,
# so it correctly never fires and the program would loop forever instead of
# panicking. Adding to the result keeps this a real nested call, which is what
# the limit is there to catch.
#
# This was true of the old frame counter too, for a different reason: it
# decremented before a tail call on purpose, so the depth never grew.

def recurse(n: int) -> int:
    1 + recurse(n + 1)

def main() -> int:
    recurse(0)
    0
