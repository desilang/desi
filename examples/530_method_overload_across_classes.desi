# Same-named methods in different classes are not overloads of each other.
#
# Regression guard: overload candidates are keyed by bare name, so a method on
# one class shared a candidate set with a same-named method on another. The
# default-parameter consistency rule then compared their signatures and
# reported any difference in arity as "default parameters must be consistent
# across overloads" — rejecting a shape as ordinary as two classes whose
# constructors take different numbers of arguments.
#
# Methods are dispatched by receiver, so they never compete; the rule now
# partitions candidates by owning class before comparing. Differing arity is
# fine for genuine overloads too — a call tells them apart by argument count.
#
# EXPECTED_OUTPUT:
# 7
# 15
# 9
# 9
# 6
class Counter:
	pub mut n: int

	pub def __new__(self, n: int):
		self.n = n

	pub def bump(self, by: int) -> int:
		return self.n + by

class Box:
	pub mut w: int
	pub mut h: int

	pub def __new__(self, w: int, h: int):
		self.w = w
		self.h = h

	pub def bump(self, dw: int, dh: int) -> int:
		return (self.w + dw) * (self.h + dh)

# Free functions overloaded on arity, with a default in the longer one.
def total(a: int) -> int:
	return a

def total(a: int, b: int, c: int = 6) -> int:
	return a + b + c

def main() -> int:
	let c = Counter(5)
	let b = Box(2, 3)
	print(str(c.bump(2)))
	print(str(b.bump(1, 2)))
	print(str(total(9)))
	print(str(total(1, 2)))
	print(str(total(1, 2, 3)))
	return 0
