# Test nested structs

struct Point:
    x: int
    y: int

struct Rect:
    top_left: Point
    bottom_right: Point

def main():
    print("=== Nested Struct Test ===")
    
    let p1: Point = Point(x=0, y=0)
    let p2: Point = Point(x=10, y=20)
    
    let r: Rect = Rect(top_left=p1, bottom_right=p2)
    
    print("Top Left:")
    print(r.top_left.x)
    print(r.top_left.y)
    
    print("Bottom Right:")
    print(r.bottom_right.x)
    print(r.bottom_right.y)
    
    print("=== Done ===")

# EXPECTED_OUTPUT:
# === Nested Struct Test ===
# Top Left:
# 0
# 0
# Bottom Right:
# 10
# 20
# === Done ===
