# EXPECTED: SKIP
# Supervisor test — configurable pool size + bool display
import sync

def worker():
	print("Worker task executed")

def main() -> int:
	# Test with custom pool size
	using sup = sync.Supervisor(2):
		print("Pool size: " + str(sup.pool_size()))
		print("Is running: " + str(sup.is_running()))

		sup.submit(worker)
		sup.submit(worker)

		print("Stopping supervisor...")
		sup.stop()
		print("Is running after stop: " + str(sup.is_running()))

	print("Supervisor test complete!")
	return 0
