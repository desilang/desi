# Test immutable collections - these should cause compile errors

def main() -> int:
    # Test 1: Immutable list should ERROR on append
    let xs: list<int> = [1, 2, 3]
    # xs.append(4)  # ERROR: cannot call 'append' on immutable collection
    
    # Test 2: Mutable list should work
    let mut ys: list<int> = [1, 2, 3]
    ys.append(4)  # OK
    print(f"ys length: {len(ys)}")
    
    # Test 3: Immutable dict should prevent modifications
    let scores: dict<str, int> = {"alice": 95}
    # scores.insert("bob", 80)  # ERROR
    
    # Test 4: Mutable dict should work
    let mut scores2: dict<str, int> = {"alice": 95}
    scores2.insert("bob", 80)  # OK
    let has_bob = scores2.has_key("bob")
    print(f"scores2 has bob: {has_bob}")
    
    print("Immutability tests passed!")
    return 0

# EXPECTED_OUTPUT:
# ys length: 4
# scores2 has bob: true
# Immutability tests passed!
