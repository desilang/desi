# Test unqualified variant patterns in match
# Allows using Text(s) instead of requiring Data.Text(s)

enum Data:
    Empty: none
    Text: str
    Numbers: list[int]

def main() -> int:
    # Test 1: Unqualified patterns with payload
    let e1 = Data.Text("hello world")
    let r1 = match e1:
        Text(s): f"text: {s}"
        Numbers(n): f"nums: {len(n)}"
        Empty: "empty"
    print(r1)
    
    # Test 2: Unqualified unit pattern with unit variant scrutinee
    let e2 = Data.Empty
    let r2 = match e2:
        Text(s): "has text"
        Empty: "is empty"
        _: "other"
    print(r2)
    
    # Test 3: Mix of qualified and unqualified
    let e3 = Data.Numbers([1, 2, 3])
    let r3 = match e3:
        Data.Text(s): "qualified text"
        Numbers(n): f"unqualified nums: {len(n)}"
        Data.Empty: "qualified empty"
    print(r3)
    
    print("All unqualified pattern tests passed!")
    return 0

# EXPECTED_OUTPUT:
# text: hello world
# is empty
# unqualified nums: 3
# All unqualified pattern tests passed!
