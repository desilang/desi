# Test log module - comprehensive edge cases with level filtering
import log

def main() -> int:
    # --- Basic usage (all levels visible) ---
    log.debug("verbose detail")
    log.info("server started on port 8080")
    log.warn("disk space below 10%")
    log.error("connection to database refused")
    log.fatal("out of memory - shutting down")

    # --- Empty messages ---
    log.info("")
    log.error("")

    # --- Long messages ---
    log.debug("This is a very long debug message that contains a lot of detail about what is happening in the application right now and should not be truncated")

    # --- Messages with special characters ---
    log.info("Value: 42, ratio: 3.14, flag: true")
    log.warn("Path: /usr/local/bin/desi")
    log.error("Error code: 0xFF")

    # --- F-string messages ---
    let name = "Desi"
    let version = 1
    log.info(f"Starting {name} v{version}")
    log.warn(f"Max retries: {version + 2}")

    # --- Level filtering ---
    log.set_level("WARN")
    log.debug("HIDDEN - debug below WARN")
    log.info("HIDDEN - info below WARN")
    log.warn("visible - warn at WARN")
    log.error("visible - error above WARN")
    log.fatal("visible - fatal above WARN")

    log.set_level("FATAL")
    log.error("HIDDEN - error below FATAL")
    log.fatal("visible - fatal at FATAL")

    # Reset to DEBUG
    log.set_level("DEBUG")
    log.debug("visible - back at debug")

    # --- Simulated application flow ---
    log.info("=== Application Start ===")
    log.set_level("INFO")
    log.debug("HIDDEN - debug disabled in production")
    log.info("Database connected")
    log.info("HTTP server listening")
    log.warn("Rate limiter disabled")
    log.error("Failed to load optional plugin")
    log.info("Ready to serve requests")
    log.info("=== Application Shutdown ===")

    0

# NOTE: Output contains ANSI color codes, visual verification only.
# Run manually: desic run examples/343_log_module.desi

# EXPECTED_OUTPUT:
# [36m[DEBUG][0m verbose detail
# [34m[INFO][0m server started on port 8080
# [33m[WARN][0m disk space below 10%
# [31m[ERROR][0m connection to database refused
# [1;31m[FATAL][0m out of memory - shutting down
# [34m[INFO][0m 
# [31m[ERROR][0m 
# [36m[DEBUG][0m This is a very long debug message that contains a lot of detail about what is happening in the application right now and should not be truncated
# [34m[INFO][0m Value: 42, ratio: 3.14, flag: true
# [33m[WARN][0m Path: /usr/local/bin/desi
# [31m[ERROR][0m Error code: 0xFF
# [34m[INFO][0m Starting Desi v1
# [33m[WARN][0m Max retries: 3
# [33m[WARN][0m visible - warn at WARN
# [31m[ERROR][0m visible - error above WARN
# [1;31m[FATAL][0m visible - fatal above WARN
# [1;31m[FATAL][0m visible - fatal at FATAL
# [36m[DEBUG][0m visible - back at debug
# [34m[INFO][0m === Application Start ===
# [34m[INFO][0m Database connected
# [34m[INFO][0m HTTP server listening
# [33m[WARN][0m Rate limiter disabled
# [31m[ERROR][0m Failed to load optional plugin
# [34m[INFO][0m Ready to serve requests
# [34m[INFO][0m === Application Shutdown ===
