# Test log module - comprehensive edge cases
import log

def main() -> int:
    # --- Basic usage ---
    log.debug("verbose detail")
    log.info("server started on port 8080")
    log.warn("disk space below 10%")
    log.error("connection to database refused")
    log.fatal("out of memory - shutting down")

    # --- Empty messages ---
    log.info("")
    log.error("")

    # --- Long messages ---
    log.debug("This is a very long debug message that contains a lot of detail about what is happening in the application right now and should not be truncated")

    # --- Messages with special characters ---
    log.info("Value: 42, ratio: 3.14, flag: true")
    log.warn("Path: /usr/local/bin/desi")
    log.error("Error code: 0xFF")
    log.info("Tabs:	and	tabs")

    # --- Messages with punctuation ---
    log.info("Hello, World!")
    log.debug("a=1, b=2, c=3")
    log.warn("Warning! Something bad might happen...")
    log.error("Error: expected ';' but got '}'")

    # --- All levels in reverse order ---
    log.fatal("5-fatal")
    log.error("4-error")
    log.warn("3-warn")
    log.info("2-info")
    log.debug("1-debug")

    # --- F-string messages ---
    let name = "Desi"
    let version = 1
    let pi = 3.14
    log.info(f"Starting {name} v{version}")
    log.debug(f"Pi is approximately {pi}")
    log.warn(f"Max retries: {version + 2}")

    # --- Multiple calls to same level ---
    log.info("step 1 of 5")
    log.info("step 2 of 5")
    log.info("step 3 of 5")
    log.info("step 4 of 5")
    log.info("step 5 of 5")

    # --- Simulated application flow ---
    log.info("=== Application Start ===")
    log.debug("Initializing subsystems...")
    log.info("Database connected")
    log.info("HTTP server listening")
    log.warn("Rate limiter disabled")
    log.error("Failed to load optional plugin")
    log.info("Ready to serve requests")
    log.info("=== Application Shutdown ===")

    0

# NOTE: Log output ordering may vary in automated test pipelines.
# Run manually to verify: desic run examples/343_log_module.desi
# All messages should appear with [LEVEL] prefix format.
