# Test generic type instantiation with reference type (str)

enum MyStr<T>:
    Data: T
    Empty: none

def main() -> int:
    let x: MyStr<str> = MyStr.Data("hello")
    
    match x:
        MyStr.Data(s): print(f"Got: {s}")
        MyStr.Empty: print("Empty")
    
    print("Generic string test passed")
    return 0
