import fs

def main() -> int:
    # Setup: create a temp directory
    let dir = "desi_fs_test_dir"
    fs.mkdir(dir)
    print(fs.is_dir(dir))

    # write + read
    let path = "desi_fs_test_dir/hello.txt"
    fs.write(path, "hello world")
    print(fs.read(path))

    # exists, is_file
    print(fs.exists(path))
    print(fs.is_file(path))
    print(fs.is_dir(path))

    # size
    print(fs.size(path))

    # append
    fs.append(path, "\nline2")
    print(fs.read(path))

    # read_lines / write_lines
    let lines = fs.read_lines(path)
    print(lines)
    fs.write_lines("desi_fs_test_dir/lines.txt", ["alpha", "beta", "gamma"])
    print(fs.read("desi_fs_test_dir/lines.txt"))

    # list_dir
    let entries = fs.list_dir(dir)
    print(len(entries) >= 2)

    # copy
    fs.copy(path, "desi_fs_test_dir/copy.txt")
    print(fs.read("desi_fs_test_dir/copy.txt"))

    # move
    fs.move("desi_fs_test_dir/copy.txt", "desi_fs_test_dir/moved.txt")
    print(fs.exists("desi_fs_test_dir/copy.txt"))
    print(fs.exists("desi_fs_test_dir/moved.txt"))

    # abs
    let a = fs.abs("desi_fs_test_dir/hello.txt")
    print(a != "")

    # remove
    fs.remove("desi_fs_test_dir/hello.txt")
    fs.remove("desi_fs_test_dir/lines.txt")
    fs.remove("desi_fs_test_dir/moved.txt")
    print(fs.exists("desi_fs_test_dir/hello.txt"))

    # cleanup
    fs.remove(dir)

    0

# EXPECTED_OUTPUT:
# true
# hello world
# true
# true
# false
# 11
# hello world
# line2
# [hello world, line2]
# alpha
# beta
# gamma
# 
# true
# hello world
# line2
# false
# true
# true
# false
