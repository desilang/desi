def main() -> int:
    let mut d: dict<str, int> = {"a": 1, "b": 2}
    
    # Using method syntax
    let val: int = d.get("a", 0)
    print(f"Got value: {val}")
    
    # Check if key exists
    let has_a: bool = d.has_key("a")
    print(f"Has 'a': {has_a}")
    
    # Clear dict (requires mutable dict)
    d.clear()
    print("Dict cleared")
    
    return 0
