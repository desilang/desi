class Animal:
    pub mut name: str
    
    @abstract
    pub def speak(self) -> str:
        # Abstract method - subclasses must override
        return "Some sound"
    
    @abstract
    pub def move(self) -> str:
        # Abstract method with default implementation
        return ""
    

class Dog(Animal):
    pub mut breed: str
    
    # Must implement all abstract methods from Animal
    pub def speak(self) -> str:
        return "Woof!"
    
    pub def move(self) -> str:
        return "Running on four legs"

class Cat(Animal):
    pub mut color: str
    
    # Must implement all abstract methods
    pub def speak(self) -> str:
        return "Meow!"
    
    pub def move(self) -> str:
        return "Prowling silently"

def main() -> int:
	# Abstract methods, called through their concrete implementations. The old
	# version stored the two sounds in locals and returned, so an override that
	# resolved back to the abstract base would have passed.
	let d = Dog()
	d.name := "Buddy"
	d.breed := "Golden Retriever"

	let c = Cat()
	c.name := "Whiskers"
	c.color := "Orange"

	print(d.name + " says " + d.speak())
	print(d.name + " moves by " + d.move())
	print(c.name + " says " + c.speak())
	print(c.name + " moves by " + c.move())
	return 0

# EXPECTED_OUTPUT:
# Buddy says Woof!
# Buddy moves by Running on four legs
# Whiskers says Meow!
# Whiskers moves by Prowling silently
