# REQUIRES: database
# Example 464: Phase 4 — HAVING, multi-order, multi-update, pagination, soft-delete
# Demonstrates all Phase 4 query engine features against PostgreSQL
# EXPECTED_OUTPUT:
# === Phase 4: Query Engine ===
# Created 6 orders
# --- HAVING ---
# having rows: 2
# having_val rows: 3
# --- Multi-column ORDER BY ---
# order rows: 3
# first: Bob
# --- Multi-column UPDATE ---
# Updated Bob
# bob new salary: 95000
# bob new dept: Engineering
# --- Pagination ---
# total: 6
# page1 rows: 2
# page2 rows: 2
# page3 rows: 2
# --- Soft Delete ---
# before delete: 3
# after soft_delete: 2
# with_deleted: 3
# after restore: 3
# after hard_delete: 2
# === Done ===
import db
import env

db.use_postgres()

@model("emp_p4")
class Employee:
	pub name: CharField(100)
	pub dept: CharField(100)
	pub salary: IntField(default=0)
	pub is_deleted: BoolField(default=false)

@model("ord_p4")
class Order:
	pub customer: CharField(100)
	pub amount: IntField()
	pub product: CharField(100)

def main() -> int:
	print("=== Phase 4: Query Engine ===")
	let host = env.get("PG_HOST", "127.0.0.1")
	let user = env.get("PG_USER", "postgres")
	let password = env.get("PG_PASS", "")
	let dbname = env.get("PG_DB", "postgres")
	db.connect("postgres", host, 5432, dbname, user, password)

	# Create tables
	db.execute("DROP TABLE IF EXISTS ord_p4")
	db.execute("DROP TABLE IF EXISTS emp_p4")
	db.execute("CREATE TABLE emp_p4 (id SERIAL PRIMARY KEY, name VARCHAR(100), dept VARCHAR(100), salary INTEGER DEFAULT 0, is_deleted BOOLEAN DEFAULT false)")
	db.execute("CREATE TABLE ord_p4 (id SERIAL PRIMARY KEY, customer VARCHAR(100), amount INTEGER, product VARCHAR(100))")

	# Seed order data
	Order.objects.create(customer="Alice", amount="100", product="Widget")
	Order.objects.create(customer="Alice", amount="200", product="Gadget")
	Order.objects.create(customer="Bob", amount="50", product="Gizmo")
	Order.objects.create(customer="Bob", amount="30", product="Thing")
	Order.objects.create(customer="Charlie", amount="500", product="Mega")
	Order.objects.create(customer="Charlie", amount="10", product="Mini")
	print("Created 6 orders")

	# ============================================================
	# 1. HAVING clause
	# ============================================================
	print("--- HAVING ---")

	# HAVING with raw condition: customers whose total > 200
	db.objects("ord_p4")
	db.group_by("customer")
	db.annotate("total", "SUM", "amount")
	db.having("SUM(amount) > 200")
	let h1 = db.fetch_all()
	print(f"having rows: {str(h1)}")

	# HAVING with parameterized value: customers with > 1 order
	db.objects("ord_p4")
	db.group_by("customer")
	db.annotate("cnt", "COUNT", "*")
	db.having_val("COUNT(*) >", "1")
	let h2 = db.fetch_all()
	print(f"having_val rows: {str(h2)}")

	# ============================================================
	# 2. Multi-column ORDER BY
	# ============================================================
	print("--- Multi-column ORDER BY ---")

	# Seed employees
	Employee.objects.create(name="Alice", dept="Engineering", salary="80000")
	Employee.objects.create(name="Bob", dept="Engineering", salary="90000")
	Employee.objects.create(name="Charlie", dept="Sales", salary="70000")

	db.objects("emp_p4")
	db.order_by_add("-salary")   # primary: highest salary first
	db.order_by_add("name")     # secondary: alphabetical
	let o_rows = db.fetch_all()
	print(f"order rows: {str(o_rows)}")
	# Bob(90k) should be first, but let's get second (Alice 80k) to verify ordering
	# Actually first by -salary is Bob, then Alice, then Charlie
	# Let's verify by getting the third row (lowest salary)
	let first_name = db.get_field(0, "name")
	print(f"first: {first_name}")

	# ============================================================
	# 3. Multi-column UPDATE
	# ============================================================
	print("--- Multi-column UPDATE ---")

	db.objects("emp_p4")
	db.filter_by("name", "Bob")
	db.update_set("salary", "95000")
	db.update_set("dept", "Engineering")
	db.update_exec()
	print("Updated Bob")

	# Verify
	db.objects("emp_p4")
	db.filter_by("name", "Bob")
	db.fetch_all()
	let bob_salary = db.get_field(0, "salary")
	let bob_dept = db.get_field(0, "dept")
	print(f"bob new salary: {bob_salary}")
	print(f"bob new dept: {bob_dept}")

	# ============================================================
	# 4. Pagination
	# ============================================================
	print("--- Pagination ---")

	# Total count (all 6 orders)
	db.objects("ord_p4")
	let total = db.total_count()
	print(f"total: {str(total)}")

	# Page 1 (2 per page)
	db.objects("ord_p4")
	db.paginate(1, 2)
	let p1 = db.fetch_all()
	print(f"page1 rows: {str(p1)}")

	# Page 2
	db.objects("ord_p4")
	db.paginate(2, 2)
	let p2 = db.fetch_all()
	print(f"page2 rows: {str(p2)}")

	# Page 3
	db.objects("ord_p4")
	db.paginate(3, 2)
	let p3 = db.fetch_all()
	print(f"page3 rows: {str(p3)}")

	# ============================================================
	# 5. Soft Delete
	# ============================================================
	print("--- Soft Delete ---")

	# Count before delete
	db.objects("emp_p4")
	db.soft_delete_mode("is_deleted")
	let before = db.fetch_all()
	print(f"before delete: {str(before)}")

	# Soft-delete Charlie
	db.objects("emp_p4")
	db.soft_delete_mode("is_deleted")
	db.filter_by("name", "Charlie")
	db.soft_delete()

	# Count after soft delete (auto-filter)
	db.objects("emp_p4")
	db.soft_delete_mode("is_deleted")
	let after = db.fetch_all()
	print(f"after soft_delete: {str(after)}")

	# with_deleted — see all including deleted
	db.objects("emp_p4")
	db.soft_delete_mode("is_deleted")
	db.with_deleted()
	let all_rows = db.fetch_all()
	print(f"with_deleted: {str(all_rows)}")

	# restore Charlie
	db.objects("emp_p4")
	db.soft_delete_mode("is_deleted")
	db.with_deleted()
	db.filter_by("name", "Charlie")
	db.restore()

	# Verify restored
	db.objects("emp_p4")
	db.soft_delete_mode("is_deleted")
	let restored = db.fetch_all()
	print(f"after restore: {str(restored)}")

	# hard_delete Alice (permanent)
	db.objects("emp_p4")
	db.filter_by("name", "Alice")
	db.hard_delete()

	db.objects("emp_p4")
	let remaining = db.fetch_all()
	print(f"after hard_delete: {str(remaining)}")

	# Clean up
	db.execute("DROP TABLE ord_p4")
	db.execute("DROP TABLE emp_p4")
	db.close()
	print("=== Done ===")
	0
