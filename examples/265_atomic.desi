# Test Atomic - Comprehensive lock-free operations
import sync

def test_load_store() -> none:
    print("=== load/store ===")
    let a = sync.Atomic(42)
    let v1 = a.load()
    print(v1)  # 42
    a.store(100)
    let v2 = a.load()
    print(v2)  # 100

def test_add() -> none:
    print("=== add ===")
    let a = sync.Atomic(10)
    let result = a.add(5)
    print(result)     # 15 (new value)
    let v = a.load()
    print(v)   # 15

def test_sub() -> none:
    print("=== sub ===")
    let a = sync.Atomic(20)
    let result = a.sub(7)
    print(result)     # 13 (new value)
    let v = a.load()
    print(v)   # 13

def test_inc() -> none:
    print("=== inc ===")
    let a = sync.Atomic(0)
    let v1 = a.inc()
    print(v1)  # 1
    let v2 = a.inc()
    print(v2)  # 2
    let v3 = a.inc()
    print(v3)  # 3

def test_dec() -> none:
    print("=== dec ===")
    let a = sync.Atomic(10)
    let v1 = a.dec()
    print(v1)  # 9
    let v2 = a.dec()
    print(v2)  # 8

def test_compare_exchange_success() -> none:
    print("=== compare_exchange success ===")
    let a = sync.Atomic(50)
    # Current value is 50, expect 50, want to set to 99
    if a.compare_exchange(50, 99):
        print("CAS succeeded")
    else:
        print("FAIL: CAS should have succeeded")
    let v = a.load()
    print(v)  # 99

def test_compare_exchange_failure() -> none:
    print("=== compare_exchange failure ===")
    let a = sync.Atomic(50)
    # Current value is 50, but we expect 100 (wrong)
    if a.compare_exchange(100, 99):
        print("FAIL: CAS should have failed")
    else:
        print("CAS failed (correct)")
    let v = a.load()
    print(v)  # 50 (unchanged)

def test_exchange() -> none:
    print("=== exchange ===")
    let a = sync.Atomic(42)
    let old = a.exchange(100)
    print(old)       # 42 (old value)
    let v = a.load()
    print(v)  # 100 (new value)

def test_edge_zero() -> none:
    print("=== zero edge case ===")
    let a = sync.Atomic(0)
    let v1 = a.load()
    print(v1)   # 0
    let v2 = a.inc()
    print(v2)    # 1
    let v3 = a.dec()
    print(v3)    # 0
    let v4 = a.dec()
    print(v4)    # -1 (negative)

def test_edge_negative() -> none:
    print("=== negative values ===")
    let a = sync.Atomic(-10)
    let v1 = a.load()
    print(v1)       # -10
    let v2 = a.add(20)
    print(v2)      # 10
    let v3 = a.sub(15)
    print(v3)      # -5

def main() -> int:
    print("Testing Atomic with all operations...")
    
    test_load_store()
    test_add()
    test_sub()
    test_inc()
    test_dec()
    test_compare_exchange_success()
    test_compare_exchange_failure()
    test_exchange()
    test_edge_zero()
    test_edge_negative()
    
    print("All Atomic tests passed!")
    return 0

# EXPECTED_OUTPUT:
# Testing Atomic with all operations...
# === load/store ===
# 42
# 100
# === add ===
# 15
# 15
# === sub ===
# 13
# 13
# === inc ===
# 1
# 2
# 3
# === dec ===
# 9
# 8
# === compare_exchange success ===
# CAS succeeded
# 99
# === compare_exchange failure ===
# CAS failed (correct)
# 50
# === exchange ===
# 42
# 100
# === zero edge case ===
# 0
# 1
# 0
# -1
# === negative values ===
# -10
# 10
# -5
# All Atomic tests passed!
