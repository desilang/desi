# Pattern Variable Bindings Test

enum MyOption:
  Some: int
  Empty: none

enum MyResult:
  Ok: str
  Err: int

def main() -> int:
  print("Testing pattern variable bindings")
  
  # Test 1: Extract int from Some
  print("Test 1: Extract int payload")
  let opt: MyOption = MyOption.Some(42)
  match opt:
    MyOption.Some(x): print(f"Got: {x}")
    MyOption.Empty: print("empty")
  
  # Test 2: Extract str from Ok
  print("Test 2: Extract str payload")
  let res: MyResult = MyResult.Ok("success")
  match res:
    MyResult.Ok(msg): print(f"Message: {msg}")
    MyResult.Err(code): print(f"Error: {code}")
  
  # Test 3: Use binding in expression
  print("Test 3: Use binding in match result")
  let n: MyOption = MyOption.Some(10)
  let doubled: int = match n:
    MyOption.Some(val): val
    MyOption.Empty: 0
  print(f"Doubled: {doubled}")
  
  print("All binding tests passed!")
  return 0

# EXPECTED_OUTPUT:
# Testing pattern variable bindings
# Test 1: Extract int payload
# Got: 42
# Test 2: Extract str payload
# Message: success
# Test 3: Use binding in match result
# Doubled: 10
# All binding tests passed!
