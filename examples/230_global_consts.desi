def main() -> int:
    print("Testing globals...")
    
    # Access globals
    print(f"Max retries: {MAX_RETRIES}")
    print(f"App Name: {APP_NAME}")
    
    # Access lowercase
    print(f"Small: {small_const}")
    
    # Check if we can modify? (Should be compile error if we tried to declare it mut)
    # But since they are immutable, we cant assign.
    # small_const = 200 # Should be error: cannot assign to immutable
    
    return 0

