# Safe Extern Test
# Tests @extern("C", safe=true, c_name="...") for seamless C FFI

# safe=true generates a wrapper with internal unsafe block
@extern("C", safe=true, c_name="abs")
pub def safe_abs(x: i32) -> i32

def main() -> int:
    # No unsafe block needed - safe=true handles it internally!
    let val = safe_abs(-42)
    print(val)
    
    let val2 = safe_abs(10)
    print(val2)
    
    0

# EXPECTED_OUTPUT:
# 42
# 10
