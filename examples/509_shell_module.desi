# Test shell module
import shell

def main() -> int:
	# Execute command and get stdout
	let result = shell.exec("echo hello shell")
	print(result)

	# Execute status
	let status = shell.exec_status("exit 0")
	print(status)

	# Which — find a command
	let bash_path = shell.which("git")
	print(bash_path != "")

	# File operations
	shell.mkdir_p("desi_shell_test_dir/sub")
	print(shell.is_dir("desi_shell_test_dir"))
	print(shell.is_dir("desi_shell_test_dir/sub"))

	# Write and read
	shell.write("desi_shell_test_dir/test.txt", "hello from shell")
	print(shell.cat("desi_shell_test_dir/test.txt"))
	print(shell.is_file("desi_shell_test_dir/test.txt"))

	# Append
	shell.append("desi_shell_test_dir/test.txt", "\nline two")
	let lines = shell.lines("desi_shell_test_dir/test.txt")
	print(lines)

	# Copy
	shell.cp("desi_shell_test_dir/test.txt", "desi_shell_test_dir/copy.txt")
	print(shell.exists("desi_shell_test_dir/copy.txt"))

	# Move
	shell.mv("desi_shell_test_dir/copy.txt", "desi_shell_test_dir/moved.txt")
	print(shell.exists("desi_shell_test_dir/copy.txt"))
	print(shell.exists("desi_shell_test_dir/moved.txt"))

	# Cleanup
	shell.rm("desi_shell_test_dir/test.txt")
	shell.rm("desi_shell_test_dir/moved.txt")
	shell.rmdir("desi_shell_test_dir/sub")
	shell.rmdir("desi_shell_test_dir")
	print(shell.exists("desi_shell_test_dir"))

	print("shell ok")
	0

# EXPECTED_OUTPUT:
# hello shell
# 0
# true
# true
# true
# hello from shell
# true
# 1
# true
# false
# true
# false
# shell ok
