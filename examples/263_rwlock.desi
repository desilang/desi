# Test RwLock - Comprehensive edge cases
# Tests: primitives, custom types, write guards, try_read/try_write
import sync

struct Point:
    x: int
    y: int

def test_int() -> none:
    let rw = sync.RwLock(42)
    using guard = rw.read():
        print(guard.value)  # 42

def test_str() -> none:
    let rw = sync.RwLock("hello world")
    using guard = rw.read():
        print(guard.value)  # hello world

def test_float() -> none:
    let rw = sync.RwLock(3.14)
    using guard = rw.read():
        print(guard.value)  # 3.14

def test_bool() -> none:
    let rw = sync.RwLock(true)
    using guard = rw.read():
        print(guard.value)  # true

def test_struct() -> none:
    let rw = sync.RwLock(Point(x=10, y=20))
    using guard = rw.read():
        let p = guard.value
        print(p.x)  # 10
        print(p.y)  # 20

def test_write() -> none:
    let rw = sync.RwLock(0)
    # Write guard for exclusive access
    using wg = rw.write():
        print(wg.value)  # 0

def test_try_read() -> none:
    let rw = sync.RwLock(99)
    # try_read should succeed when unlocked
    match rw.try_read():
        Option.Some(guard): print(guard.value)
        Option.Nothing: print("FAIL: try_read returned Nothing")

def test_try_write() -> none:
    let rw = sync.RwLock(77)
    # try_write should succeed when unlocked
    match rw.try_write():
        Option.Some(guard): print(guard.value)
        Option.Nothing: print("FAIL: try_write returned Nothing")

def main() -> int:
    print("Testing RwLock with various types...")
    
    print("=== int ===")
    test_int()
    
    print("=== str ===")
    test_str()
    
    print("=== float ===")
    test_float()
    
    print("=== bool ===")
    test_bool()
    
    print("=== struct ===")
    test_struct()
    
    print("=== write guard ===")
    test_write()
    
    print("=== try_read ===")
    test_try_read()
    
    print("=== try_write ===")
    test_try_write()
    
    print("All RwLock tests passed!")
    return 0

# EXPECTED_OUTPUT:
# Testing RwLock with various types...
# === int ===
# 42
# === str ===
# hello world
# === float ===
# 3.14
# === bool ===
# true
# === struct ===
# 10
# 20
# === write guard ===
# 0
# === try_read ===
# 99
# === try_write ===
# 77
# All RwLock tests passed!
