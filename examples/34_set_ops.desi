# Test set operations

def main() -> int:
    # Set literal (mutable for add/remove/clear)
    let mut s: set<int> = #{1, 2, 3}
    print("Set created")

    # Contains
    if s.contains(1):
        print("Contains 1")

    # Add
    s.add(4)
    if s.contains(4):
        print("Added 4")

    # Remove
    s.remove(2)
    print("Removed 2")

    # Clear
    s.clear()
    print("Cleared set")

    # String set
    let s2: set<str> = #{"hello", "world"}
    if s2.contains("hello"):
        print("String set works")

    return 0

# EXPECTED_OUTPUT:
# Set created
# Contains 1
# Added 4
# Removed 2
# Cleared set
# String set works
