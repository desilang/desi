# Test __format__ dunder for custom class formatting in f-strings
# Using simpler struct pattern that works with existing tests

class Point:
    pub x: int
    pub y: int
    
    pub def __new__(self, x: int, y: int):
        self.x := x
        self.y := y

    pub def __format__(self, spec: str) -> str:
        if spec == "short":
            return f"({self.x},{self.y})"
        return f"Point({self.x}, {self.y})"

def main() -> int:
    let p: Point = Point(x=1, y=2)
    
    # Test with format spec - use __format__
    print(f"{p:short}")
    
    # Test without format spec - default behavior
    print(f"{p}")
    
    return 0

# EXPECTED_OUTPUT:
# (1,2)
# Point(1, 2)
