# Stage-0 parser stub (self-hosting path)
# Implements: parse_to_json(path: str) -> str
# Emits a valid AST JSON with kind="File", imports, and minimal FuncDecls.
# v0.4:
#   - Adds single-name let/assign statements:
#       let a[: Type]? = <expr>
#       a := <expr>
#       a =  <expr>        (NEW)
#   - ExprStmt(CallExpr), ReturnStmt
#   - Indentation-based blocks, no multi-returns, no break/continue.

def parse_to_json(path: str) -> str:
  let src = fs.read_all(path)
  let imports_json = scan_imports(src)
  let decls_json = scan_funcs(src)
  return "{\"kind\":\"File\",\"pkg\":null,\"imports\":[" + imports_json + "],\"decls\":[" + decls_json + "]}"

# ---------- imports ----------

def scan_imports(src: str) -> str:
  let n = str.len(src)
  let mut i = 0
  let mut out = ""
  let mut first = true
  while i < n:
    let mut handled = false
    if is_line_start(src, i):
      let j0 = skip_hspace(src, i)
      # accept "import " (with a space); some codegen trims, so the length below stays 7
      if starts_with(src, j0, "import "):
        let mut j = j0 + 7
        let name = read_until_delims(src, j, 10, 13, 35, 32, 9)  # NL, CR, '#', space, tab
        if str.len(name) > 0:
          if not first:
            out := out + ","
          out := out + "{\"kind\":\"ImportDecl\",\"path\":\"" + name + "\"}"
          first := false
        j := j + str.len(name)
        i := advance_to_next_line(src, j)
        handled := true
    if not handled:
      i := i + 1
  return out

# ---------- funcs (headers + tiny bodies) ----------

def scan_funcs(src: str) -> str:
  let n = str.len(src)
  let mut i = 0
  let mut out = ""
  let mut first = true

  while i < n:
    let mut handled = false
    if is_line_start(src, i):
      let j0 = skip_hspace(src, i)
      if starts_with(src, j0, "def "):
        let mut j = j0 + 4
        let name = read_ident(src, j)
        if str.len(name) > 0:
          j := j + str.len(name)
          j := skip_hspace(src, j)
          if j < n and str.at(src, j) == 40:  # '('
            j := j + 1
            j := skip_hspace(src, j)

            # params
            let mut params_json = ""
            let mut params_first = true
            if not (j < n and str.at(src, j) == 41):  # ')'
              let mut params_done = false
              while j < n and not params_done:
                let pn = read_ident(src, j)
                if str.len(pn) == 0:
                  params_done := true
                else:
                  j := j + str.len(pn)
                  j := skip_hspace(src, j)
                  if j < n and str.at(src, j) == 58:  # ':'
                    j := j + 1
                    j := skip_hspace(src, j)
                    let pty = read_until_either(src, j, 44, 41)  # ',' or ')'
                    j := j + str.len(pty)
                    let pty_trim = trim_space(pty)
                    if not params_first:
                      params_json := params_json + ","
                    params_json := params_json + "{\"kind\":\"Param\",\"name\":\"" + pn + "\",\"type\":\"" + pty_trim + "\"}"
                    params_first := false
                    if j < n and str.at(src, j) == 44:
                      j := j + 1
                      j := skip_hspace(src, j)
                    else:
                      params_done := true
                  else:
                    params_done := true
            if j < n and str.at(src, j) == 41:  # ')'
              j := j + 1
              j := skip_hspace(src, j)
              if j+1 < n and str.at(src, j) == 45 and str.at(src, j+1) == 62:  # '->'
                j := j + 2
                j := skip_hspace(src, j)
                let ret_ty = read_until_delim(src, j, 58)  # ':'
                let rtrim = trim_space(ret_ty)
                j := j + str.len(ret_ty)
                if j < n and str.at(src, j) == 58:
                  j := j + 1
                  let body_res = parse_func_body(src, j)
                  let body_json = tuple_first(body_res)
                  let next_i = tuple_second(body_res)
                  if not first:
                    out := out + ","
                  out := out + "{\"kind\":\"FuncDecl\",\"name\":\"" + name + "\",\"params\":[" + params_json + "],\"ret\":\"" + rtrim + "\",\"body\":[" + body_json + "]}"
                  first := false
                  i := next_i
                  handled := true
    if not handled:
      i := i + 1
  return out

# ---------- body parser (very small) ----------

def parse_func_body(src: str, after_colon_pos: int) -> str:
  let n = str.len(src)
  let mut i = advance_to_next_line(src, after_colon_pos)

  # find base indent
  let mut base_indent = -1
  let mut probe = i
  let mut found_body = false
  while probe < n and not found_body:
    if is_line_start(src, probe):
      let j = skip_hspace(src, probe)
      let head = line_head_char(src, j)
      if head == 0:
        probe := advance_to_next_line(src, probe)
      else:
        if head == 35:
          probe := advance_to_next_line(src, probe)
        else:
          base_indent := j - probe
          found_body := true
    else:
      probe := probe + 1

  if not found_body:
    return make_tuple("", i)

  # collect statements until dedent
  let mut out = ""
  let mut first = true
  let mut cur = probe
  let mut done = false
  while cur < n and not done:
    if is_line_start(src, cur):
      let line_start = cur
      let j = skip_hspace(src, cur)
      let indent = j - line_start
      let head = line_head_char(src, j)

      if head == 0:
        cur := advance_to_next_line(src, cur)
      else:
        if head == 35:
          cur := advance_to_next_line(src, cur)
        else:
          if indent < base_indent:
            done := true
          else:
            let line = read_line(src, j)
            let tline = trim_space(line)

            # unified statement parser (let / := / = / return / expr)
            let stmt_json = parse_stmt_line(tline)

            if str.len(stmt_json) > 0:
              if not first:
                out := out + ","
              out := out + stmt_json
              first := false

            cur := advance_to_next_line(src, j)
    else:
      cur := cur + 1

  return make_tuple(out, cur)

# ---- JSON helpers ----

def json_escape(s: str) -> str:
  let n = str.len(s)
  let mut i = 0
  let mut out = ""
  while i < n:
    let c = str.at(s, i)
    if c == 34:
      out := out + "\\\""
    else:
      if c == 92:
        out := out + "\\\\"
      else:
        out := out + str.from_code(c)
    i := i + 1
  return out

def json_quote(s: str) -> str:
  return "\"" + json_escape(s) + "\""

# ---------- statement parsers ----------

def parse_assign_line_from_pos(s: str, apos: int) -> str:
  let n = str.len(s)
  let j0 = apos + 1
  let j = skip_hspace_str(s, j0)
  if not (j < n and str.at(s, j) == 61):   # '='
    return ""
  let lhs = trim_space(slice(s, 0, apos))
  if not is_ident(lhs):
    return ""
  let rhs = strip_comment_depth0(trim_space(slice_from(s, j + 1)))
  let ej = parse_expr_json(rhs)
  if str.len(ej) == 0:
    return ""
  return "{\"kind\":\"AssignStmt\",\"names\":[" + json_quote(lhs) + "],\"exprs\":[" + ej + "]}"

def parse_assign_eq_from_pos(s: str, epos: int) -> str:     # "="
  # only single '=' (not part of ':='); caller ensures it's an assignment line
  let lhs = trim_space(slice(s, 0, epos))
  if not is_ident(lhs):
    return ""
  let rhs = strip_comment_depth0(trim_space(slice_from(s, epos + 1)))
  let ej = parse_expr_json(rhs)
  if str.len(ej) == 0:
    return ""
  return "{\"kind\":\"AssignStmt\",\"names\":[" + json_quote(lhs) + "],\"exprs\":[" + ej + "]}"

def parse_stmt_line(tline: str) -> str:
  let s = strip_comment_depth0(trim_space(tline))

  # let-stmt
  if starts_with(s, 0, "let "):
    return parse_let_line(s)

  # a := expr
  let apos = find_assign_depth0(s)
  if apos >= 0:
    return parse_assign_line_from_pos(s, apos)

  # a = expr  (plain assignment)
  let epos = find_eq_depth0(s)
  if epos >= 0:
    return parse_assign_eq_from_pos(s, epos)

  # return
  if starts_with(s, 0, "return"):
    let rest = trim_space(slice_from(s, 6))
    if str.len(rest) == 0:
      return "{\"kind\":\"ReturnStmt\",\"expr\":null}"
    let ej = parse_expr_json(rest)
    if str.len(ej) == 0:
      return "{\"kind\":\"ReturnStmt\",\"expr\":null}"
    return "{\"kind\":\"ReturnStmt\",\"expr\":" + ej + "}"

  # expression statement
  let ej = parse_expr_json(s)
  if str.len(ej) == 0:
    return ""
  return "{\"kind\":\"ExprStmt\",\"expr\":" + ej + "}"

# "let a[: Type]? = <expr>"
def parse_let_line(tline: str) -> str:
  let s = strip_comment_depth0(trim_space(tline))
  if not starts_with(s, 0, "let "):
    return ""

  let mut i = 3
  i := skip_hspace_str(s, i)

  # optional "mut"
  let mut is_mut = false
  if starts_with(s, i, "mut"):
    let after = i + 3
    let mut ok = true
    if after < str.len(s):
      let c = str.at(s, after)
      if not (c == 32 or c == 9 or c == 58):
        ok := false
    if ok:
      is_mut := true
      i := after
      i := skip_hspace_str(s, i)

  # ident
  let name = read_ident(s, i)
  if str.len(name) == 0:
    return ""
  i := i + str.len(name)
  i := skip_hspace_str(s, i)

  # optional ": Type"
  let mut ty = ""
  if i < str.len(s) and str.at(s, i) == 58: # ':'
    i := i + 1
    i := skip_hspace_str(s, i)
    let ty_raw = read_until_delim(s, i, 61)  # until '='
    ty := trim_space(ty_raw)
    i := i + str.len(ty_raw)

  i := skip_hspace_str(s, i)

  # expect '='
  i := skip_hspace_str(s, i)
  if not (i < str.len(s) and str.at(s, i) == 61):
    return ""
  i := i + 1
  i := skip_hspace_str(s, i)

  # RHS expr
  let rhs_txt = strip_comment_depth0(trim_space(slice_from(s, i)))
  let rhs_json = parse_expr_json(rhs_txt)
  if str.len(rhs_json) == 0:
    return ""

  # JSON for LetStmt (single bind)
  let bind_json = "{\"kind\":\"LetBind\",\"name\":" + json_quote(name) + ",\"type\":" + json_quote(ty) + "}"
  return "{\"kind\":\"LetStmt\",\"mutable\":" + boolstr(is_mut) + ",\"binds\":[" + bind_json + "],\"groupType\":\"\",\"values\":[" + rhs_json + "]}"

# ---------- expression parser (tiny) ----------

def parse_expr_json(s: str) -> str:
  let t = trim_space(s)
  if str.len(t) == 0:
    return ""

  # int literal
  if is_digits(t):
    return "{\"kind\":\"IntLit\",\"value\":\"" + t + "\"}"

  # depth-0 '+' binary
  let plus_pos = find_plus_depth0(t)
  if plus_pos >= 0:
    let lhs = trim_space(slice(t, 0, plus_pos))
    let rhs = trim_space(slice_from(t, plus_pos + 1))
    let lj = parse_expr_json(lhs)
    let rj = parse_expr_json(rhs)
    if str.len(lj) > 0 and str.len(rj) > 0:
      return "{\"kind\":\"BinaryExpr\",\"op\":\"+\",\"left\":" + lj + ",\"right\":" + rj + "}"

  # call: callee(args)
  let lp = find_char_depth0(t, 40)  # '('
  if lp >= 0 and ends_with_paren(t):
    let callee_txt = trim_space(slice(t, 0, lp))
    let args_txt = inside_parens(t, lp)
    let callee_json = parse_callee_json(callee_txt)
    if str.len(callee_json) == 0:
      return ""
    let args_json = parse_args_list(args_txt)
    return "{\"kind\":\"CallExpr\",\"callee\":" + callee_json + ",\"args\":[" + args_json + "]}"

  # dotted field: a.b
  let dotp = find_dot_depth0(t)
  if dotp >= 0:
    let left = trim_space(slice(t, 0, dotp))
    let right = trim_space(slice_from(t, dotp + 1))
    if is_ident(left) and is_ident(right):
      return "{\"kind\":\"FieldExpr\",\"x\":{\"kind\":\"IdentExpr\",\"name\":\"" + left + "\"},\"name\":\"" + right + "\"}"

  # bare ident
  if is_ident(t):
    return "{\"kind\":\"IdentExpr\",\"name\":\"" + t + "\"}"

  return ""

def parse_callee_json(s: str) -> str:
  let dotp = find_dot_depth0(s)
  if dotp >= 0:
    let left = trim_space(slice(s, 0, dotp))
    let right = trim_space(slice_from(s, dotp + 1))
    if is_ident(left) and is_ident(right):
      return "{\"kind\":\"FieldExpr\",\"x\":{\"kind\":\"IdentExpr\",\"name\":\"" + left + "\"},\"name\":\"" + right + "\"}"
    return ""
  if is_ident(s):
    return "{\"kind\":\"IdentExpr\",\"name\":\"" + s + "\"}"
  return ""

def parse_args_list(s: str) -> str:
  let items = split_args_depth(s)   # '|' separated synthetic list
  let mut out = ""
  let mut first = true
  let mut i = 0
  let m = list_len(items)
  while i < m:
    let it = list_get(items, i)
    let ej = parse_expr_json(trim_space(it))
    if str.len(ej) > 0:
      if not first:
        out := out + ","
      out := out + ej
      first := false
    i := i + 1
  return out

# ---------- tiny utilities for strings & scanning ----------

def is_line_start(src: str, pos: int) -> bool:
  if pos == 0:
    return true
  if pos > 0 and str.at(src, pos-1) == 10:
    return true
  return false

def skip_hspace(src: str, pos: int) -> int:
  let n = str.len(src)
  let mut j = pos
  let mut run = true
  while j < n and run:
    let c = str.at(src, j)
    if c == 32 or c == 9:
      j := j + 1
    else:
      run := false
  return j

def skip_hspace_str(s: str, pos: int) -> int:
  let n = str.len(s)
  let mut j = pos
  let mut run = true
  while j < n and run:
    let c = str.at(s, j)
    if c == 32 or c == 9:
      j := j + 1
    else:
      run := false
  return j

def advance_to_next_line(src: str, pos: int) -> int:
  let n = str.len(src)
  let mut j = pos
  let mut found = false
  while j < n and not found:
    let c = str.at(src, j)
    if c == 10:
      j := j + 1
      found := true
    else:
      j := j + 1
  return j

def line_head_char(s: str, pos: int) -> int:
  let n = str.len(s)
  if pos >= n:
    return 0
  let c = str.at(s, pos)
  if c == 10 or c == 13:
    return 0
  return c

def read_line(s: str, pos: int) -> str:
  let n = str.len(s)
  let mut j = pos
  let mut out = ""
  let mut run = true
  while j < n and run:
    let c = str.at(s, j)
    if c == 10 or c == 13:
      run := false
    else:
      out := out + str.from_code(c)
      j := j + 1
  return out

# identifier helpers

def read_ident(src: str, pos: int) -> str:
  let n = str.len(src)
  let mut j = pos
  if j >= n:
    return ""
  let c0 = str.at(src, j)
  if not is_ident_start(c0):
    return ""
  let mut s = ""
  s := s + str.from_code(c0)
  j := j + 1
  let mut run = true
  while j < n and run:
    let c = str.at(src, j)
    if is_ident_part(c):
      s := s + str.from_code(c)
      j := j + 1
    else:
      run := false
  return s

def is_ident_start(c: int) -> bool:
  if c == 95 or c == 36: # '_' or '$'
    return true
  if (c >= 65 and c <= 90) or (c >= 97 and c <= 122):
    return true
  return false

def is_ident_part(c: int) -> bool:
  if is_ident_start(c):
    return true
  if c >= 48 and c <= 57:
    return true
  return false

def is_ident(s: str) -> bool:
  let n = str.len(s)
  if n == 0:
    return false
  let c0 = str.at(s, 0)
  if not is_ident_start(c0):
    return false
  let mut i = 1
  let mut ok = true
  while i < n and ok:
    let c = str.at(s, i)
    if not is_ident_part(c):
      ok := false
    else:
      i := i + 1
  return ok

def is_digits(s: str) -> bool:
  let n = str.len(s)
  if n == 0:
    return false
  let mut i = 0
  let mut ok = true
  while i < n and ok:
    let c = str.at(s, i)
    if c < 48 or c > 57:
      ok := false
    else:
      i := i + 1
  return ok

# generic read/trim

def read_until_delim(src: str, pos: int, delim: int) -> str:
  let n = str.len(src)
  let mut j = pos
  let mut s = ""
  let mut done = false
  while j < n and not done:
    let c = str.at(src, j)
    if c == delim:
      done := true
    else:
      s := s + str.from_code(c)
      j := j + 1
  return s

def read_until_either(src: str, pos: int, d1: int, d2: int) -> str:
  let n = str.len(src)
  let mut j = pos
  let mut s = ""
  let mut done = false
  while j < n and not done:
    let c = str.at(src, j)
    if c == d1 or c == d2:
      done := true
    else:
      s := s + str.from_code(c)
      j := j + 1
  return s

def read_until_delims(src: str, pos: int, d1: int, d2: int, d3: int, d4: int, d5: int) -> str:
  let n = str.len(src)
  let mut j = pos
  let mut s = ""
  let mut done = false
  while j < n and not done:
    let c = str.at(src, j)
    if c == d1 or c == d2 or c == d3 or c == d4 or c == d5:
      done := true
    else:
      s := s + str.from_code(c)
      j := j + 1
  return s

def trim_space(s: str) -> str:
  let n = str.len(s)
  let mut lo = 0
  let mut hi = n
  let mut cont = true
  while lo < hi and cont:
    let c = str.at(s, lo)
    if c == 32 or c == 9:
      lo := lo + 1
    else:
      cont := false
  cont := true
  while hi > lo and cont:
    let c = str.at(s, hi - 1)
    if c == 32 or c == 9:
      hi := hi - 1
    else:
      cont := false
  let mut out = ""
  let mut i = lo
  while i < hi:
    out := out + str.from_code(str.at(s, i))
    i := i + 1
  return out

def starts_with(src: str, pos: int, pat: str) -> bool:
  let n = str.len(src)
  let m = str.len(pat)
  if pos + m > n:
    return false
  let mut k = 0
  let mut ok = true
  while k < m and ok:
    if str.at(src, pos + k) != str.at(pat, k):
      ok := false
    else:
      k := k + 1
  return ok

# ---------- small "list" helpers (use '|' as sentinel) ----------

# Split by commas at depth-0; join parts with sentinel '|'
def split_args_depth(s: str) -> str:
  let n = str.len(s)
  let mut i = 0
  let mut depth = 0
  let mut cur = ""
  let mut out = ""
  let mut first = true
  while i < n:
    let c = str.at(s, i)
    if c == 40:            # '('
      depth := depth + 1
      cur := cur + "("
      i := i + 1
    else:
      if c == 41 and depth > 0:  # ')'
        depth := depth - 1
        cur := cur + ")"
        i := i + 1
      else:
        if c == 44 and depth == 0:  # ','
          if not first:
            out := out + "|"       # sentinel
          out := out + cur
          cur := ""
          first := false
          i := i + 1
        else:
          cur := cur + str.from_code(c)
          i := i + 1
  # flush
  if str.len(cur) > 0 or first:
    if not first:
      out := out + "|"
    out := out + cur
  return out

# Count items separated by sentinel '|'
def list_len(s: str) -> int:
  let n = str.len(s)
  if n == 0:
    return 0
  let mut i = 0
  let mut cnt = 1
  while i < n:
    if str.at(s, i) == 124:  # '|'
      cnt := cnt + 1
    i := i + 1
  return cnt

# Extract idx-th item separated by '|'
def list_get(s: str, idx: int) -> str:
  let n = str.len(s)
  let mut i = 0
  let mut cur = 0
  let mut start = 0
  let mut end = 0
  let mut done = false
  while i <= n and not done:
    if i == n or str.at(s, i) == 124:  # '|'
      end := i
      if cur == idx:
        done := true
      else:
        cur := cur + 1
        start := i + 1
        end := start
      i := i + 1
    else:
      i := i + 1
  return slice(s, start, end)

# ---------- tiny substring helpers ----------

def slice(s: str, a: int, b: int) -> str:
  let n = str.len(s)
  let mut i = a
  let mut out = ""
  while i < b and i < n:
    out := out + str.from_code(str.at(s, i))
    i := i + 1
  return out

def slice_from(s: str, a: int) -> str:
  return slice(s, a, str.len(s))

# find '+' at depth-0
def find_plus_depth0(s: str) -> int:
  let n = str.len(s)
  let mut i = 0
  let mut depth = 0
  let mut pos = -1
  let mut done = false
  while i < n and not done:
    let c = str.at(s, i)
    if c == 40:
      depth := depth + 1
    else:
      if c == 41 and depth > 0:
        depth := depth - 1
      else:
        if c == 43 and depth == 0:
          pos := i
          done := true
    i := i + 1
  return pos

# find specific char at depth-0
def find_char_depth0(s: str, target: int) -> int:
  let n = str.len(s)
  let mut depth = 0
  let mut i = 0
  while i < n:
    let c = str.at(s, i)

    # check at current depth BEFORE changing it
    if depth == 0 and c == target:
      return i

    # now update depth
    if c == 40:                 # '('
      depth := depth + 1
    elif c == 41 and depth > 0: # ')'
      depth := depth - 1

    i := i + 1
  return -1

def find_dot_depth0(s: str) -> int:
  return find_char_depth0(s, 46)

def ends_with_paren(s: str) -> bool:
  let n = str.len(s)
  if n == 0:
    return false
  if str.at(s, n-1) == 41:
    return true
  return false

# inside first matching parens
def inside_parens(s: str, lp: int) -> str:
  let n = str.len(s)
  let mut i = lp + 1
  let mut depth = 1
  let mut out = ""
  let mut run = true
  while i < n and run:
    let c = str.at(s, i)
    if c == 40:
      depth := depth + 1
      out := out + "("
      i := i + 1
    else:
      if c == 41:
        depth := depth - 1
        if depth == 0:
          run := false
        else:
          out := out + ")"
        i := i + 1
      else:
        out := out + str.from_code(c)
        i := i + 1
  return out

# strip trailing comment at depth-0
def strip_comment_depth0(s: str) -> str:
  let n = str.len(s)
  let mut i = 0
  let mut depth = 0
  while i < n:
    let c = str.at(s, i)
    if c == 40:                # '('
      depth := depth + 1
    else:
      if c == 41 and depth > 0:  # ')'
        depth := depth - 1
      else:
        if c == 35 and depth == 0:  # '#'
          return trim_space(slice(s, 0, i))
    i := i + 1
  return s

# find ':=' at depth-0 (returns index of ':'); allows spaces between ':' and '='
def find_assign_depth0(s: str) -> int:
  let n = str.len(s)
  let mut i = 0
  let mut depth = 0
  let mut pos = -1
  let mut done = false
  while i < n and not done:
    let c = str.at(s, i)
    if c == 40:
      depth := depth + 1
    else:
      if c == 41 and depth > 0:
        depth := depth - 1
      else:
        if c == 58 and depth == 0:          # ':'
          # look ahead for '=' while skipping spaces/tabs
          let mut j = i + 1
          j := skip_hspace_str(s, j)
          if j < n and str.at(s, j) == 61:  # '='
            pos := i
            done := true
    i := i + 1
  return pos

# find '=' at depth-0 (plain assignment). Skips ':=' because caller checks it first.
def find_eq_depth0(s: str) -> int:
  let n = str.len(s)
  let mut i = 0
  let mut depth = 0
  let mut pos = -1
  let mut done = false
  while i < n and not done:
    let c = str.at(s, i)
    if c == 40:
      depth := depth + 1
    else:
      if c == 41 and depth > 0:
        depth := depth - 1
      else:
        if c == 61 and depth == 0:   # '='
          # avoid ':=' ambiguity (we check ':=' first anyway)
          if not (i > 0 and str.at(s, i-1) == 58):
            pos := i
            done := true
    i := i + 1
  return pos

# ---------- tuple helpers ----------

def make_tuple(a: str, b: int) -> str:
  return a + "@@@" + itoa(b)

def tuple_first(t: str) -> str:
  let sep = "@@@"
  let n = str.len(t)
  let m = str.len(sep)
  let mut i = 0
  let mut pos = -1
  let mut done = false
  while i + m <= n and not done:
    if slice(t, i, i + m) == sep:
      pos := i
      done := true
    else:
      i := i + 1
  if pos < 0:
    return t
  return slice(t, 0, pos)

def tuple_second(t: str) -> int:
  let sep = "@@@"
  let n = str.len(t)
  let m = str.len(sep)
  let mut i = 0
  let mut pos = -1
  let mut done = false
  while i + m <= n and not done:
    if slice(t, i, i + m) == sep:
      pos := i
      done := true
    else:
      i := i + 1
  if pos < 0:
    return 0
  let s = slice_from(t, pos + m)
  return atoi(s)

# ---------- small itoa/atoi/bool ----------

def itoa(x: int) -> str:
  if x == 0:
    return "0"
  let mut n = x
  let mut neg = false
  if n < 0:
    neg := true
    n := 0 - n
  let mut rev = ""
  while n > 0:
    let d = n % 10
    rev := rev + str.from_code(48 + d)
    n := n / 10
  let mut out = ""
  let mut i = str.len(rev) - 1
  while i >= 0:
    out := out + str.from_code(str.at(rev, i))
    if i == 0:
      i := 0
      i := -1
    else:
      i := i - 1
  if neg:
    out := "-" + out
  return out

def atoi(s: str) -> int:
  let n = str.len(s)
  let mut i = 0
  let mut sign = 1
  if n > 0 and str.at(s, 0) == 45:
    sign := -1
    i := 1
  let mut v = 0
  while i < n:
    let c = str.at(s, i)
    if c >= 48 and c <= 57:
      v := v * 10 + (c - 48)
    i := i + 1
  return v * sign

def boolstr(b: bool) -> str:
  if b:
    return "true"
  return "false"
