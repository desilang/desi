# Stage-0 parser stub (self-hosting path)
# Implements: parse_to_json(path: str) -> str
# Emits a valid AST JSON with kind="File", imports, and minimal FuncDecls.
# Note: No multi-return values are used; callers compute index advances.

def parse_to_json(path: str) -> str:
  let src = fs.read_all(path)
  let imports_json = scan_imports(src)
  let decls_json = scan_funcs(src)
  return "{\"kind\":\"File\",\"pkg\":null,\"imports\":[" + imports_json + "],\"decls\":[" + decls_json + "]}"

# ---------- imports ----------

# Finds lines like:  import util.math
# Returns JSON list payload:
# {"kind":"ImportDecl","path":"util.math"},...
def scan_imports(src: str) -> str:
  let n = str.len(src)
  let mut i = 0
  let mut out = ""
  let mut first = true
  while i < n:
    let mut handled = false
    if is_line_start(src, i):
      let j0 = skip_hspace(src, i)
      if starts_with(src, j0, "import "):
        let mut j = j0 + 7  # after "import "
        let name = read_until_delims(src, j, 10, 13, 35, 32, 9)  # until NL, CR, '#', space, tab
        if str.len(name) > 0:
          if not first:
            out := out + ","
          out := out + "{\"kind\":\"ImportDecl\",\"path\":\"" + name + "\"}"
          first := false
        j := j + str.len(name)
        i := advance_to_next_line(src, j)
        handled := true
    if not handled:
      i := i + 1
  return out

# ---------- funcs (headers only) ----------

# Recognizes:  def Name "(" params? ")" "->" Type ":"   (body ignored)
# Emits JSON objects:
# {"kind":"FuncDecl","name":"main","params":[...],"ret":"int","body":[]}
def scan_funcs(src: str) -> str:
  let n = str.len(src)
  let mut i = 0
  let mut out = ""
  let mut first = true

  while i < n:
    let mut handled = false
    if is_line_start(src, i):
      let j0 = skip_hspace(src, i)
      if starts_with(src, j0, "def "):
        let mut j = j0 + 4  # after "def "
        # name
        let name = read_ident(src, j)
        if str.len(name) > 0:
          j := j + str.len(name)
          j := skip_hspace(src, j)
          # "("
          if j < n and str.at(src, j) == 40:  # '('
            j := j + 1
            j := skip_hspace(src, j)
            # params
            let mut params_json = ""
            let mut params_first = true
            if not (j < n and str.at(src, j) == 41):  # not ')'
              let mut params_done = false
              while j < n and not params_done:
                # name
                let pn = read_ident(src, j)
                if str.len(pn) == 0:
                  params_done := true
                else:
                  j := j + str.len(pn)
                  j := skip_hspace(src, j)
                  if j < n and str.at(src, j) == 58:  # ':'
                    j := j + 1
                    j := skip_hspace(src, j)
                    # type until ',' or ')'
                    let pty = read_until_either(src, j, 44, 41)  # ',' or ')'
                    j := j + str.len(pty)
                    let pty_trim = trim_space(pty)
                    if not params_first:
                      params_json := params_json + ","
                    params_json := params_json + "{\"kind\":\"Param\",\"name\":\"" + pn + "\",\"type\":\"" + pty_trim + "\"}"
                    params_first := false
                    # if comma, consume and continue
                    if j < n and str.at(src, j) == 44:
                      j := j + 1
                      j := skip_hspace(src, j)
                    else:
                      params_done := true
                  else:
                    params_done := true
            # ")"
            if j < n and str.at(src, j) == 41:  # ')'
              j := j + 1
              j := skip_hspace(src, j)
              # "->"
              if j+1 < n and str.at(src, j) == 45 and str.at(src, j+1) == 62:  # '-' '>'
                j := j + 2
                j := skip_hspace(src, j)
                # return type until ':'
                let ret_ty = read_until_delim(src, j, 58)  # ':'
                let rtrim = trim_space(ret_ty)
                j := j + str.len(ret_ty)
                if j < n and str.at(src, j) == 58:
                  j := j + 1
                  # found a header; emit JSON object
                  if not first:
                    out := out + ","
                  out := out + "{\"kind\":\"FuncDecl\",\"name\":\"" + name + "\",\"params\":[" + params_json + "],\"ret\":\"" + rtrim + "\",\"body\":[]}"
                  first := false
                  # advance to next line; ignore body
                  i := advance_to_next_line(src, j)
                  handled := true
    if not handled:
      i := i + 1
  return out

# ---------- small helpers ----------

def is_line_start(src: str, pos: int) -> bool:
  if pos == 0:
    return true
  if pos > 0 and str.at(src, pos-1) == 10:
    return true
  return false

def skip_hspace(src: str, pos: int) -> int:
  let n = str.len(src)
  let mut j = pos
  let mut run = true
  while j < n and run:
    let c = str.at(src, j)
    if c == 32 or c == 9:  # space or tab
      j := j + 1
    else:
      run := false
  return j

def advance_to_next_line(src: str, pos: int) -> int:
  let n = str.len(src)
  let mut j = pos
  let mut found = false
  while j < n and not found:
    let c = str.at(src, j)
    if c == 10:
      j := j + 1
      found := true
    else:
      j := j + 1
  return j

# Reads identifier [A-Za-z_$][A-Za-z0-9_$]*, returns the text.
def read_ident(src: str, pos: int) -> str:
  let n = str.len(src)
  let mut j = pos
  if j >= n:
    return ""
  let c0 = str.at(src, j)
  if not is_ident_start(c0):
    return ""
  let mut s = ""
  s := s + str.from_code(c0)
  j := j + 1
  let mut run = true
  while j < n and run:
    let c = str.at(src, j)
    if is_ident_part(c):
      s := s + str.from_code(c)
      j := j + 1
    else:
      run := false
  return s

def is_ident_start(c: int) -> bool:
  if c == 95 or c == 36: # '_' or '$'
    return true
  if (c >= 65 and c <= 90) or (c >= 97 and c <= 122):
    return true
  return false

def is_ident_part(c: int) -> bool:
  if is_ident_start(c):
    return true
  if c >= 48 and c <= 57: # digit
    return true
  return false

# Read until a single delimiter codepoint (e.g., ':'). Returns the text (no delim).
def read_until_delim(src: str, pos: int, delim: int) -> str:
  let n = str.len(src)
  let mut j = pos
  let mut s = ""
  let mut done = false
  while j < n and not done:
    let c = str.at(src, j)
    if c == delim:
      done := true
    else:
      s := s + str.from_code(c)
      j := j + 1
  return s

# Read until any of two delimiters (e.g., ',' or ')'). Returns the text (no delim).
def read_until_either(src: str, pos: int, d1: int, d2: int) -> str:
  let n = str.len(src)
  let mut j = pos
  let mut s = ""
  let mut done = false
  while j < n and not done:
    let c = str.at(src, j)
    if c == d1 or c == d2:
      done := true
    else:
      s := s + str.from_code(c)
      j := j + 1
  return s

# Read until any of up to five delimiters (helper for imports).
def read_until_delims(src: str, pos: int, d1: int, d2: int, d3: int, d4: int, d5: int) -> str:
  let n = str.len(src)
  let mut j = pos
  let mut s = ""
  let mut done = false
  while j < n and not done:
    let c = str.at(src, j)
    if c == d1 or c == d2 or c == d3 or c == d4 or c == d5:
      done := true
    else:
      s := s + str.from_code(c)
      j := j + 1
  return s

# Poor-man's trim for spaces/tabs.
def trim_space(s: str) -> str:
  let n = str.len(s)
  let mut lo = 0
  let mut hi = n
  let mut cont = true
  while lo < hi and cont:
    let c = str.at(s, lo)
    if c == 32 or c == 9:
      lo := lo + 1
    else:
      cont := false
  cont := true
  while hi > lo and cont:
    let c = str.at(s, hi - 1)
    if c == 32 or c == 9:
      hi := hi - 1
    else:
      cont := false
  let mut out = ""
  let mut i = lo
  while i < hi:
    out := out + str.from_code(str.at(s, i))
    i := i + 1
  return out

# Simple prefix match
def starts_with(src: str, pos: int, pat: str) -> bool:
  let n = str.len(src)
  let m = str.len(pat)
  if pos + m > n:
    return false
  let mut k = 0
  let mut ok = true
  while k < m and ok:
    if str.at(src, pos + k) != str.at(pat, k):
      ok := false
    else:
      k := k + 1
  return ok
