# Minimal Stage-0 parser stub.
# Implements: parse_to_json(path: str) -> str
# Produces a valid AST JSON with kind="File" and populated "imports" array.

def parse_to_json(path: str) -> str:
  let src = fs.read_all(path)
  let imports_json = scan_imports(src)
  return "{\"kind\":\"File\",\"pkg\":null,\"imports\":[" + imports_json + "],\"decls\":[]}"

# scan_imports finds lines like:  import util.math
# Returns JSON list payload:
# {"kind":"ImportDecl","path":"util.math"},{"kind":"ImportDecl","path":"x.y"}
def scan_imports(src: str) -> str:
  let n = str.len(src)
  let mut i = 0
  let mut out = ""
  let mut first = true
  while i < n:
    let mut handled_line = false

    if starts_with(src, i, "import "):
      let mut j = i + 7  # len("import ")
      let mut name = ""

      # consume the import path until delimiter (space/tab/#/newline)
      let mut stop = false
      while j < n and not stop:
        let c = str.at(src, j)
        if c == 10 or c == 13 or c == 35 or c == 32 or c == 9:
          stop := true
        else:
          name := name + str.from_code(c)
          j := j + 1

      if str.len(name) > 0:
        if not first:
          out := out + ","
        out := out + "{\"kind\":\"ImportDecl\",\"path\":\"" + name + "\"}"
        first := false

      # advance i to start of next line (no break/continue)
      let mut found_nl = false
      i := j
      while i < n and not found_nl:
        let c2 = str.at(src, i)
        if c2 == 10:
          i := i + 1
          found_nl := true
        else:
          i := i + 1
      handled_line := true

    if not handled_line:
      i := i + 1
  return out

# starts_with checks if src at offset pos begins with pat.
def starts_with(src: str, pos: int, pat: str) -> bool:
  let n = str.len(src)
  let m = str.len(pat)
  if pos + m > n:
    return false
  let mut k = 0
  let mut ok = true
  while k < m and ok:
    if str.at(src, pos + k) != str.at(pat, k):
      ok := false
    else:
      k := k + 1
  return ok
