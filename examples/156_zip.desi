# Test zip() builtin for parallel iteration
# Tests: different list lengths, stops at shorter list

def main() -> int:
    # List 1: 3 elements
    let a_list: list[int] = [1, 2, 3]
    
    # List 2: 4 elements (longer - zip should stop at 3)
    let b_list: list[int] = [100, 200, 300, 400]
    
    print("Zip iteration (stops at shorter list):")
    for a: int, b: int in zip(a_list, b_list):
        print(a)
        print(b)
    
    print("Zip test passed!")
    return 0
