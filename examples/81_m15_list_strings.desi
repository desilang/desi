# Test: List of strings
def main() -> int:
    let mut names: list<str> = ["alice", "bob", "charlie"]
    names.append("david")
    
    let count: int = len(names)
    
    print(f"Count: {count}")
    
    # Verify correctness (should be 4)
    if count != 4:
        print("ERROR: count should be 4")
        return 1
        
    print("List strings test passed!")
    return 0

# EXPECTED_OUTPUT:
# Count: 4
# List strings test passed!
