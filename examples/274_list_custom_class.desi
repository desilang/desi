# Test list containing custom class instances

class Point:
    pub x: int
    pub y: int
    
    pub def __new__(self, x: int, y: int):
        self.x = x
        self.y = y

def main() -> int:
    print("Testing list of custom class:")
    
    # Create list of Points
    let points: list[Point] = []
    
    let p1 = Point(1, 2)
    let p2 = Point(3, 4)
    let p3 = Point(5, 6)
    
    points.append(p1)
    points.append(p2)
    points.append(p3)
    print("Appended 3 points")
    
    # Test length
    print("Length:")
    print(len(points))
    
    # Test iteration
    print("Iterating:")
    for p: Point in points:
        print(p.x)
    
    # Test indexing
    let first = points[0]
    print("First point x:")
    print(first.x)
    
    print("List of custom class test passed!")
    return 0

# EXPECTED_OUTPUT:
# Testing list of custom class:
# Appended 3 points
# Length:
# 3
# Iterating:
# 1
# 3
# 5
# First point x:
# 1
# List of custom class test passed!
