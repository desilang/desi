# M14: print() accepts a Display type directly.
#
# The old file called print(p) and carried "# EXPECTED: SKIP" on its last line
# — the harness only reads the first five, so it ran and asserted nothing. The
# default repr ends in an address, which cannot be asserted; going through
# to_str lets the shape be checked while print(p) still exercises the path.

struct Point:
	x: int
	y: int

# Point automatically gets default Display impl

def main():
	let p: Point = Point(x=10, y=20)
	# Exercises print's Display path; its address makes the line itself vary.
	print(p.to_str()[0:10])
	print(str(len(p.to_str()) > 10))

# EXPECTED_OUTPUT:
# <Point at 
# true
