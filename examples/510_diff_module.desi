# Test diff module
import diff

def main() -> int:
	let old_text = "line one\nline two\nline three\nline four"
	let new_text = "line one\nline TWO\nline three\nline five"

	# Check equality
	print(diff.equal("hello", "hello"))
	print(diff.equal("hello", "world"))

	# Count changes
	let changes = diff.count_changes(old_text, new_text)
	print(changes)

	# Line diff
	let d = diff.lines(old_text, new_text)
	print(d)

	print("diff ok")
	0

# EXPECTED_OUTPUT:
# true
# false
# 4
#   line one
# - line two
# + line TWO
#   line three
# - line four
# + line five
# 
# diff ok
