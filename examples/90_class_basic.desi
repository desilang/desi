# The simplest class: fields, constructed and read back.
#
# Used to construct a Note and return without touching a field.

class Note:
	pub mut title: str
	pub mut body: str

def main() -> int:
	let n = Note()
	n.title := "Shopping"
	n.body := "milk, bread"
	print(n.title)
	print(n.body)
	return 0

# EXPECTED_OUTPUT:
# Shopping
# milk, bread
