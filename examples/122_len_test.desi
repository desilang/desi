# Test len() on all collection types

def main():
    # String length
    let message = "Hello, Desi!"
    print("String length:")
    print(len(message))
    
    # List length
    let nums = [1, 2, 3, 4, 5]
    print("\nList length:")
    print(len(nums))
    
    # Dict length
    let mut scores = {"alice": 95}
    scores.insert("bob", 87)
    print("\nDict length:")
    print(len(scores))
    
    print("\nAll len() tests passed!")

# EXPECTED_OUTPUT:
# String length:
# 12
#
# List length:
# 5
#
# Dict length:
# 2
#
# All len() tests passed!
