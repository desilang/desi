# Test log module - all 5 severity levels with set_level filtering
import log

def main() -> int:
    # All levels in order (default level = DEBUG)
    log.debug("Loading config...")
    log.info("Application started")
    log.warn("Disk space low")
    log.error("Connection failed")
    log.fatal("Unrecoverable error")

    # Set to WARN — only WARN, ERROR, FATAL show
    log.set_level("WARN")
    log.debug("hidden debug")
    log.info("hidden info")
    log.warn("visible warn")
    log.error("visible error")

    # Restore to DEBUG
    log.set_level("DEBUG")
    log.info("Shutdown complete")
    0

# NOTE: Output contains ANSI color codes, visual verification only.
# Run manually: desic run examples/236_log_levels.desi
# Expected (visual):
#   [DEBUG] Loading config...        (cyan)
#   [INFO] Application started       (blue)
#   [WARN] Disk space low            (yellow, stderr)
#   [ERROR] Connection failed        (red, stderr)
#   [FATAL] Unrecoverable error      (bold red, stderr)
#   [WARN] visible warn              (after set_level("WARN"))
#   [ERROR] visible error
#   [INFO] Shutdown complete          (after set_level("DEBUG"))

# EXPECTED_OUTPUT:
# [36m[DEBUG][0m Loading config...
# [34m[INFO][0m Application started
# [33m[WARN][0m Disk space low
# [31m[ERROR][0m Connection failed
# [1;31m[FATAL][0m Unrecoverable error
# [33m[WARN][0m visible warn
# [31m[ERROR][0m visible error
# [34m[INFO][0m Shutdown complete
