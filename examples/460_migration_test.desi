# REQUIRES: database
# Needs: requires live PostgreSQL (set PG_USER, PG_PASS, PG_DB env vars)
# Test: db.makemigrations() + db.migrate() file-based migration (PostgreSQL)
# Requires PostgreSQL at 127.0.0.1:5432 (set PG_USER, PG_PASS, PG_DB env vars)
#
# Tests:
#   1. Register models via db module API
#   2. db.makemigrations() generates .desi migration file
#   3. db.migrate() applies the migration file → CREATE TABLE
#   4. Verify tables exist
#   5. Idempotent re-migrate
#   6. db.rollback() reverses last migration file
#   7. Re-migrate from file
#
# EXPECTED_OUTPUT:
# === Migration Test ===
# [makemigrations] Created pg_migrations/0001_initial.desi (1 operation(s)) [app: pg_migrations]
# makemigrations: 1
# [migrate] Applied 0001_initial.desi [pg_migrations] ✓
# [migrate] Applied 1 migration(s) for app 'pg_migrations'
# migrate #1: 1 applied
# mig_users exists: 1
# column count: 5
# [migrate] No pending migrations
# migrate #2 (should be 0): 0
# status retrieved: yes
# rows inserted: 2
# [rollback] Rolled back 0001_initial.desi [pg_migrations] (1 operation(s)) ✓
# rollback: 1 operations
# mig_users after rollback: 0
# [migrate] Applied 0001_initial.desi [pg_migrations] ✓
# [migrate] Applied 1 migration(s) for app 'pg_migrations'
# re-migrate: 1 applied
# === Done ===

import db
import env
import fs

def main() -> int:
	print("=== Migration Test ===")

	# Connect to PostgreSQL using env vars (no hardcoded creds)
	let host = env.get("PG_HOST", "127.0.0.1")
	let user = env.get("PG_USER", "postgres")
	let password = env.get("PG_PASS", "")
	let dbname = env.get("PG_DB", "postgres")
	db.connect("postgres", host, 5432, dbname, user, password)

	# Clean slate: drop test tables and migration tracking
	db.execute("DROP TABLE IF EXISTS mig_posts")
	db.execute("DROP TABLE IF EXISTS mig_users")
	db.execute("DROP TABLE IF EXISTS _desi_migrations")

	# Clean up old migration files
	let old_files = fs.list_dir("pg_migrations")
	for f in old_files:
		db.execute("SELECT 1")  # no-op; can't remove files easily

	# ============================================================
	# Step 1: Register a model using the db module API
	# ============================================================
	db.model("mig_users")
	db.auto_field("id")
	db.char_field("name", 100, 0, 0)
	db.char_field("email", 200, 0, 1)  # unique
	db.int_field("age", 0, 0, 0)
	db.bool_field("active", 1, 1, 0)  # default true

	# ============================================================
	# Step 2: makemigrations — generate .desi migration file
	# ============================================================
	let ops = db.makemigrations("pg_migrations")
	print(f"makemigrations: {str(ops)}")

	# ============================================================
	# Step 3: Migrate — apply .desi migration file
	# ============================================================
	let applied = db.migrate("pg_migrations")
	print(f"migrate #1: {str(applied)} applied")

	# ============================================================
	# Step 4: Verify table was created
	# ============================================================
	let exists_val = db.table_exists("mig_users")
	print(f"mig_users exists: {str(exists_val)}")

	# Verify columns by querying information_schema
	db.query("SELECT column_name FROM information_schema.columns WHERE table_name = 'mig_users' ORDER BY ordinal_position")
	let col_count = db.row_count()
	print(f"column count: {str(col_count)}")

	# ============================================================
	# Step 5: Test idempotency — running migrate again should be no-op
	# ============================================================
	let applied2 = db.migrate("pg_migrations")
	print(f"migrate #2 (should be 0): {str(applied2)}")

	# ============================================================
	# Step 6: Check migration status
	# ============================================================
	let status = db.migration_status("pg_migrations")
	print("status retrieved: yes")

	# ============================================================
	# Step 7: Insert data to verify table is functional
	# ============================================================
	db.execute("INSERT INTO mig_users (name, email, age, active) VALUES ('Alice', 'alice@test.com', 30, true)")
	db.execute("INSERT INTO mig_users (name, email, age, active) VALUES ('Bob', 'bob@test.com', 25, true)")
	db.query("SELECT COUNT(*) FROM mig_users")
	let count_str = db.get_value(0, 0)
	print(f"rows inserted: {count_str}")

	# ============================================================
	# Step 8: Rollback — reads rollback() from .desi file
	# ============================================================
	let rolled = db.rollback("pg_migrations")
	print(f"rollback: {str(rolled)} operations")

	# Verify table no longer exists
	let exists_after = db.table_exists("mig_users")
	print(f"mig_users after rollback: {str(exists_after)}")

	# ============================================================
	# Step 9: Re-migrate from file to restore
	# ============================================================
	let applied3 = db.migrate("pg_migrations")
	print(f"re-migrate: {str(applied3)} applied")

	# Clean up
	db.execute("DROP TABLE IF EXISTS mig_users")
	db.execute("DROP TABLE IF EXISTS _desi_migrations")
	db.close()

	print("=== Done ===")
	return 0
