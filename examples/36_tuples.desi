# Test Tuples - Complete

def main():
    # 1. Basic Tuple
    let tup: tuple[int, int] = (10, 20)
    print(tup[0])
    print(tup[1])

    # 2. Heterogeneous Tuple
    let tup2: tuple[int, str, bool] = (1, "hello", true)
    print(tup2[0])
    print(tup2[1])

    # 3. Single Element Tuple
    let tup3: tuple[int] = (42,)
    print(tup3[0])

    # 4. Explicit Type Annotation
    let tup4: tuple[int, int] = (100, 200)
    print(tup4[0])
    print(tup4[1])
