# Test Tuples - Complete

def main():
    # 1. Basic Tuple
    let tup: tuple[int, int] = (10, 20)
    print(tup[0])
    print(tup[1])

    # 2. Heterogeneous Tuple
    let tup2: tuple[int, str, bool] = (1, "hello", true)
    print(tup2[0])
    print(tup2[1])

    # Note: Single-element tuples are not supported (use the value directly)
    # This is by design - see DTE0050 error

    # 3. Explicit Type Annotation
    let tup4: tuple[int, int] = (100, 200)
    print(tup4[0])
    print(tup4[1])
