# Test strings module - core functionality
import strings

def main() -> int:
    # --- Case conversion ---
    print(strings.upper("hello world"))
    print(strings.lower("HELLO WORLD"))
    print(strings.capitalize("hELLO wORLD"))
    print(strings.title("the quick brown fox"))
    print(strings.swapcase("Hello World"))

    # --- Search ---
    print(strings.starts_with("hello", "hel"))
    print(strings.starts_with("hello", "xyz"))
    print(strings.ends_with("hello.desi", ".desi"))
    print(strings.index_of("hello world", "world"))
    print(strings.index_of("hello", "xyz"))
    print(strings.last_index_of("abcabc", "abc"))
    print(strings.contains("hello world", "world"))
    print(strings.count("mississippi", "ss"))

    # --- Transform ---
    print(strings.trim("  hello  "))
    print(strings.trim_left("  hello  "))
    print(strings.trim_right("  hello  "))
    print(strings.replace("foo bar foo", "foo", "baz"))
    print(strings.repeat("ab", 3))
    print(strings.reverse("hello"))
    print(strings.removeprefix("test_case", "test_"))
    print(strings.removesuffix("hello.desi", ".desi"))
    print(strings.pad_left("42", 5, "0"))
    print(strings.pad_right("hi", 5, "."))
    print(strings.center("hi", 9, "*"))
    print(strings.zfill("42", 5))
    print(strings.zfill("-42", 6))
    print(strings.char_at("hello", 0))
    print(strings.char_at("hello", -1))

    # --- Character checks ---
    print(strings.is_empty(""))
    print(strings.is_empty("x"))
    print(strings.is_digit("12345"))
    print(strings.is_digit("123a5"))
    print(strings.is_alpha("Hello"))
    print(strings.is_alnum("abc123"))
    print(strings.is_space("   "))
    print(strings.is_upper("ABC"))
    print(strings.is_lower("abc"))
    print(strings.is_ascii("hello"))
    print(strings.is_printable("hello"))

    # --- Desi extras ---
    print(strings.truncate("Hello World, this is Desi!", 10, "..."))
    print(strings.slugify("Hello World! This is Desi."))

    0

# EXPECTED_OUTPUT:
