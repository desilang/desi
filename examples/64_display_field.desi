# Test 2: Display with field access

struct Person:
    name: str
    age: int

impl Display for Person:
    def to_str(self) -> str:
        return self.name

def main() -> int:
    let p: Person = Person(name="Alice", age=30)
    let greeting: str = "Hello, " + p
    print(greeting)
    return 0

# EXPECTED_OUTPUT:
# Hello, Alice
