# Test print edge cases

def main() -> int:
    # Negative numbers  
    print(-5)
    print(-3.14)
    
    # Empty strings with separator
    print("", "", sep="-")
    
    # Large numbers
    print(999999999)
    
    # Zero
    print(0)
    print(0.0)
    
    # Boolean edge cases
    print(true, false)
    
    # Single char
    print("x")
    
    0

# EXPECTED_OUTPUT:
# -5
# -3.14
# -
# 999999999
# 0
# 0.0
# true false
# x
