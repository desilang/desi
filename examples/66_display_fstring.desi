# Test 4: Display with F-string

struct Person:
    name: str
    age: int

impl Display for Person:
    def to_str(self) -> str:
        return f"Person({self.name}, {self.age})"

def main() -> int:
    let p: Person = Person(name="Alice", age=30)
    let greeting: str = "Hello, " + p
    print(greeting)
    return 0

# EXPECTED_OUTPUT:
# Hello, Person(Alice, 30)
