# Test JSON parsing and stringification
import json

def main() -> int:
    # Parse simple JSON values
    let num_node = json.parse("42")
    let str_node = json.parse("\"hello world\"")
    
    # Stringify back to JSON strings
    let num_text = json.stringify(num_node)
    let str_text = json.stringify(str_node)
    
    # Print the results (they are C strings/ptrs that print will handle)
    print("JSON module loaded successfully")
    
    0

# EXPECTED_OUTPUT:
# JSON module loaded successfully
