# Test JSON parsing
import json

def main() -> int:
    # Parse JSON values
    let num_node = json.parse("42")
    let str_node = json.parse("\"hello world\"")
    let bool_node = json.parse("true")
    let null_node = json.parse("null")
    
    # Print confirmation
    print("JSON parse successful")
    
    0

