# Test Mutex type syntax with builtin function

def main() -> int:
    # Create a mutex protecting an integer
    let counter = mutex_new(0)
    
    # Lock the mutex and get the guard
    let guard = counter.lock()
    
    # Access the value through the guard
    let current = guard.value
    print(current)  # Should print 0
    
    # guard.value := 1  # TODO: Mutation via guard
    
    print("Mutex test done!")
    return 0
