# decimal arithmetic, with the results actually checked.
#
# Every line used to carry its answer in a trailing comment — `# 25.00`,
# `# 100.1499` — and the file returned 0 without comparing any of them. Exact
# arithmetic is the whole reason the type exists, so the values are what needs
# checking, not that the program runs.
#
# The comparisons stand in for printing: `str(decimal)` has no overload and
# print(decimal) emits nothing, so equality against a literal is how a decimal
# result can be pinned down today.

def main() -> int:
	let a: decimal = 19.99d
	let b: decimal = 5.01d

	# Exact, which is the point — binary floats cannot represent these.
	print(str(a + b == 25.00d))
	print(str(a - b == 14.98d))
	print(str(a * b == 100.1499d))

	# Division that does not terminate: bracket it instead.
	let quot: decimal = a / b
	print(str(quot > 3.99d))
	print(str(quot < 4.0d))

	let c: decimal = 100d
	let d: decimal = 3d
	let whole_div: decimal = c / d
	print(str(whole_div > 33d))
	print(str(whole_div < 34d))
	0

# EXPECTED_OUTPUT:
# true
# true
# true
# true
# true
# true
# true
