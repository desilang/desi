# Test generic constructor type inference with all types

class Box<T>:
    pub mut val: T

    pub def __new__(self, v: T):
        self.val = v

def main() -> int:
    # Test 1: Infer Box<int>
    let b1 = Box(42)
    print(b1.val)

    # Test 2: Infer Box<str>
    let b2 = Box("hello")
    print(b2.val)

    # Test 3: Infer Box<float>
    let b3 = Box(3.14)
    print(b3.val)

    # Test 4: Infer Box<bool>
    let b4 = Box(true)
    if b4.val:
        print("true")

    print("All constructor inference tests passed!")
    0

# EXPECTED_OUTPUT:
# 42
# hello
# 3.14
# true
# All constructor inference tests passed!
