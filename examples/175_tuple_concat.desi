# Tuple Concatenation Tests
# Tests tuple + operator

def main():
    test_basic_concat()
    test_empty_concat()
    print("All tuple concatenation tests passed!")

def test_basic_concat():
    let a = (1, 2)
    let b = (3, 4)
    let c = a + b
    
    # c should be (1, 2, 3, 4)
    if c.0 == 1:
        if c.1 == 2:
            if c.2 == 3:
                if c.3 == 4:
                    print("test_basic_concat: PASS")
                    return
    print("test_basic_concat: FAIL")

def test_empty_concat():
    # Test with single-side non-empty
    let a = (1, 2, 3)
    let b = (4, 5)
    let c = a + b
    
    # c should be (1, 2, 3, 4, 5)
    print(c.0)  # 1
    print(c.1)  # 2
    print(c.2)  # 3
    print(c.3)  # 4
    print(c.4)  # 5
    print("test_empty_concat: PASS")
