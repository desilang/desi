# Comprehensive time module test
# Tests all functions with edge cases inspired by Python, Rust, Elixir

from time import *


def test_core_functions():
    print("=== Core Time Functions ===")
    let ts = now()
    # The value moves every second; assert its shape instead.
    print("now() past 2020:", ts > 1.6e9)
    let utc = utc_now()
    print("utc_now() past 2020:", utc > 1.6e9)
    # monotonic() is non-decreasing; that is the whole contract. On Windows it
    # comes from GetTickCount64, whose resolution is about 15.6 ms — the same
    # choice CPython makes — so two calls astride a 10 ms sleep could land in
    # one tick and a strict "increasing" check flipped between runs.
    let m1 = monotonic()
    sleep(0.05)
    let m2 = monotonic()
    print("monotonic() non-decreasing:", m2 >= m1)
    let p1 = perf_counter()
    let p2 = perf_counter()
    print("perf_counter() precision:", p2 >= p1)
    print("")

def test_timezone_functions():
    print("=== Timezone Functions ===")
    # The offset, its name and the DST flag are all properties of the machine
    # this runs on. Printing them pinned the expectation to one timezone: baked
    # on a Central Daylight Time box, every UTC CI runner failed. Check what is
    # true anywhere instead.
    let offset = timezone_offset()
    print("timezone_offset() in range:", offset >= -43200 and offset <= 50400)
    let tz_name = timezone_name()
    print("timezone_name() non-empty:", len(tz_name) > 0)
    print("is_dst() stable:", is_dst() == is_dst())
    let local = now()
    let utc = to_utc(local)
    let back = to_local(utc)
    let round_trip_ok = diff(local, back) < 1.0
    print("to_utc/to_local round-trip:", round_trip_ok)
    print("")

def test_formatting():
    print("=== Formatting & Parsing ===")
    let date_str = strftime("%Y-%m-%d")
    # Today, so it changes daily and by the runner timezone: check the shape.
    print("strftime date len:", len(date_str))
    let time_str = strftime("%H:%M:%S")
    print("strftime len:", len(time_str))
    let ts = from_parts(2026, 1, 15, 10, 30, 45)
    let formatted = format_timestamp(ts, "%Y-%m-%d %H:%M:%S")
    print("format_timestamp(2026-01-15 10:30:45):", formatted)
    # Both of these are timezone-dependent instants, so compare the calendar
    # fields they round-trip to rather than the raw epoch second.
    let parsed = parse_time("2026-02-05", "%Y-%m-%d")
    print("parse_time(2026-02-05) ->", year_of(parsed), month_of(parsed), day_of(parsed))
    let built = from_parts(2026, 12, 25, 0, 0, 0)
    print("from_parts(2026,12,25) ->", year_of(built), month_of(built), day_of(built))
    let readable = ctime(now())
    print("ctime len > 20:", len(readable) > 20)
    let original = from_parts(2026, 6, 15, 14, 30, 0)
    let fmt = format_timestamp(original, "%Y-%m-%d %H:%M:%S")
    let reparsed = parse_time(fmt, "%Y-%m-%d %H:%M:%S")
    let rt_ok = diff(original, reparsed) < 1.0
    print("format->parse round-trip:", rt_ok)
    print("")

def test_current_components():
    print("=== Current Time Components ===")
    print("year() >= 2026:", year() >= 2026)
    print("month in range:", month() >= 1 and month() <= 12)
    print("day in range:", day() >= 1 and day() <= 31)
    print("hour in range:", hour() >= 0 and hour() <= 23)
    print("minute in range:", minute() >= 0 and minute() <= 59)
    print("second in range:", second() >= 0 and second() < 60)
    print("weekday in range:", weekday() >= 0 and weekday() <= 6)
    print("")

def test_timestamp_components():
    print("=== Timestamp Component Extraction ===")
    let ts = from_parts(2026, 7, 4, 12, 30, 45)
    print("year_of():", year_of(ts))
    print("month_of():", month_of(ts))
    print("day_of():", day_of(ts))
    print("hour_of():", hour_of(ts))
    print("minute_of():", minute_of(ts))
    print("second_of():", second_of(ts))
    print("weekday_of():", weekday_of(ts))
    print("day_of_year():", day_of_year(ts))
    print("")

def test_leap_year():
    print("=== Leap Year Tests ===")
    print("2024 leap:", is_leap_year(2024))
    print("2025 leap:", is_leap_year(2025))
    print("2000 leap:", is_leap_year(2000))
    print("1900 leap:", is_leap_year(1900))
    print("2100 leap:", is_leap_year(2100))
    print("")

def test_arithmetic():
    print("=== Arithmetic Functions ===")
    let base = from_parts(2026, 2, 5, 12, 0, 0)
    let plus_30s = add_seconds(base, 30.0)
    print("add_seconds(30):", second_of(plus_30s))
    let plus_15m = add_minutes(base, 15)
    print("add_minutes(15):", minute_of(plus_15m))
    let plus_3h = add_hours(base, 3)
    print("add_hours(3):", hour_of(plus_3h))
    let plus_7d = add_days(base, 7)
    print("add_days(7):", day_of(plus_7d))
    let minus_1d = add_days(base, -1)
    print("add_days(-1):", day_of(minus_1d))
    let ts1 = from_parts(2026, 2, 5, 12, 0, 0)
    let ts2 = from_parts(2026, 2, 5, 13, 0, 0)
    let d = diff(ts2, ts1)
    print("diff(1 hour):", d, "seconds")
    print("")

def test_humanize():
    print("=== Humanize Function ===")
    print("humanize(0):", humanize(0.0))
    print("humanize(1):", humanize(1.0))
    print("humanize(60):", humanize(60.0))
    print("humanize(3600):", humanize(3600.0))
    print("humanize(3665):", humanize(3665.0))
    print("humanize(86400):", humanize(86400.0))
    print("humanize(90061):", humanize(90061.0))
    print("")

def test_relative():
    print("=== Relative Time Function ===")
    let ts = now()
    let hour_ago = add_hours(ts, -1)
    print("1 hour ago:", relative(hour_ago))
    let day_ago = add_days(ts, -1)
    print("1 day ago:", relative(day_ago))
    # No slack: relative() rounds to the nearest unit, so a timestamp exactly
    # one hour out still reads "in 1 hour" even though it is measured a few
    # microseconds later and is really 3599.99 seconds away. Truncation used to
    # answer "in 59 minutes" here, and "in 6 days" below.
    let hour_later = add_hours(ts, 1)
    print("in 1 hour:", relative(hour_later))
    let week_later = add_days(ts, 7)
    print("in 7 days:", relative(week_later))
    print("")

def test_sleep_precision():
    print("=== Sleep Precision ===")
    let start = monotonic()
    sleep(0.1)
    let elapsed = monotonic() - start
    print("sleep(0.1) took >= 0.05s:", elapsed >= 0.05)
    let start2 = monotonic()
    sleep(0.25)
    let elapsed2 = monotonic() - start2
    print("sleep(0.25) took >= 0.15s:", elapsed2 >= 0.15)
    print("")

def test_stopwatch():
    print("=== Stopwatch & Duration ===")
    
    # Test 1: Factory function returns correct type
    print("Test 1: stopwatch() factory function")
    let sw1 = stopwatch()
    sleep(0.05)
    print("Stopwatch created successfully")
    
    # Test 2: Silent stopwatch factory
    print("Test 2: stopwatch_silent() factory")
    let sw2 = stopwatch_silent()
    sleep(0.01)
    print("Silent stopwatch created successfully")
    
    # Test 3: Manual Stopwatch with methods
    print("Test 3: Manual Stopwatch construction")
    let sw3 = Stopwatch()
    sw3.start()
    sleep(0.03)
    print("Manual sw elapsed non-empty:", len(sw3.elapsed_str()) > 0)
    
    # Test 4: create_duration factory function
    print("Test 4: create_duration factory")
    let d1 = create_duration(120.5)
    print("Duration created successfully")
    
    # Test 5: Duration.from_seconds static method
    print("Test 5: Duration.from_seconds")
    let d2 = Duration.from_seconds(3661.0)
    print("Duration 1h1m1s:", d2)
    
    # Test 6: Duration.from_minutes
    print("Test 6: Duration.from_minutes")
    let d3 = Duration.from_minutes(90.0)
    print("Duration 90 minutes:", d3)
    
    # Test 7: Duration.from_hours
    print("Test 7: Duration.from_hours")
    let d4 = Duration.from_hours(2.5)
    print("Duration 2.5 hours:", d4)
    
    print("=== Stopwatch Tests Complete ===")

def main():
    print("========================================")
    print("   Desi Time Module - Complete Test")
    print("========================================")
    print("")
    test_core_functions()
    test_timezone_functions()
    test_formatting()
    test_current_components()
    test_timestamp_components()
    test_leap_year()
    test_arithmetic()
    test_humanize()
    test_relative()
    test_sleep_precision()
    test_stopwatch()
    print("========================================")
    print("All time module tests complete!")
    print("========================================")

main()

