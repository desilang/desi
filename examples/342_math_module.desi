import math

# Comprehensive math module test with edge cases
# Inspired by Python math, Rust std::f64, Go math, and GLSL
#
# EXPECTED_OUTPUT:
# === Constants ===
# PI: 3.14159265358979
# E: 2.71828182845905
# TAU: 6.28318530717959
# === Trig ===
# sin(PI/2): 1.0
# cos(0): 1.0
# tan(PI/4) approx 1: true
# atan2(1,1): 0.785398163397448
# sinh(0): 0.0
# cosh(0): 1.0
# tanh(0): 0.0
# === Trig Edge Cases ===
# sin(0): 0.0
# cos(PI): -1.0
# asin(1) = PI/2: true
# acos(0) = PI/2: true
# === Power ===
# sqrt(144): 12.0
# sqrt(0): 0.0
# cbrt(27): 3.0
# cbrt(-8): -2.0
# pow(2,10): 1024.0
# pow(0,0): 1.0
# exp(0): 1.0
# log(E): 1.0
# log2(1024): 10.0
# log10(1000): 3.0
# hypot(3,4): 5.0
# === Rounding ===
# floor(3.7): 3.0
# floor(-3.2): -4.0
# ceil(3.2): 4.0
# ceil(-3.7): -3.0
# round(3.5): 4.0
# round(2.5): 2.0
# round(-2.5): -2.0
# round(-3.5): -4.0
# round_away(2.5): 3.0
# round_away(-2.5): -3.0
# round_to(3.14159, 2): 3.14
# round_to(2.675, 2): 2.68
# round_to(1234.5, -2): 1200.0
# round_to(0.5, 0): 0.0
# trunc(3.9): 3.0
# trunc(-3.9): -3.0
# fmod(10,3): 1.0
# fmod(-10,3): -1.0
# === Utility ===
# abs(-42.5): 42.5
# abs(0): 0.0
# abs_int(-99): 99
# fmin(3,5): 3.0
# fmax(3,5): 5.0
# clamp(-5,0,100): 0.0
# clamp(150,0,100): 100.0
# clamp(50,0,100): 50.0
# sign(-7): -1.0
# sign(0): 0.0
# sign(42): 1.0
# === Float Checks ===
# is_nan(NAN): true
# is_nan(0): false
# is_inf(INF): true
# is_inf(-INF): true
# is_inf(0): false
# is_finite(42): true
# is_finite(INF): false
# is_finite(NAN): false
# === Conversion ===
# radians(180) = PI: true
# radians(90) = PI/2: true
# degrees(PI) = 180: true
# === Random ===
# seeded randint in [1,10]: true
# different randoms: true
# === Legacy ===
# add(2,3): 5
# sub(10,4): 6
# === Unique: Interpolation ===
# lerp(0,10,0.5): 5.0
# lerp(0,10,0): 0.0
# lerp(0,10,1): 10.0
# inverse_lerp(0,100,25): 0.25
# map_range(50,0,100,0,1): 0.5
# map_range(0,0,100,-1,1): -1.0
# === Unique: Float Comparison ===
# approx_eq(0.1+0.2, 0.3): true
# approx_eq(1.0, 2.0): false
# === Unique: Smoothstep & Step ===
# smoothstep at edge0: 0.0
# smoothstep at edge1: 1.0
# smoothstep midpoint: 0.5
# step(0.5, 0.3): 0.0
# step(0.5, 0.7): 1.0
# === Unique: Wrap ===
# wrap(370, 0, 360): 10.0
# wrap(-30, 0, 360): 330.0
# wrap(0, 0, 360): 0.0
# wrap_int(25, 0, 24): 1
# === Unique: Number Theory ===
# gcd(12,8): 4
# gcd(17,13): 1
# gcd(0,5): 5
# lcm(4,6): 12
# lcm(7,3): 21
# factorial(0): 1
# factorial(1): 1
# factorial(5): 120
# factorial(10): 3628800
# fib(0): 0
# fib(1): 1
# fib(10): 55
# fib(20): 6765
# All math tests passed!

def main() -> int:
    # --- Constants ---
    print("=== Constants ===")
    print(f"PI: {math.PI()}")
    print(f"E: {math.E()}")
    print(f"TAU: {math.TAU()}")

    # --- Trigonometry ---
    print("=== Trig ===")
    print(f"sin(PI/2): {math.sin(math.PI() / 2.0)}")
    print(f"cos(0): {math.cos(0.0)}")
    let tan_check = math.approx_eq(math.tan(math.PI() / 4.0), 1.0, 0.000001)
    print(f"tan(PI/4) approx 1: {tan_check}")
    print(f"atan2(1,1): {math.atan2(1.0, 1.0)}")
    print(f"sinh(0): {math.sinh(0.0)}")
    print(f"cosh(0): {math.cosh(0.0)}")
    print(f"tanh(0): {math.tanh(0.0)}")

    # --- Trig Edge Cases ---
    print("=== Trig Edge Cases ===")
    print(f"sin(0): {math.sin(0.0)}")
    print(f"cos(PI): {math.cos(math.PI())}")
    let asin_check = math.approx_eq(math.asin(1.0), math.PI() / 2.0, 0.000001)
    print(f"asin(1) = PI/2: {asin_check}")
    let acos_check = math.approx_eq(math.acos(0.0), math.PI() / 2.0, 0.000001)
    print(f"acos(0) = PI/2: {acos_check}")

    # --- Power & Log ---
    print("=== Power ===")
    print(f"sqrt(144): {math.sqrt(144.0)}")
    print(f"sqrt(0): {math.sqrt(0.0)}")
    print(f"cbrt(27): {math.cbrt(27.0)}")
    print(f"cbrt(-8): {math.cbrt(-8.0)}")
    print(f"pow(2,10): {math.pow(2.0, 10.0)}")
    print(f"pow(0,0): {math.pow(0.0, 0.0)}")
    print(f"exp(0): {math.exp(0.0)}")
    let log_check = math.approx_eq(math.log(math.E()), 1.0, 0.000001)
    print(f"log(E): {math.log(math.E())}")
    print(f"log2(1024): {math.log2(1024.0)}")
    print(f"log10(1000): {math.log10(1000.0)}")
    print(f"hypot(3,4): {math.hypot(3.0, 4.0)}")

    # --- Rounding (including banker's rounding edge cases) ---
    print("=== Rounding ===")
    print(f"floor(3.7): {math.floor(3.7)}")
    print(f"floor(-3.2): {math.floor(-3.2)}")
    print(f"ceil(3.2): {math.ceil(3.2)}")
    print(f"ceil(-3.7): {math.ceil(-3.7)}")
    print(f"round(3.5): {math.round(3.5)}")
    print(f"round(2.5): {math.round(2.5)}")
    print(f"round(-2.5): {math.round(-2.5)}")
    print(f"round(-3.5): {math.round(-3.5)}")
    print(f"round_away(2.5): {math.round_away(2.5)}")
    print(f"round_away(-2.5): {math.round_away(-2.5)}")
    print(f"round_to(3.14159, 2): {math.round_to(3.14159, 2)}")
    print(f"round_to(2.675, 2): {math.round_to(2.675, 2)}")
    print(f"round_to(1234.5, -2): {math.round_to(1234.5, -2)}")
    print(f"round_to(0.5, 0): {math.round_to(0.5, 0)}")
    print(f"trunc(3.9): {math.trunc(3.9)}")
    print(f"trunc(-3.9): {math.trunc(-3.9)}")
    print(f"fmod(10,3): {math.fmod(10.0, 3.0)}")
    print(f"fmod(-10,3): {math.fmod(-10.0, 3.0)}")

    # --- Utility ---
    print("=== Utility ===")
    print(f"abs(-42.5): {math.abs(-42.5)}")
    print(f"abs(0): {math.abs(0.0)}")
    print(f"abs_int(-99): {math.abs_int(-99)}")
    print(f"fmin(3,5): {math.fmin(3.0, 5.0)}")
    print(f"fmax(3,5): {math.fmax(3.0, 5.0)}")
    print(f"clamp(-5,0,100): {math.clamp(-5.0, 0.0, 100.0)}")
    print(f"clamp(150,0,100): {math.clamp(150.0, 0.0, 100.0)}")
    print(f"clamp(50,0,100): {math.clamp(50.0, 0.0, 100.0)}")
    print(f"sign(-7): {math.sign(-7.0)}")
    print(f"sign(0): {math.sign(0.0)}")
    print(f"sign(42): {math.sign(42.0)}")

    # --- Float Checks ---
    print("=== Float Checks ===")
    print(f"is_nan(NAN): {math.is_nan(math.NAN())}")
    print(f"is_nan(0): {math.is_nan(0.0)}")
    print(f"is_inf(INF): {math.is_inf(math.INF())}")
    let neg_inf = 0.0 - math.INF()
    print(f"is_inf(-INF): {math.is_inf(neg_inf)}")
    print(f"is_inf(0): {math.is_inf(0.0)}")
    print(f"is_finite(42): {math.is_finite(42.0)}")
    print(f"is_finite(INF): {math.is_finite(math.INF())}")
    print(f"is_finite(NAN): {math.is_finite(math.NAN())}")

    # --- Conversion ---
    print("=== Conversion ===")
    let rad180 = math.approx_eq(math.radians(180.0), math.PI(), 0.000001)
    print(f"radians(180) = PI: {rad180}")
    let rad90 = math.approx_eq(math.radians(90.0), math.PI() / 2.0, 0.000001)
    print(f"radians(90) = PI/2: {rad90}")
    let deg_pi = math.approx_eq(math.degrees(math.PI()), 180.0, 0.000001)
    print(f"degrees(PI) = 180: {deg_pi}")

    # --- Random ---
    print("=== Random ===")
    math.seed(42)
    let r1 = math.randint(1, 10)
    let in_range = r1 >= 1 and r1 <= 10
    print(f"seeded randint in [1,10]: {in_range}")
    let r2 = math.random()
    let r3 = math.random()
    # Two random floats should almost certainly differ
    let diff_check = not math.approx_eq(r2, r3, 0.0000001)
    print(f"different randoms: {diff_check}")

    # --- Legacy functions ---
    print("=== Legacy ===")
    print(f"add(2,3): {math.add(2, 3)}")
    print(f"sub(10,4): {math.sub(10, 4)}")

    # --- Unique: Interpolation ---
    print("=== Unique: Interpolation ===")
    print(f"lerp(0,10,0.5): {math.lerp(0.0, 10.0, 0.5)}")
    print(f"lerp(0,10,0): {math.lerp(0.0, 10.0, 0.0)}")
    print(f"lerp(0,10,1): {math.lerp(0.0, 10.0, 1.0)}")
    print(f"inverse_lerp(0,100,25): {math.inverse_lerp(0.0, 100.0, 25.0)}")
    print(f"map_range(50,0,100,0,1): {math.map_range(50.0, 0.0, 100.0, 0.0, 1.0)}")
    print(f"map_range(0,0,100,-1,1): {math.map_range(0.0, 0.0, 100.0, -1.0, 1.0)}")

    # --- Unique: Float Comparison ---
    print("=== Unique: Float Comparison ===")
    # Classic floating point gotcha: 0.1 + 0.2 != 0.3
    let sum_close = math.approx_eq(0.1 + 0.2, 0.3, 0.000000001)
    print(f"approx_eq(0.1+0.2, 0.3): {sum_close}")
    let not_close = math.approx_eq(1.0, 2.0, 0.000000001)
    print(f"approx_eq(1.0, 2.0): {not_close}")

    # --- Unique: Smoothstep & Step ---
    print("=== Unique: Smoothstep & Step ===")
    print(f"smoothstep at edge0: {math.smoothstep(0.0, 1.0, 0.0)}")
    print(f"smoothstep at edge1: {math.smoothstep(0.0, 1.0, 1.0)}")
    print(f"smoothstep midpoint: {math.smoothstep(0.0, 1.0, 0.5)}")
    print(f"step(0.5, 0.3): {math.step(0.5, 0.3)}")
    print(f"step(0.5, 0.7): {math.step(0.5, 0.7)}")

    # --- Unique: Wrap ---
    print("=== Unique: Wrap ===")
    print(f"wrap(370, 0, 360): {math.wrap(370.0, 0.0, 360.0)}")
    print(f"wrap(-30, 0, 360): {math.wrap(-30.0, 0.0, 360.0)}")
    print(f"wrap(0, 0, 360): {math.wrap(0.0, 0.0, 360.0)}")
    print(f"wrap_int(25, 0, 24): {math.wrap_int(25, 0, 24)}")

    # --- Unique: Number Theory ---
    print("=== Unique: Number Theory ===")
    print(f"gcd(12,8): {math.gcd(12, 8)}")
    print(f"gcd(17,13): {math.gcd(17, 13)}")
    print(f"gcd(0,5): {math.gcd(0, 5)}")
    print(f"lcm(4,6): {math.lcm(4, 6)}")
    print(f"lcm(7,3): {math.lcm(7, 3)}")
    print(f"factorial(0): {math.factorial(0)}")
    print(f"factorial(1): {math.factorial(1)}")
    print(f"factorial(5): {math.factorial(5)}")
    print(f"factorial(10): {math.factorial(10)}")
    print(f"fib(0): {math.fib(0)}")
    print(f"fib(1): {math.fib(1)}")
    print(f"fib(10): {math.fib(10)}")
    print(f"fib(20): {math.fib(20)}")

    print("All math tests passed!")
    return 0
