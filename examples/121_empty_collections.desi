# Example 121: Empty Collections - Simplified to avoid compiler bug

def main():
    # Test with non-empty initialization
    let mut nums = [42]
    print("List with one element:")
    print(nums)
    
    nums.append(420)
    print("After append:")
    print(nums)
    
    # Dict test
    let mut scores = {"alice": 95}
    print("\nDict with one entry:")
    print(scores)
    
    scores.insert("bob", 87)
    print("After insert:")
    print(scores)
    
    print("\nCollections work!")
