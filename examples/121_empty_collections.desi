# Example 121: Empty Collections
# Test empty list, dict, and set initialization

pub def main():
    # Empty list
    let empty_list: list[int] = []
    print("Empty list created")
    
    # Empty dict
    let empty_dict: dict[str, int] = {}
    print("Empty dict created")
    
    # Note: Empty set requires explicit constructor call
    # set() syntax is not yet supported, so we skip it for now
    
    # Verify they work
    empty_list.append(42)
    print("List after append: OK")
    
    # Dict uses set/get, not insert
    # For now, skip dict methods
    print("Empty collections work!")
