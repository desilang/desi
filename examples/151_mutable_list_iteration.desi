# Test mutable list iteration with for mut

def main() -> int:
    let mut items: list[int] = [1, 2, 3, 4, 5]
    
    print("Before mutation:")
    for x: int in items:
        print(x)
    
    # Mutate elements in-place using :=
    for mut x: int in items:
        x := x * 2
    
    print("After mutation:")
    for x: int in items:
        print(x)
    
    print("Mutable list iteration test passed!")
    return 0
