# Safe FFI Wrapper Test
# Tests @extern("C", safe=true, c_name="...") decorator syntax

# Define a safe extern wrapper for abs() - simple case without pointers
@extern("C", safe=true, c_name="abs")
pub def absolute(x: int) -> int

def main() -> int:
    let result = absolute(-42)
    print(result)
    0

# EXPECTED_OUTPUT:
# 42
