# Test math module - is_nan, is_inf, is_finite
import math

def main() -> int:
    # Test is_inf - large number multiplication overflows to infinity
    let big = 1.0e308 * 10.0
    print("Testing math.is_inf:")
    if math.is_inf(big):
        print("  1.0e308 * 10.0 = inf: true")
    
    # Test is_finite - normal numbers are finite
    let normal = 3.14159
    print("Testing math.is_finite:")
    if math.is_finite(normal):
        print("  3.14159 is finite: true")
    
    # is_inf returns false for finite numbers
    if not math.is_inf(normal):
        print("  3.14159 is not inf: true")
    
    # Infinity is not finite
    if not math.is_finite(big):
        print("  inf is not finite: true")
    
    print("math module tests passed")
    0

# EXPECTED_OUTPUT:
# Testing math.is_inf:
#   1.0e308 * 10.0 = inf: true
# Testing math.is_finite:
#   3.14159 is finite: true
#   3.14159 is not inf: true
#   inf is not finite: true
# math module tests passed
