# Test various edge cases for abstract classes

class Shape:
    @abstract
    pub def area(self) -> float:
        return 0.0
    
    @abstract
    pub def perimeter(self) -> float:
        return 0.0
    
    @abstract
    pub def name(self) -> str:
        return "shape"

# VALID: Implements all abstract methods with correct types
class Circle(Shape):
    pub mut radius: float
    
    pub def area(self) -> float:
        return 3.14159 * self.radius * self.radius
    
    pub def perimeter(self) -> float:
        return 2.0 * 3.14159 * self.radius
    
    pub def name(self) -> str:
        return "circle"

# VALID: Another correct implementation
class Rectangle(Shape):
    pub mut width: float
    pub mut height: float
    
    pub def area(self) -> float:
        return self.width * self.height
    
    pub def perimeter(self) -> float:
        return 2.0 * (self.width + self.height)
    
    pub def name(self) -> str:
        return "rectangle"

def main() -> int:
	# The old version computed both areas and both names into locals and threw
	# them away, so an override that never took effect looked identical to one
	# that did.
	let c = Circle()
	c.radius := 5.0

	let r = Rectangle()
	r.width := 10.0
	r.height := 20.0

	print(c.name() + " area " + str(c.area()))
	print(c.name() + " perimeter " + str(c.perimeter()))
	print(r.name() + " area " + str(r.area()))
	print(r.name() + " perimeter " + str(r.perimeter()))
	return 0

# EXPECTED_OUTPUT:
# circle area 78.53975
# circle perimeter 31.4159
# rectangle area 200.0
# rectangle perimeter 60.0
