# EXPECTED: COMPILE_ERROR
# Test: Non-exhaustive match should trigger warning
enum Color:
    Red: none
    Green: none
    Blue: none

def main():
    let c = Color.Red()
    
    # Non-exhaustive match (missing Blue)
    match c:
        Color.Red(): print("Red")
        Color.Green(): print("Green")
        # Missing Blue - should trigger DW0007 warning

