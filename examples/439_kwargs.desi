# Example 439: **kwargs support
# Demonstrates Python-style keyword arguments with dict iteration
# EXPECTED_OUTPUT:
# === str kwargs ===
# str kwargs received
# === Any kwargs (mixed types) ===
# any kwargs received
# === Positional + kwargs ===
# table: users
# insert kwargs received
# === Dict key iteration ===
# name
# email
# === Dict items iteration ===
# name = Alice
# email = alice@test.com

def show_str_kwargs(**opts: str) -> int:
	print("str kwargs received")
	0

def show_any_kwargs(**opts: Any) -> int:
	print("any kwargs received")
	0

def insert_with_table(table: str, **fields: Any) -> int:
	print("table: " + table)
	print("insert kwargs received")
	0

def show_keys(**fields: str) -> int:
	for key in fields:
		print(key)
	0

def show_items(**fields: str) -> int:
	for key, value in fields.items():
		print(key + " = " + value)
	0

def main() -> int:
	print("=== str kwargs ===")
	show_str_kwargs(name="Alice", email="alice@test.com")

	print("=== Any kwargs (mixed types) ===")
	show_any_kwargs(name="Alice", age=30, score=3.14, active=true)

	print("=== Positional + kwargs ===")
	insert_with_table("users", name="Alice", age=30, email="alice@test.com")

	print("=== Dict key iteration ===")
	show_keys(name="Alice", email="alice@test.com")

	print("=== Dict items iteration ===")
	show_items(name="Alice", email="alice@test.com")

	0
