# M14: Traits and Impls
#
# The old version computed p.to_str() into a local and discarded it, with a
# comment saying it was only there to check that this parses. Whether the impl
# was the method actually dispatched to went unchecked.

trait Display:
	"""
	A trait for things that can be converted to a string.
	"""
	def to_str() -> str

struct Point:
	x: int
	y: int

impl Display for Point:
	def to_str() -> str:
		return "Point"

def main():
	let p: Point = Point(x=10, y=20)
	let s: str = p.to_str()
	print(s)

# EXPECTED_OUTPUT:
# Point
