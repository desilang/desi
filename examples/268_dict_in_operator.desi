# Test dict with generic key types
# Phase 1: int, str, bool, float keys

def main() -> int:
    print("Testing generic dict keys:")
    
    # Test 1: String keys (baseline - already worked)
    let str_dict: dict[str, int] = {"apple": 1, "banana": 2, "cherry": 3}
    print("Test 1: String keys")
    if "apple" in str_dict:
        print("  apple: found")
    else:
        print("  apple: NOT found")
    
    if "orange" in str_dict:
        print("  orange: found")
    else:
        print("  orange: NOT found")
    
    # Test 2: Integer keys
    let int_dict: dict[int, str] = {1: "one", 2: "two", 3: "three"}
    print("Test 2: Integer keys")
    if 2 in int_dict:
        print("  2: found")
    else:
        print("  2: NOT found")
    
    if 99 in int_dict:
        print("  99: found")
    else:
        print("  99: NOT found")
    
    # Test 3: Boolean keys
    let bool_dict: dict[bool, str] = {true: "yes", false: "no"}
    print("Test 3: Boolean keys")
    if true in bool_dict:
        print("  true: found")
    else:
        print("  true: NOT found")
    
    if false in bool_dict:
        print("  false: found")
    else:
        print("  false: NOT found")
    
    # Test 4: Float keys
    let float_dict: dict[float, str] = {1.5: "one-half", 2.5: "two-half", 3.14: "pi"}
    print("Test 4: Float keys")
    if 3.14 in float_dict:
        print("  3.14: found")
    else:
        print("  3.14: NOT found")
    
    if 9.99 in float_dict:
        print("  9.99: found")
    else:
        print("  9.99: NOT found")
    
    # Test 5: Empty dict
    let empty_dict: dict[int, str] = {}
    print("Test 5: Empty dict")
    if 1 in empty_dict:
        print("  1: found")
    else:
        print("  1: NOT found")
    
    print("All generic dict key tests passed!")
    return 0

# EXPECTED_OUTPUT:
# Testing generic dict keys:
# Test 1: String keys
#   apple: found
#   orange: NOT found
# Test 2: Integer keys
#   2: found
#   99: NOT found
# Test 3: Boolean keys
#   true: found
#   false: found
# Test 4: Float keys
#   3.14: found
#   9.99: NOT found
# Test 5: Empty dict
#   1: NOT found
# All generic dict key tests passed!
