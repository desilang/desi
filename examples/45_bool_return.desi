# Test bool return type

def is_even(n: int) -> bool:
    let remainder: int = n % 2
    return remainder == 0

def main():
    print("Testing bool return")
    let result: bool = is_even(4)
    if result:
        print("4 is even")
    
    let result2: bool = is_even(5)
    if result2:
        print("5 is even - WRONG")
    else:
        print("5 is odd")
    
    print("Bool return works!")
