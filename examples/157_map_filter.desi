def main() -> int:
	# Test map() with lambda
	let nums: list[int] = [1, 2, 3, 4, 5]
	let doubled: list[int] = map(lambda x: x * 2, nums)
	print(doubled)  # Expected: [2, 4, 6, 8, 10]
	
	# Test filter() with lambda
	let evens: list[int] = filter(lambda x: (x % 2) == 0, nums)
	print(evens)  # Expected: [2, 4]
	
	# Test with named function (via str builtin)
	let strs: list[str] = map(str, nums)
	print(strs)  # Expected: ["1", "2", "3", "4", "5"]
	
	0
