# Test Option<T> type

# Option<T> = Some(T) | Nothing

def main() -> int:
    # Test Option<int>
    let x: Option<int> = Option.Some(42)
    
    match x:
        Option.Some(v): print(f"Got value: {v}")
        Option.Nothing: print("No value")
    
    # Test unwrap
    print(f"Unwrapped: {x.unwrap()}")
    
    # Test Option<str>
    let y: Option<str> = Option.Nothing
    
    match y:
        Option.Some(s): print(f"Got string: {s}")
        Option.Nothing: print("No string")
        
    if y.is_nothing():
        print("y is nothing")
        
    return 0

# EXPECTED_OUTPUT:
# Got value: 42
# Unwrapped: 42
# No string
# y is nothing
