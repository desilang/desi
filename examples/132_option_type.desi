# Test Option<T> type

# Option<T> = Some(value) | Nothing

def main() -> int:
    # Test with Option<int>
    let x: Option<int> = Option.Some(42)
    
    match x:
        Option.Some(v): print(f"Got value: {v}")
        Option.Nothing: print("Got nothing")
    
    if x.is_some():
        print(f"Unwrapped: {x.unwrap()}")
    
    let y: Option<str> = Option.Nothing
    
    match y:
        Option.Some(s): print(f"String: {s}")
        Option.Nothing: print("No string")
        
    if y.is_nothing():
        print("y is nothing")
    
    return 0
