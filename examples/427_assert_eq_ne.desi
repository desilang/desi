# Test assert_eq and assert_ne builtins
@test
def test_assert_eq_int() -> none:
	assert_eq(42, 42)
	assert_eq(1 + 1, 2)
	assert_eq(10 - 3, 7, "subtraction check")

@test
def test_assert_eq_str() -> none:
	assert_eq("hello", "hello")
	assert_eq("desi", "desi", "language name")

@test
def test_assert_eq_bool() -> none:
	assert_eq(true, true)
	assert_eq(false, false)

@test
def test_assert_ne_int() -> none:
	assert_ne(1, 2)
	assert_ne(42, 0, "values must differ")

@test
def test_assert_ne_str() -> none:
	assert_ne("hello", "world")
	assert_ne("a", "b")

@test
def test_assert_ne_bool() -> none:
	assert_ne(true, false)

def main() -> int:
	test_assert_eq_int()
	test_assert_eq_str()
	test_assert_eq_bool()
	test_assert_ne_int()
	test_assert_ne_str()
	test_assert_ne_bool()
	print("all assertions passed!")
	0

# EXPECTED_OUTPUT:
# all assertions passed!
