# Nested class access test - comprehensive data types

class Outer:
    # Nested class with multiple field types
    class Inner:
        pub mut int_val: int
        pub mut float_val: float
        pub mut str_val: str
        pub mut bool_val: bool
    
    pub def __new__(self):
        pass
    
    pub def test_primitives(self) -> int:
        let mut i = Outer.Inner()
        
        # Test int
        i.int_val := 42
        
        # Test float
        i.float_val := 3.14
        
        # Test str
        i.str_val := "hello"
        
        # Test bool
        i.bool_val := true
        
        return i.int_val

# Custom struct type for nested class field
struct Point:
    x: int
    y: int

class Container:
    # Nested class with custom struct field
    class Node:
        pub mut data: int
        pub mut next_val: int  # Simplified - would be Option[Node] in real code
    
    pub def __new__(self):
        pass
    
    pub def test_custom_type(self) -> int:
        let mut node = Container.Node()
        node.data := 100
        node.next_val := 0
        return node.data

def main() -> int:
    # Test 1: Primitives
    let outer = Outer()
    let result1 = outer.test_primitives()
    print(result1)
    
    # Test 2: Custom types
    let container = Container()
    let result2 = container.test_custom_type()
    print(result2)
    
    return 0

# EXPECTED_OUTPUT:
# 42
# 100
