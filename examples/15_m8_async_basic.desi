# M8 — async/await basic sample
# Goal: show a simple async function awaited from sync `main`.
# Tier-0 backend maps `await` in sync context to a blocking runtime stub.

async def add1(x: int) -> int:
    # In M8, this lowers to wrapper+poll state machine and completes the future.
    return x + 1

def main() -> int:
    # Calling an async function returns a future handle (wrapper path).
    fut = add1(41)

    # In a synchronous function, `await` becomes a blocking runtime call.
    n = await fut

    print("ok")   # textual IR uses puts("ok\n")
    0
