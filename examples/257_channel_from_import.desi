# Test Channel with `from sync import` style
from sync import Channel

def main() -> int:
    print("Testing Channel with from-import...")
    
    # Create channel using direct import
    let ch = Channel(5)
    print("Created channel")
    
    # Get sender and receiver
    let tx = ch.sender()
    let rx = ch.receiver()
    print("Got sender and receiver")
    
    # Send value
    tx.send(123)
    print("Sent 123")
    
    # Close
    ch.close()
    print("Closed channel")
    
    print("from-import test passed!")
    return 0

# EXPECTED_OUTPUT:
# Testing Channel with from-import...
# Created channel
# Got sender and receiver
# Sent 123
# Closed channel
# from-import test passed!
