# Test custom class in collections

class Person:
    pub name: str
    
    pub def __new__(self, name: str):
        self.name = name
    
    pub def __str__(self) -> str:
        return "Person(" + self.name + ")"

def main():
    # Test with custom class - use [initial_value] pattern for type inference
    let p1 = Person("Alice")
    let p2 = Person("Bob")
    
    # Initialize with first element so type is inferred
    let mut people = [p1]
    people.append(p2)
    
    print("People list:")
    print(people)  # Should print: [Person(Alice), Person(Bob)]
    
    print("Manual iteration test passed!")
