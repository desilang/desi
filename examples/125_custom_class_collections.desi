# Test custom class in collections

class Person:
    pub name: str
    
    pub def __new__(self, name: str):
        self.name = name
    
    pub def __str__(self) -> str:
        return "Person(" + self.name + ")"

def main():
    # Test with custom class
    # Explicitly type the list as list[Person] so the compiler knows the element type
    # and can generate the correct to_str function pointer (Person___str__)
    let mut people: list[Person] = []
    
    people.append(Person("Alice"))
    people.append(Person("Bob"))
    people.append(Person(1)) 
    
    print("People list:")
    print(people)  # Should print: [Person(Alice), Person(Bob)]
    
    # Test iteration
    print("Manual iteration test passed!")
