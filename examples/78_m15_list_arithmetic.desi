def main() -> int:
    # Test list with proper unboxing
    let nums: list<int> = [10, 20, 30]
    let first: int = nums[0]
    let second: int = nums[1]
    
    print(f"first: {first}, second: {second}")
    
    let sum: int = first + second
    print(f"Sum: {sum}")
    
    # Verify correctness (should be 30)
    if sum != 30:
        print("ERROR: sum should be 30")
        return 1
        
    print("List arithmetic test passed!")
    return 0

# EXPECTED_OUTPUT:
# first: 10, second: 20
# Sum: 30
# List arithmetic test passed!
