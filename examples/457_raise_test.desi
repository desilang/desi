def main() -> int:
	# Test 1: basic raise string + except
	try:
		raise "oops"
	except e:
		print("caught: " + e)

	# Test 2: typed exception
	try:
		raise ValueError("bad input")
	except ValueError as e:
		print("caught ValueError: " + e)

	# Test 3: unmatched type falls through to base
	try:
		raise KeyError("missing key")
	except e:
		print("caught base: " + e)

	# Test 4: finally always runs
	try:
		print("in try body")
	finally:
		print("finally ran")

	print("all tests passed")
	return 0

# EXPECTED_OUTPUT:
# caught: oops
# caught ValueError: bad input
# caught base: missing key
# in try body
# finally ran
# all tests passed
