# EXPECTED: COMPILE_ERROR
# Test immutable field assignment error

class Point:
    pub x: int
    pub mut y: int
    
    pub def __new__(self, x: int, y: int):
        self.x = x
        self.y = y
        
    pub def set_x(self, val: int):
        self.x = val  # Error: x is immutable
        
    pub def set_y(self, val: int):
        self.y = val  # OK: y is mutable

def main():
    let p = Point(10, 20)
    p.set_y(30)
    print("y updated")
    p.set_x(40) # Should fail compilation

