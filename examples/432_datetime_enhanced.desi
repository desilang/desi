# Test enhanced datetime module
import datetime

def main() -> int:
	# Duration parsing — returns float (seconds)
	let d1 = datetime.parse_duration("2h 30m")
	print(str(d1))

	let d2 = datetime.parse_duration("1d 12h")
	print(str(d2))

	# Duration formatting
	let fmt = datetime.format_duration(90061.0)
	print(fmt)

	# Business days (Jan 1-31 2024, Mon-Fri)
	let bdays = datetime.business_days("2024-01-01", "2024-01-31")
	print(str(bdays))

	# Period boundaries
	let sow = datetime.start_of_week("2024-06-13")
	print(sow)

	let eow = datetime.end_of_week("2024-06-13")
	print(eow)

	let som = datetime.start_of_month("2024-06-15")
	print(som)

	let eom = datetime.end_of_month("2024-06-15")
	print(eom)

	# Quarter
	let q1 = datetime.quarter("2024-02-15")
	print(str(q1))
	let q4 = datetime.quarter("2024-11-15")
	print(str(q4))

	# Leap year
	let leap = datetime.is_leap_year(2024)
	print(str(leap))
	let noleap = datetime.is_leap_year(2023)
	print(str(noleap))

	# Day of year
	let doy = datetime.day_of_year("2024-03-01")
	print(str(doy))

	print("datetime enhanced ok")
	0

# EXPECTED_OUTPUT:
# 9000.0
# 129600.0
# 1d 1h 1m 1s
# 22
# 2024-06-10
# 2024-06-16
# 2024-06-01
# 2024-06-30
# 1
# 4
# true
# false
# 61
# datetime enhanced ok
