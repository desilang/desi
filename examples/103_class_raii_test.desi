# Nested `using` blocks close in reverse order.
#
# Both closers were empty and the file printed nothing, so "r2 closed here /
# r1 closed here" was a comment rather than a test. The order is the part
# worth pinning down.

class Resource:
	pub mut label: str

	pub def __close__(self) -> none:
		print("close " + self.label)
		return

def main() -> int:
	using r1 = Resource():
		r1.label := "outer"
		using r2 = Resource():
			r2.label := "inner"
			print("body")
	print("after")
	return 0

# EXPECTED_OUTPUT:
# body
# close inner
# close outer
# after
