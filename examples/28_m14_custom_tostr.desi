# M14: Custom to_str via impl Display
#
# The result was assigned and dropped, so an impl that never took the place of
# the generated default would have looked the same.

trait Display:
	"""Display trait for custom string representation."""
	def to_str() -> str

struct Point:
	x: int
	y: int

impl Display for Point:
	def to_str() -> str:
		return "Point(x=?, y=?)"

def main():
	let p: Point = Point(x=10, y=20)
	print(p.to_str())

# EXPECTED_OUTPUT:
# Point(x=?, y=?)
