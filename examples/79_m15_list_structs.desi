# Test: Lists of structs with indexing
struct Point:
    x: int
    y: int

def main() -> int:
    # Create struct instances first
    let p1 = Point(x=10, y=20)
    let p2 = Point(x=30, y=40)
    let p3 = Point(x=50, y=60)
    
    # Create a list of struct instances
    let points: list<Point> = [p1, p2, p3]
    
    # Access struct field via indexing
    let first: Point = points[0]
    let x_val: int = first.x
    
    print(f"First point x: {x_val}")
    
    # Verify correctness (should be 10)
    if x_val != 10:
        print("ERROR: x_val should be 10")
        return 1
        
    print("List structs test passed!")
    return 0
