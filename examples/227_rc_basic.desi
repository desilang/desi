# Comprehensive Rc<T> reference counting test

class Point:
    pub mut x: int
    pub mut y: int
    
    pub def __new__(self, x: int, y: int):
        self.x := x
        self.y := y

def test_multiple_refs() -> int:
    # Create an rc and clone it multiple times
    # All clones should share the same value
    let original = rc(42)
    let clone1 = original.clone()  # refcount = 2
    let clone2 = clone1.clone()    # refcount = 3
    
    # All should return the same value
    let v1 = original.get()
    let v2 = clone1.get()
    let v3 = clone2.get()
    
    if v1 != 42:
        return 1
    if v2 != 42:
        return 2
    if v3 != 42:
        return 3
    return 0
    # At scope exit: all 3 decremented, value freed

def main() -> int:
    # Test 1: Rc[int]
    print("=== Rc[int] ===")
    let shared_int = rc(42)
    let val = shared_int.get()
    print(val)  # Should print 42
    
    # Test 2: Rc[str]
    print("=== Rc[str] ===")
    let shared_str = rc("hello")
    print(shared_str.get())  # Should print hello
    
    # Test 3: Rc[float]
    print("=== Rc[float] ===")
    let shared_float = rc(3.14)
    print(shared_float.get())  # Should print 3.140000
    
    # Test 4: Rc[bool]
    print("=== Rc[bool] ===")
    let shared_bool = rc(true)
    print(shared_bool.get())  # Should print true
    
    # Test 5: Clone functionality
    print("=== Clone test ===")
    let original = rc(100)
    let cloned = original.clone()
    print(original.get())  # 100
    print(cloned.get())    # 100 (same value)
    
    # Test 6: Multiple references
    print("=== Multiple refs ===")
    let result = test_multiple_refs()
    if result == 0:
        print("OK")
    else:
        print("FAILED")
        return result
    
    print("All Rc tests passed!")
    return 0

# EXPECTED_OUTPUT:
# === Rc[int] ===
# 42
# === Rc[str] ===
# hello
# === Rc[float] ===
# 3.140000
# === Rc[bool] ===
# true
# === Clone test ===
# 100
# 100
# === Multiple refs ===
# OK
# All Rc tests passed!
