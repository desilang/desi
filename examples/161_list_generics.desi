# Test non-generic class to verify checking/lowering fixes

class IntBox:
    pub mut val: int

    pub def get(self) -> int:
        return self.val

    pub def set(self, v: int):
        self.val = v

def main() -> int:
    # 1. Simple class instance
    let b1 = IntBox()
    b1.val = 10
    
    # Test method access
    let v: int = b1.get()
    print(v)

    b1.set(20)
    let v2: int = b1.get()
    print(v2)

    0
