# Comprehensive tuple edge case tests

def main() -> int:
    # ======= BASIC OPERATIONS =======
    print("=== Basic Operations ===")
    
    # Multi-element tuples
    let t = (1, 2, 3, 4, 5)
    print(f"Basic tuple: len = {len(t)}")
    
    # Mixed types
    let mixed = (42, "hello", true)
    print("Mixed types tuple: PASS")
    
    # Nested tuples
    let nested = ((1, 2), (3, 4))
    print(f"Nested tuple: len = {len(nested)}")
    
    # ======= INDEXING =======
    print("\n=== Indexing ===")
    print(f"t.0 = {t.0}")
    print(f"t.4 = {t.4}")
    
    # ======= DESTRUCTURING =======
    print("\n=== Destructuring ===")
    let (a, b, c, d, e) = t
    print(f"Destructure all: a={a}, e={e}")
    
    let (_, second, _, _, _) = t
    print(f"Ignore pattern: second={second}")
    
    let (first, *rest) = t
    print(f"Head/tail: first={first}, rest len={len(rest)}")
    
    let (*init, last) = t
    print(f"Init/last: last={last}, init len={len(init)}")
    
    let (x, *middle, z) = t
    print(f"Head/middle/tail: x={x}, z={z}, middle len={len(middle)}")
    
    # ======= CONCATENATION & SPREAD =======
    print("\n=== Concatenation & Spread ===")
    let left = (1, 2)
    let right = (3, 4)
    let concat = left + right
    print(f"(1,2) + (3,4): len = {len(concat)}")
    
    let spread = (*left, 99, *right)
    print(f"(*left, 99, *right): len = {len(spread)}")
    
    # ======= COMPARISON =======
    print("\n=== Comparison ===")
    let less = (1, 2) < (1, 3)
    if less:
        print("(1,2) < (1,3): PASS")
    else:
        print("FAIL: comparison")
    
    let eq = (1, 2) == (1, 2)
    if eq:
        print("(1,2) == (1,2): PASS")
    else:
        print("FAIL: equality")
    
    # ======= MEMBERSHIP =======
    print("\n=== Membership ===")
    let nums = (10, 20, 30)
    if 20 in nums:
        print("20 in (10,20,30): PASS")
    else:
        print("FAIL: membership")
    
    if 99 in nums:
        print("FAIL: 99 should not be in tuple")
    else:
        print("99 not in (10,20,30): PASS")
    
    # ======= ITERATION =======
    print("\n=== Iteration ===")
    let mut sum_val = 0
    for n in nums:
        sum_val := sum_val + n
    print(f"Sum via iteration: {sum_val}")
    
    # ======= TWO-ELEMENT EDGE CASE =======
    print("\n=== Two-element Tuple ===")
    let pair = (100, 200)
    let (p1, p2) = pair
    print(f"Pair: p1={p1}, p2={p2}")
    
    let (pf, *pr) = pair
    print(f"Pair rest: first={pf}, rest len={len(pr)}")
    
    print("\n=== All edge case tests passed! ===")
    return 0
