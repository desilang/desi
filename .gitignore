# Go
bin/
dist/
*.exe
*.dll
*.test
*.out

# MSVC build outputs (Windows)
*.obj
*.pdb
*.ilk

# Editors
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Generated C output (later)
# keep emitted C out of the repo unless explicitly vendored
/gen/
/desic

# Build output, at any depth. Not anchored to the root: `desic build` writes
# to build/output/ relative to wherever it is run, so a build inside
# examples/ or a scratch project left artifacts the root-anchored rule
# missed. On Unix those artifacts have no extension, so *.exe did not catch
# them either.
build/

# Compiled objects and static libraries, wherever they land.
*.o
*.a
*.lib
*.so
*.dylib

# mpdecimal build artifacts (Windows, macOS, Unix)
compiler/runtime/decimal/mpdecimal-4.0.1/libmpdec/*.obj
compiler/runtime/decimal/mpdecimal-4.0.1/libmpdec/*.o
compiler/runtime/decimal/mpdecimal-4.0.1/libmpdec/*.lib
compiler/runtime/decimal/mpdecimal-4.0.1/libmpdec/*.a
compiler/runtime/decimal/mpdecimal-4.0.1/libmpdec/*.dylib
