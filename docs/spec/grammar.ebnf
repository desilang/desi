(* Desi Stage-1 Grammar (EBNF) *)

File            = [PackageDecl] {ImportDecl | FromImportDecl} {Decl} ;

PackageDecl     = "package" Ident ;

ImportDecl      = "import" DottedIdent ["as" Ident] ;
FromImportDecl  = "from" DottedIdent "import" ImportList ;
ImportList      = ImportItem {"," ImportItem} ;
ImportItem      = Ident ["as" Ident] ;

Decl            = FuncDecl | TypeDecl | StructDecl | EnumDecl | ConstDecl ;

(* ----- Declarations ----- *)

FuncDecl        = [ "pub" ] [ "async" ] "def" Ident "(" [Params] ")" [ "->" Type ] ":" NL* Block ;
Params          = Param {"," Param} [","] ;
Param           = Ident [ ":" Type ] ;

TypeDecl        = [ "pub" ] "type" Ident "=" Type ;

StructDecl      = [ "pub" ] "struct" Ident ":" NL Indent { FieldDecl } Dedent ;
FieldDecl       = Ident ":" Type NL ;

EnumDecl        = [ "pub" ] "enum" Ident ":" NL Indent { EnumVariantDecl } Dedent ;
EnumVariantDecl = Ident ":" TypeOrNone NL ;
TypeOrNone      = "none" | Type ;

ConstDecl       = [ "pub" ] "let" Ident [ ":" Type ] "=" Expr NL ;
                  (* Note: `pub let mut` is forbidden by the checker. *)

(* ----- Statements ----- *)

Stmt            = LetStmt
                | AssignStmt
                | ReturnStmt
                | IfStmt
                | WhileStmt
                | DeferStmt
                | MatchStmt
                | ExprStmt
                ;

LetStmt         = "let" [ "mut" ]
                  ( BindList | "(" BindList ")" )
                  [ ":" Type ] "=" ExprList NL ;
BindList        = Bind {"," Bind} ;
Bind            = Ident [ ":" Type ] ;
ExprList        = Expr {"," Expr} ;

AssignStmt      = LHSList ":=" ExprList NL ;
LHSList         = LHS {"," LHS} ;
LHS             = Ident | FieldExpr ;
FieldExpr       = Ident "." Ident { "." Ident } ;

ReturnStmt      = "return" [ Expr ] NL ;

IfStmt          = "if" Expr ":" NL Block { ElifClause } [ ElseClause ] ;
ElifClause      = "elif" Expr ":" NL Block ;
ElseClause      = "else" ":" NL Block ;

WhileStmt       = "while" Expr ":" NL Block ;

DeferStmt       = "defer" CallExpr NL ;

MatchStmt       = "match" Expr ":" NL Indent { MatchArm } Dedent ;
MatchArm        = Pattern ":" NL Block ;
Pattern         = "_"                           (* wildcard *)
                | Ident "(" [ Binder ] ")" ;    (* Variant[(binder)] *)
Binder          = Ident | "_" ;

ExprStmt        = Expr NL ;

Block           = Indent { Stmt } Dedent ;

(* ----- Expressions ----- *)

Expr            = Disjunction ;
Disjunction     = Conjunction { "or" Conjunction } ;
Conjunction     = Pipeline    { "and" Pipeline } ;
Pipeline        = Equality    { "|>" Equality } ;

Equality        = Relational  { ( "==" | "!=" ) Relational } ;
Relational      = Additive    { ( "<" | "<=" | ">" | ">=" ) Additive } ;
Additive        = Multiplicative { ( "+" | "-" ) Multiplicative } ;
Multiplicative  = Unary       { ( "*" | "/" | "%" ) Unary } ;

Unary           = ( "-" | "!" | "not" ) Unary
                | "await" Unary
                | Postfix ;

Postfix         = Primary { CallSuffix | IndexSuffix | FieldSuffix } ;
CallSuffix      = "(" [ ExprList ] ")" ;
IndexSuffix     = "[" Expr "]" ;
FieldSuffix     = "." Ident ;

Primary         = Literal
                | Ident
                | StructLit
                | "(" Expr ")"
                ;

StructLit       = Ident "{" [ StructInitList ] "}" ;
StructInitList  = StructInit { "," StructInit } [ "," ] ;
StructInit      = Ident ":" Expr ;

Literal         = IntLit | StrLit | BoolLit ;

(* ----- Lexical / helpers ----- *)

Type            = Ident | DottedIdent | BuiltinType ;

(* NOTE: `void` is intentionally NOT a builtin type. Use `none`. *)
BuiltinType     = "bool"
                | "int" | "i8" | "i16" | "i32" | "i64" | "i128" | "isize"
                | "u8" | "u16" | "u32" | "u64" | "u128" | "usize"
                | "f32" | "f64"
                | "str" | "string"
                | "none" | "future" ;

CallExpr        = Primary { FieldSuffix | IndexSuffix } CallSuffix { CallSuffix | IndexSuffix | FieldSuffix } ;
DottedIdent     = Ident { "." Ident } ;
Ident           = /* letter (letter | digit | "_")*; keywords excluded */ ;
IntLit          = /* decimal digits */ ;
StrLit          = /* double-quoted string with escapes */ ;
BoolLit         = "true" | "false" ;

NL              = /* line break(s) */ ;
Indent          = /* indentation increase */ ;
Dedent          = /* indentation decrease */ ;

(* Comments and whitespace *)
(* Line comments start with '#' to end-of-line. Whitespace is insignificant except for indentation. *)
